run 400000000
asc 3 uname -a; cat /proc/version; ls / | wc -l; cat /proc/interrupts
run 200000000
asc 3 cat /proc/meminfo | head -n 3; free; df; mount
run 200000000
asc 3 echo hello > /tmp/x; cat /tmp/x; mkdir /tmp/d; ln /tmp/x /tmp/d/y; ls -li /tmp/d
run 200000000
asc 3 cat /bin/busybox | md5sum; yes | head -n 1000 | wc -l; echo abc | sed 's/b/X/'
run 400000000
asc 3 sleep 100 &
run 100000000
asc 3 ps
run 200000000
asc 3 killall sleep; sigtest raise; sigtest ill
run 200000000
asc 3 sigtest loop
run 100000000
asc 3 
run 100000000
