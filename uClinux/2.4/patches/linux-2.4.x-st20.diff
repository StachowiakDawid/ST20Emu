diff --git a/linux-2.4.x/arch/st20/mm/cache.c b/linux-2.4.x/arch/st20/mm/cache.c
new file mode 100644
index 000000000..b485ed886
--- /dev/null
+++ b/linux-2.4.x/arch/st20/mm/cache.c
@@ -0,0 +1,35 @@
+/*
+ * arch/st20/mm/cache.c - STi5512 instruction cache
+ *
+ * Cache controller at 0x4000 (OS20 cache/sti5512a.c): EnableICache +0x700,
+ * InvalidateICache +0x800, CacheStatus +0x900; byte registers, as STBOOT writes them
+ * (Decompilation/DSR9500 src/a_7feb1948.c).  The data cache caches only the regions set in
+ * its region registers; those stay clear, so device registers, the OSD frame store and
+ * DMA buffers need no flushing.  The STi5512 wants invalidate, wait >= 128 cycles, enable.
+ */
+#include <linux/kernel.h>
+
+#define CACHE(o)		(*(volatile unsigned char *) (0x4000UL + (o)))
+#define CAC_ENABLE_ICACHE	0x700
+#define CAC_INVALIDATE_ICACHE	0x800
+
+static void cache_wait(void)
+{
+	volatile int i;
+
+	for (i = 0; i < 64; i++)	/* > 128 cycles */
+		;
+}
+
+void st20_icache_invalidate(void)
+{
+	CACHE(CAC_INVALIDATE_ICACHE) = 1;
+	cache_wait();
+}
+
+void st20_icache_enable(void)
+{
+	st20_icache_invalidate();
+	CACHE(CAC_ENABLE_ICACHE) = 1;
+	printk("ST20 instruction cache enabled\n");
+}
diff --git a/linux-2.4.x/arch/st20/mm/init.c b/linux-2.4.x/arch/st20/mm/init.c
new file mode 100644
index 000000000..5c773cd98
--- /dev/null
+++ b/linux-2.4.x/arch/st20/mm/init.c
@@ -0,0 +1,118 @@
+/*
+ * arch/st20/mm/init.c - memory initialisation for uClinux/ST20 (after h8300's)
+ */
+#include <linux/config.h>
+#include <linux/signal.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/swap.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <linux/init.h>
+#include <linux/bootmem.h>
+#include <asm/segment.h>
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm/system.h>
+
+extern char _stext, _etext, _edata, _end;
+extern unsigned long memory_start, memory_end;
+
+static unsigned long totalram_pages;
+unsigned long empty_zero_page;
+
+void show_mem(void)
+{
+	unsigned long i;
+	int free = 0, total = 0, reserved = 0, shared = 0, cached = 0;
+
+	printk("\nMem-info:\n");
+	show_free_areas();
+	i = max_mapnr;
+	while (i-- > 0) {
+		total++;
+		if (PageReserved(mem_map+i))
+			reserved++;
+		else if (PageSwapCache(mem_map+i))
+			cached++;
+		else if (!page_count(mem_map+i))
+			free++;
+		else
+			shared += page_count(mem_map+i) - 1;
+	}
+	printk("%d pages of RAM\n%d free pages\n%d reserved pages\n%d pages shared\n"
+	       "%d pages swap cached\n", total, free, reserved, shared, cached);
+	show_buffers();
+}
+
+void __init paging_init(void)
+{
+	unsigned long end_mem = memory_end & PAGE_MASK;
+	unsigned long zones_size[MAX_NR_ZONES];
+	int i;
+
+	empty_zero_page = (unsigned long) alloc_bootmem_pages(PAGE_SIZE);
+	memset((void *) empty_zero_page, 0, PAGE_SIZE);
+	set_fs(USER_DS);
+
+	for (i = 0; i < MAX_NR_ZONES; i++)
+		zones_size[i] = 0;
+	zones_size[ZONE_NORMAL] = (end_mem - PAGE_OFFSET) >> PAGE_SHIFT;
+	free_area_init_node(0, NULL, NULL, zones_size, PAGE_OFFSET, NULL);
+}
+
+void __init mem_init(void)
+{
+	unsigned long tmp, end_mem = memory_end & PAGE_MASK;
+	int codek, datak;
+
+	high_memory = (void *) end_mem;
+	max_mapnr = num_physpages = MAP_NR(high_memory);
+	totalram_pages = free_all_bootmem();
+
+	codek = (&_etext - &_stext) >> 10;
+	datak = (&_end - &_etext) >> 10;
+	tmp = nr_free_pages() << PAGE_SHIFT;
+	printk("Memory available: %luk/%luk RAM (%dk kernel code, %dk data)\n",
+	       tmp >> 10, (end_mem - PAGE_OFFSET) >> 10, codek, datak);
+}
+
+/* the init segment (head.ast, arch/st20/tools/st20-cc): __init code and __initdata */
+extern char __init_begin, __init_end;
+
+void free_initmem(void)
+{
+	unsigned long addr = PAGE_ALIGN((unsigned long) &__init_begin);
+	unsigned long end = (unsigned long) &__init_end & PAGE_MASK;
+	int pages = 0;
+
+	for (; addr < end; addr += PAGE_SIZE, pages++) {
+		unsigned short *p = (unsigned short *) addr;
+		int i;
+
+		/* poison: `opr 0xb1` (2b f1, an illegal instruction) everywhere, so a call
+		   into freed init code traps instead of running stale code */
+		for (i = 0; i < PAGE_SIZE / 2; i++)
+			p[i] = 0xf12b;
+		ClearPageReserved(virt_to_page(addr));
+		set_page_count(virt_to_page(addr), 1);
+		free_page(addr);
+		totalram_pages++;
+	}
+	printk("Freeing unused kernel memory: %dk freed (init %luk at %08lx)\n",
+	       pages * (int) (PAGE_SIZE >> 10),
+	       ((unsigned long) &__init_end - (unsigned long) &__init_begin) >> 10,
+	       (unsigned long) &__init_begin);
+}
+
+void si_meminfo(struct sysinfo *val)
+{
+	val->totalram = totalram_pages;
+	val->sharedram = 0;
+	val->freeram = nr_free_pages();
+	val->bufferram = atomic_read(&buffermem_pages);
+	val->totalhigh = 0;
+	val->freehigh = 0;
+	val->mem_unit = PAGE_SIZE;
+}
