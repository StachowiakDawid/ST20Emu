diff --git a/linux-2.4.x/include/asm-st20/processor.h b/linux-2.4.x/include/asm-st20/processor.h
new file mode 100644
index 000000000..8cdf6e68c
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/processor.h
@@ -0,0 +1,75 @@
+#ifndef __ASM_ST20_PROCESSOR_H
+#define __ASM_ST20_PROCESSOR_H
+
+#define current_text_addr() ({ __label__ _l; _l: &&_l;})
+
+#include <linux/config.h>
+#include <asm/segment.h>
+#include <asm/ptrace.h>
+#include <asm/current.h>
+#include <asm/signal.h>
+
+#define TASK_SIZE	(0xFFFFFFFFUL)
+
+#define EISA_bus 0
+#define MCA_bus 0
+
+/*
+ * ksp is the task's saved Wptr while it is switched out; word 0 of that workspace holds
+ * the Iptr to continue at (the return address of the st20_resume call, entry.ast).
+ */
+struct thread_struct {
+	unsigned long	ksp;		/* saved kernel Wptr */
+	unsigned long	usp;		/* user Wptr at the last kernel entry */
+	struct pt_regs	*regs;		/* user state of the current kernel entry */
+	unsigned long	vfork_stack;	/* kmalloc'd copy of the parent's user stack
+					   (vfork child until exec/exit), or 0 */
+	unsigned long	vfork_stack_end; /* end of that copy */
+	unsigned long	resume[5];	/* user state to continue at exactly: Wptr, Iptr,
+					   Areg, Breg, Creg (sigreturn, exec) ... */
+	int		resume_valid;	/* ... when set */
+	sigset_t	saved_mask;	/* sigsuspend: mask to restore after the handler */
+	int		saved_mask_valid;
+};
+
+#define INIT_THREAD  { 0, 0, 0, 0, 0, { 0, }, 0, { { 0, } }, 0 }
+
+/* binfmt_flat: start the program at pc with Wptr usp on return to user mode */
+extern void st20_start_thread(struct pt_regs * regs, unsigned long pc, unsigned long usp);
+#define start_thread(_regs, _pc, _usp)	st20_start_thread((_regs), (_pc), (_usp))
+
+struct task_struct;
+struct mm_struct;
+
+extern void release_thread(struct task_struct *dead_task);
+extern int arch_kernel_thread(int (*fn)(void *), void * arg, unsigned long flags);
+
+#define copy_segments(tsk, mm)		do { } while (0)
+#define release_segments(mm)		do { } while (0)
+#define forget_segments()		do { } while (0)
+
+extern void exit_thread(void);
+
+extern inline unsigned long thread_saved_pc(struct thread_struct *t)
+{
+	return t->ksp ? ((unsigned long *) t->ksp)[0] : 0;
+}
+
+unsigned long get_wchan(struct task_struct *p);
+
+#define KSTK_EIP(tsk)	((tsk)->thread.regs ? (tsk)->thread.regs->iptr : 0)
+#define KSTK_ESP(tsk)	((tsk)->thread.usp)
+
+#define THREAD_SIZE (2*PAGE_SIZE)
+
+#define alloc_task_struct() \
+	((struct task_struct *) __get_free_pages(GFP_KERNEL,1))
+#define free_task_struct(p)	free_pages((unsigned long)(p),1)
+#define get_task_struct(tsk)	atomic_inc(&virt_to_page(tsk)->count)
+
+#define init_task	(init_task_union.task)
+#define init_stack	(init_task_union.stack)
+
+#define cpu_relax()	barrier()
+
+#endif
