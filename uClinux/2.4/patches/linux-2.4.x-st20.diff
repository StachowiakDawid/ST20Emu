diff --git a/linux-2.4.x/drivers/video/st20fb.c b/linux-2.4.x/drivers/video/st20fb.c
new file mode 100644
index 000000000..7a6cbd9b7
--- /dev/null
+++ b/linux-2.4.x/drivers/video/st20fb.c
@@ -0,0 +1,392 @@
+/*
+ * drivers/video/st20fb.c - /dev/fb0 on the STi5512 OSD (uClinux/ST20, Samsung DSR9500)
+ *
+ * A linear 640x480 palettised frame buffer, 8 (default), 4 or 2 bits per pixel
+ * (FBIOPUT_VSCREENINFO bits_per_pixel), packed pixels, leftmost pixel in the high bits,
+ * on the same 640x480 window of the PAL picture as the TV text console (osd.c).
+ *
+ * The OSD (STi5512 datasheet 21.5) shows two lists of blocks, one per field, each block an
+ * 8-byte header, an optional palette and a contiguous bitmap, with no line pitch.  To give
+ * an ordinary linear frame buffer, every frame buffer line is its own one-line block: line
+ * y occupies `line_length' bytes (2 bpp: 256, 4 bpp: 384, 8 bpp: 768, a multiple of 128 for
+ * the 16-word aligned links), of which the first 8 are its header and the next 640 * bpp / 8
+ * its pixels.  fix.smem_start points at line 0's pixels, so pixel (x, y) is at
+ * smem_start + y * line_length + x * bpp / 8 as usual; the header of line y + 1 sits in the
+ * last 8 bytes of line y's padding.  The top field's list links lines 0, 2, 4, ..., the
+ * bottom field's 1, 3, 5, ...; each starts with a hidden (S = 1) two-pixel block on the field
+ * line above the picture that carries the palette (14-bit colour: 6-bit Y, 4-bit Cb/Cr),
+ * which the line blocks reuse (P = 1).  A program that clears the whole of smem_len also
+ * clears headers: a timer rewrites them every 100 ms while the frame buffer is shown.
+ * 241 blocks per field; st20emu draws at most 256.
+ *
+ * The TV text console (osd.c) keeps its own two 2 bpp field blocks.  The OSD shows the
+ * frame buffer from the first open of /dev/fb0 until the last close, then the text console
+ * again (which was updated meanwhile).  No fbcon (no virtual terminals).
+ *
+ * The OSD links address the low 4 MB of SDRAM (OSD_CFG.LLG = 0), so the 370 KB buffer comes
+ * from the boot allocator early in setup_arch (st20fb_alloc).
+ */
+#include <linux/config.h>
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/string.h>
+#include <linux/mm.h>
+#include <linux/tty.h>
+#include <linux/init.h>
+#include <linux/bootmem.h>
+#include <linux/timer.h>
+#include <linux/sched.h>
+#include <linux/fb.h>
+#include <asm/system.h>
+#include <asm/uaccess.h>
+#include <video/fbcon.h>
+
+#define XRES		640
+#define YRES		480
+#define FIELD_TOP	48		/* field line of frame lines 0/1 (osd.c TOP_LINE) */
+#define LEFT		158		/* osd.c LEFT */
+#define SDRAM		0xc0000000UL
+#define OSD_LIMIT	0xc0400000UL	/* links reach the low 4 MB (OSD_CFG.LLG = 0) */
+#define PAL_SLOT	768		/* palette block: 8 + 256 * 2 + 8; OSD_TOP/BOT count 256 bytes */
+#define TERM_OFF	(2 * PAL_SLOT)	/* terminating header */
+#define LINES_OFF	(TERM_OFF + 128)
+#define MAX_STRIDE	768
+#define FB_MEM		(LINES_OFF + YRES * MAX_STRIDE)
+
+extern void st20_osd_select(unsigned char *top, unsigned char *bottom);
+
+static unsigned char *fb_mem;		/* FB_MEM bytes, 4 KB aligned */
+static int bpp = 8, stride = MAX_STRIDE;
+static int users;
+static struct timer_list repair_timer;
+
+static struct fb_info info;
+static struct display disp;
+static u16 cmap_red[256], cmap_green[256], cmap_blue[256];
+static struct fb_cmap cur_cmap = { 0, 256, cmap_red, cmap_green, cmap_blue, 0 };
+static u16 hw_pal[256];			/* 14-bit palette entries */
+
+void __init st20fb_alloc(void)
+{
+	fb_mem = alloc_bootmem_pages(FB_MEM);
+	if ((unsigned long) fb_mem + FB_MEM > OSD_LIMIT) {
+		printk("st20fb: buffer at %p is beyond the OSD's 4 MB\n", fb_mem);
+		fb_mem = 0;
+	}
+}
+
+static unsigned char *line_hdr(int y)
+{
+	return fb_mem + LINES_OFF + y * stride;
+}
+
+static unsigned char *pixels(void)
+{
+	return line_hdr(0) + 8;
+}
+
+static void put_be32(unsigned char *p, unsigned long v)
+{
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+/* one block header (datasheet table 97): mode for bpp, palette follows unless same_pal,
+   hidden (S) from the CVBS output, field line `line', pixels left..right, link to `next' */
+static void put_header(unsigned char *h, int same_pal, int hidden, int line, int left,
+		       int right, unsigned char *next)
+{
+	unsigned long n = ((unsigned long) next - SDRAM) / 8;
+	unsigned long hi = (unsigned long) line << 16 | ((n >> 4) & 7) << 9 | line;
+	unsigned long lo = ((n >> 7) & 0x3f) << 26 | (unsigned long) left << 16 |
+			   ((n >> 13) & 0x3f) << 10 | right;
+
+	if (bpp == 4)
+		hi |= 1UL << 31;		/* M */
+	else if (bpp == 8)
+		hi |= 1UL << 29;		/* E */
+	if (same_pal)
+		hi |= 1UL << 27;		/* P */
+	if (hidden)
+		hi |= 1UL << 25;		/* S */
+	put_be32(h, hi);
+	put_be32(h + 4, lo);
+}
+
+static void build_headers(void)
+{
+	int y;
+
+	for (y = 0; y < YRES; y++) {
+		unsigned char *next = y + 2 < YRES ? line_hdr(y + 2) : fb_mem + TERM_OFF;
+
+		put_header(line_hdr(y), 1, 0, FIELD_TOP + y / 2, LEFT, LEFT + XRES - 1, next);
+	}
+}
+
+static void write_palette(void)
+{
+	int f, i, n = 1 << bpp;
+
+	for (f = 0; f < 2; f++) {
+		unsigned char *p = fb_mem + f * PAL_SLOT + 8;
+
+		for (i = 0; i < n; i++) {
+			p[2 * i] = hw_pal[i] >> 8;
+			p[2 * i + 1] = hw_pal[i];
+		}
+	}
+}
+
+/* the whole OSD specification for the current depth; clears the picture */
+static void build_all(void)
+{
+	int f;
+
+	memset(fb_mem, 0, FB_MEM);
+	for (f = 0; f < 2; f++) {
+		unsigned char *blk = fb_mem + f * PAL_SLOT;
+
+		put_header(blk, 0, 1, FIELD_TOP - 1, LEFT, LEFT + 1, line_hdr(f));
+		/* palette at blk + 8, then 2 pixels of colour 0 (zeroed) */
+	}
+	put_be32(fb_mem + TERM_OFF, 0xffffffff);	/* invalid header: first line 0x1ff */
+	put_be32(fb_mem + TERM_OFF + 4, 0xffffffff);
+	write_palette();
+	build_headers();
+}
+
+static void repair(unsigned long data)
+{
+	build_headers();
+	mod_timer(&repair_timer, jiffies + HZ / 10);
+}
+
+/* RGB (16-bit components) -> 14-bit OSD palette entry (ITU-R BT.601, opaque) */
+static u16 rgb_to_osd(unsigned r, unsigned g, unsigned b)
+{
+	unsigned y, cb, cr;
+
+	r >>= 8;
+	g >>= 8;
+	b >>= 8;
+	y = (66 * r + 129 * g + 25 * b + 128 + 16 * 256) >> 8;
+	cb = (32896 + 112 * b - 38 * r - 74 * g) >> 8;
+	cr = (32896 + 112 * r - 94 * g - 18 * b) >> 8;
+	return (y >> 2) << 10 | (cb >> 4) << 4 | (cr >> 4);
+}
+
+static int st20fb_setcolreg(u_int regno, u_int red, u_int green, u_int blue, u_int transp,
+			    struct fb_info *fbi)
+{
+	if (regno >= (1U << bpp))
+		return 1;
+	cmap_red[regno] = red;
+	cmap_green[regno] = green;
+	cmap_blue[regno] = blue;
+	hw_pal[regno] = rgb_to_osd(red, green, blue);
+	/* transparent colour (FBIOPUTCMAP transp >= 0x8000): palette T bit, blended with the
+	   video behind with the region mix weight 0 = video only (datasheet 21.5.10) */
+	if (transp >= 0x8000)
+		hw_pal[regno] |= 0x100;
+	if (fb_mem) {
+		int f;
+
+		for (f = 0; f < 2; f++) {
+			unsigned char *p = fb_mem + f * PAL_SLOT + 8 + 2 * regno;
+
+			p[0] = hw_pal[regno] >> 8;
+			p[1] = hw_pal[regno];
+		}
+	}
+	return 0;
+}
+
+/* 8 bpp default: the 16 VGA colours, a 6x6x6 cube, a 24-step grey ramp (as xterm-256);
+   fewer bits: the kernel's default 4/16-colour maps */
+static void default_palette(void)
+{
+	int i;
+
+	if (bpp < 8) {
+		struct fb_cmap *def = fb_default_cmap(1 << bpp);
+
+		for (i = 0; i < (1 << bpp); i++)
+			st20fb_setcolreg(i, def->red[i], def->green[i], def->blue[i], 0, &info);
+	} else {
+		struct fb_cmap *def = fb_default_cmap(16);
+		static const unsigned char level[6] = { 0, 95, 135, 175, 215, 255 };
+
+		for (i = 0; i < 16; i++)
+			st20fb_setcolreg(i, def->red[i], def->green[i], def->blue[i], 0, &info);
+		for (i = 0; i < 216; i++)
+			st20fb_setcolreg(16 + i, level[i / 36] * 257, level[(i / 6) % 6] * 257,
+					 level[i % 6] * 257, 0, &info);
+		for (i = 0; i < 24; i++) {
+			unsigned v = (8 + 10 * i) * 257;
+
+			st20fb_setcolreg(232 + i, v, v, v, 0, &info);
+		}
+	}
+	cur_cmap.len = 1 << bpp;
+}
+
+static void fill_var(struct fb_var_screeninfo *var)
+{
+	memset(var, 0, sizeof(*var));
+	var->xres = var->xres_virtual = XRES;
+	var->yres = var->yres_virtual = YRES;
+	var->bits_per_pixel = bpp;
+	var->red.length = var->green.length = var->blue.length = bpp;
+	var->height = var->width = -1;
+	var->pixclock = 74074;		/* 13.5 MHz */
+	var->vmode = FB_VMODE_INTERLACED;
+}
+
+static int st20fb_get_fix(struct fb_fix_screeninfo *fix, int con, struct fb_info *fbi)
+{
+	memset(fix, 0, sizeof(*fix));
+	strcpy(fix->id, "ST20 OSD");
+	fix->smem_start = (unsigned long) pixels();
+	fix->smem_len = (YRES - 1) * stride + XRES * bpp / 8;
+	fix->type = FB_TYPE_PACKED_PIXELS;
+	fix->visual = FB_VISUAL_PSEUDOCOLOR;
+	fix->line_length = stride;
+	fix->accel = FB_ACCEL_NONE;
+	return 0;
+}
+
+static int st20fb_get_var(struct fb_var_screeninfo *var, int con, struct fb_info *fbi)
+{
+	fill_var(var);
+	return 0;
+}
+
+static void set_disp(void)
+{
+	struct fb_fix_screeninfo fix;
+
+	st20fb_get_fix(&fix, -1, &info);
+	fill_var(&disp.var);
+	disp.screen_base = (char *) fix.smem_start;
+	disp.visual = fix.visual;
+	disp.type = fix.type;
+	disp.line_length = fix.line_length;
+	disp.can_soft_blank = 0;
+	info.screen_base = disp.screen_base;
+}
+
+static int st20fb_set_var(struct fb_var_screeninfo *var, int con, struct fb_info *fbi)
+{
+	int want = var->bits_per_pixel <= 2 ? 2 : var->bits_per_pixel <= 4 ? 4 : 8;
+
+	if (var->bits_per_pixel > 8 || var->xres > XRES || var->yres > YRES ||
+	    var->xres_virtual > XRES || var->yres_virtual > YRES || var->xoffset || var->yoffset)
+		return -EINVAL;
+	if ((var->activate & FB_ACTIVATE_MASK) == FB_ACTIVATE_NOW && want != bpp) {
+		unsigned long flags;
+
+		save_flags(flags);
+		cli();
+		bpp = want;
+		stride = (8 + XRES * bpp / 8 + 127) & ~127;
+		default_palette();
+		build_all();
+		set_disp();
+		restore_flags(flags);
+	}
+	fill_var(var);
+	var->bits_per_pixel = want;
+	var->red.length = var->green.length = var->blue.length = want;
+	return 0;
+}
+
+static int st20fb_get_cmap(struct fb_cmap *cmap, int kspc, int con, struct fb_info *fbi)
+{
+	fb_copy_cmap(&cur_cmap, cmap, kspc ? 0 : 2);
+	return 0;
+}
+
+static int st20fb_set_cmap(struct fb_cmap *cmap, int kspc, int con, struct fb_info *fbi)
+{
+	return fb_set_cmap(cmap, kspc, st20fb_setcolreg, fbi);
+}
+
+static int st20fb_open(struct fb_info *fbi, int user)
+{
+	if (!fb_mem)
+		return -ENODEV;
+	if (user && users++ == 0) {
+		build_headers();
+		st20_osd_select(fb_mem, fb_mem + PAL_SLOT);
+		mod_timer(&repair_timer, jiffies + HZ / 10);
+	}
+	return 0;
+}
+
+static int st20fb_release(struct fb_info *fbi, int user)
+{
+	if (user && --users == 0) {
+		del_timer(&repair_timer);
+		st20_osd_select(0, 0);		/* back to the text console */
+	}
+	return 0;
+}
+
+static struct fb_ops st20fb_ops = {
+	owner:		THIS_MODULE,
+	fb_open:	st20fb_open,
+	fb_release:	st20fb_release,
+	fb_get_fix:	st20fb_get_fix,
+	fb_get_var:	st20fb_get_var,
+	fb_set_var:	st20fb_set_var,
+	fb_get_cmap:	st20fb_get_cmap,
+	fb_set_cmap:	st20fb_set_cmap,
+};
+
+static int st20fb_switch(int con, struct fb_info *fbi)
+{
+	return 0;
+}
+
+static int st20fb_update(int con, struct fb_info *fbi)
+{
+	return 0;
+}
+
+static void st20fb_blank(int blank, struct fb_info *fbi)
+{
+}
+
+int __init st20fb_setup(char *options)
+{
+	return 0;
+}
+
+int __init st20fb_init(void)
+{
+	if (!fb_mem)
+		return -ENOMEM;
+	init_timer(&repair_timer);
+	repair_timer.function = repair;
+	default_palette();
+	build_all();
+	strcpy(info.modename, "ST20 OSD");
+	info.flags = FBINFO_FLAG_DEFAULT;
+	info.fbops = &st20fb_ops;
+	info.disp = &disp;
+	info.switch_con = st20fb_switch;
+	info.updatevar = st20fb_update;
+	info.blank = st20fb_blank;
+	set_disp();
+	if (register_framebuffer(&info) < 0)
+		return -EINVAL;
+	printk("fb%d: STi5512 OSD %dx%d, 8/4/2 bpp palettised, %d KB at %p\n",
+	       GET_FB_IDX(info.node), XRES, YRES, FB_MEM >> 10, fb_mem);
+	return 0;
+}
+
+MODULE_LICENSE("GPL");
