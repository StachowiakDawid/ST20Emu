diff --git a/linux-2.4.x/include/asm-st20/atomic.h b/linux-2.4.x/include/asm-st20/atomic.h
new file mode 100644
index 000000000..e344f6f64
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/atomic.h
@@ -0,0 +1,65 @@
+#ifndef __ARCH_ST20_ATOMIC__
+#define __ARCH_ST20_ATOMIC__
+
+/* uniprocessor: atomic = with low-priority preemption off (asm/system.h) */
+typedef struct { int counter; } atomic_t;
+#define ATOMIC_INIT(i)	{ (i) }
+
+#define atomic_read(v)		((v)->counter)
+#define atomic_set(v, i)	(((v)->counter) = i)
+
+#include <asm/system.h>
+
+static __inline__ int atomic_add_return(int i, atomic_t *v)
+{
+	unsigned long flags;
+	int ret;
+	__save_and_cli(flags);
+	ret = v->counter += i;
+	__restore_flags(flags);
+	return ret;
+}
+
+static __inline__ int atomic_sub_return(int i, atomic_t *v)
+{
+	unsigned long flags;
+	int ret;
+	__save_and_cli(flags);
+	ret = v->counter -= i;
+	__restore_flags(flags);
+	return ret;
+}
+
+#define atomic_add(i, v)	((void) atomic_add_return((i), (v)))
+#define atomic_sub(i, v)	((void) atomic_sub_return((i), (v)))
+#define atomic_inc(v)		((void) atomic_add_return(1, (v)))
+#define atomic_dec(v)		((void) atomic_sub_return(1, (v)))
+#define atomic_inc_return(v)	atomic_add_return(1, (v))
+#define atomic_dec_return(v)	atomic_sub_return(1, (v))
+#define atomic_sub_and_test(i,v) (atomic_sub_return((i), (v)) == 0)
+#define atomic_dec_and_test(v)	(atomic_sub_return(1, (v)) == 0)
+#define atomic_inc_and_test(v)	(atomic_add_return(1, (v)) == 0)
+#define atomic_add_negative(i,v) (atomic_add_return((i), (v)) < 0)
+
+static __inline__ void atomic_clear_mask(unsigned long mask, unsigned long *v)
+{
+	unsigned long flags;
+	__save_and_cli(flags);
+	*v &= ~mask;
+	__restore_flags(flags);
+}
+
+static __inline__ void atomic_set_mask(unsigned long mask, unsigned long *v)
+{
+	unsigned long flags;
+	__save_and_cli(flags);
+	*v |= mask;
+	__restore_flags(flags);
+}
+
+#define smp_mb__before_atomic_dec()	barrier()
+#define smp_mb__after_atomic_dec()	barrier()
+#define smp_mb__before_atomic_inc()	barrier()
+#define smp_mb__after_atomic_inc()	barrier()
+
+#endif /* __ARCH_ST20_ATOMIC__ */
diff --git a/linux-2.4.x/include/asm-st20/bitops.h b/linux-2.4.x/include/asm-st20/bitops.h
new file mode 100644
index 000000000..96dae5939
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/bitops.h
@@ -0,0 +1,213 @@
+#ifndef _ST20_BITOPS_H
+#define _ST20_BITOPS_H
+
+/*
+ * Bit operations for the uniprocessor ST20 in C: atomic = with low-priority preemption off
+ * (asm/system.h).  Bit nr lives in word nr >> 5 (little-endian word order, so ext2/minix
+ * byte-addressed bitmaps use the same numbering).
+ */
+#include <linux/config.h>
+#include <asm/system.h>
+
+#ifdef __KERNEL__
+
+static __inline__ unsigned long ffz(unsigned long word)
+{
+	unsigned long result = 0;
+
+	while (word & 1) {
+		result++;
+		word >>= 1;
+	}
+	return result;
+}
+
+static __inline__ void set_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long flags;
+
+	__save_and_cli(flags);
+	*a |= 1UL << (nr & 31);
+	__restore_flags(flags);
+}
+
+static __inline__ void __set_bit(int nr, volatile void *addr)
+{
+	((volatile unsigned long *) addr)[nr >> 5] |= 1UL << (nr & 31);
+}
+
+#define smp_mb__before_clear_bit()	barrier()
+#define smp_mb__after_clear_bit()	barrier()
+
+static __inline__ void clear_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long flags;
+
+	__save_and_cli(flags);
+	*a &= ~(1UL << (nr & 31));
+	__restore_flags(flags);
+}
+
+static __inline__ void __clear_bit(int nr, volatile void *addr)
+{
+	((volatile unsigned long *) addr)[nr >> 5] &= ~(1UL << (nr & 31));
+}
+
+static __inline__ void change_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long flags;
+
+	__save_and_cli(flags);
+	*a ^= 1UL << (nr & 31);
+	__restore_flags(flags);
+}
+
+static __inline__ void __change_bit(int nr, volatile void *addr)
+{
+	((volatile unsigned long *) addr)[nr >> 5] ^= 1UL << (nr & 31);
+}
+
+static __inline__ int test_bit(int nr, const volatile void *addr)
+{
+	return (((const volatile unsigned long *) addr)[nr >> 5] >> (nr & 31)) & 1;
+}
+
+static __inline__ int __test_and_set_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long mask = 1UL << (nr & 31);
+	int old = (*a & mask) != 0;
+
+	*a |= mask;
+	return old;
+}
+
+static __inline__ int test_and_set_bit(int nr, volatile void *addr)
+{
+	unsigned long flags;
+	int old;
+
+	__save_and_cli(flags);
+	old = __test_and_set_bit(nr, addr);
+	__restore_flags(flags);
+	return old;
+}
+
+static __inline__ int __test_and_clear_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long mask = 1UL << (nr & 31);
+	int old = (*a & mask) != 0;
+
+	*a &= ~mask;
+	return old;
+}
+
+static __inline__ int test_and_clear_bit(int nr, volatile void *addr)
+{
+	unsigned long flags;
+	int old;
+
+	__save_and_cli(flags);
+	old = __test_and_clear_bit(nr, addr);
+	__restore_flags(flags);
+	return old;
+}
+
+static __inline__ int __test_and_change_bit(int nr, volatile void *addr)
+{
+	volatile unsigned long *a = (volatile unsigned long *) addr + (nr >> 5);
+	unsigned long mask = 1UL << (nr & 31);
+	int old = (*a & mask) != 0;
+
+	*a ^= mask;
+	return old;
+}
+
+static __inline__ int test_and_change_bit(int nr, volatile void *addr)
+{
+	unsigned long flags;
+	int old;
+
+	__save_and_cli(flags);
+	old = __test_and_change_bit(nr, addr);
+	__restore_flags(flags);
+	return old;
+}
+
+/* first zero bit at or after offset in the bitmap of size bits, or size */
+static __inline__ int find_next_zero_bit(void *addr, int size, int offset)
+{
+	unsigned long *p = (unsigned long *) addr;
+	int i;
+
+	for (i = offset; i < size; i++) {
+		if ((i & 31) == 0 && p[i >> 5] == ~0UL && i + 32 <= size) {
+			i += 31;
+			continue;
+		}
+		if (!((p[i >> 5] >> (i & 31)) & 1))
+			return i;
+	}
+	return size;
+}
+
+#define find_first_zero_bit(addr, size)	find_next_zero_bit((addr), (size), 0)
+
+static __inline__ int find_next_bit(void *addr, int size, int offset)
+{
+	unsigned long *p = (unsigned long *) addr;
+	int i;
+
+	for (i = offset; i < size; i++) {
+		if ((i & 31) == 0 && p[i >> 5] == 0 && i + 32 <= size) {
+			i += 31;
+			continue;
+		}
+		if ((p[i >> 5] >> (i & 31)) & 1)
+			return i;
+	}
+	return size;
+}
+
+#define find_first_bit(addr, size)	find_next_bit((addr), (size), 0)
+
+/* ffs: 1-based like the libc function, 0 for 0 */
+static __inline__ int ffs(int x)
+{
+	int r = 1;
+
+	if (!x)
+		return 0;
+	while (!(x & 1)) {
+		x = (unsigned int) x >> 1;
+		r++;
+	}
+	return r;
+}
+
+#define __ffs(x)	(ffs(x) - 1)
+
+#define hweight32(x) generic_hweight32(x)
+#define hweight16(x) generic_hweight16(x)
+#define hweight8(x) generic_hweight8(x)
+
+/* little-endian: the ext2 and minix bitmaps are the native ones */
+#define ext2_set_bit(nr, addr)		__test_and_set_bit((nr), (addr))
+#define ext2_clear_bit(nr, addr)	__test_and_clear_bit((nr), (addr))
+#define ext2_test_bit(nr, addr)		test_bit((nr), (addr))
+#define ext2_find_first_zero_bit(addr, size)	find_first_zero_bit((addr), (size))
+#define ext2_find_next_zero_bit(addr, size, off) find_next_zero_bit((addr), (size), (off))
+
+#define minix_test_and_set_bit(nr,addr)		test_and_set_bit(nr,addr)
+#define minix_set_bit(nr,addr)			set_bit(nr,addr)
+#define minix_test_and_clear_bit(nr,addr)	test_and_clear_bit(nr,addr)
+#define minix_test_bit(nr,addr)			test_bit(nr,addr)
