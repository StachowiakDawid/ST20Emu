+extern long st20_kernel_syscall(long, long, long, long, long, long);
+#define __st20_syscall(nr,a,b,c,d,e) \
+	st20_kernel_syscall((long)(nr), (long)(a), (long)(b), (long)(c), (long)(d), (long)(e))
