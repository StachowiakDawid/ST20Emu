diff --git a/linux-2.4.x/arch/st20/Makefile b/linux-2.4.x/arch/st20/Makefile
new file mode 100644
index 000000000..3ec6106ef
--- /dev/null
+++ b/linux-2.4.x/arch/st20/Makefile
@@ -0,0 +1,45 @@
+#
+# arch/st20/Makefile: uClinux/ST20 (Samsung DSR9500, STi5512) with gcc-2.7.2-t800 (t450)
+# and ttools (ast, lit, crossload).  Included by the top Makefile.
+#
+CROSS_COMPILE = t450-
+AS      = ast
+LD      = $(TOPDIR)/arch/st20/tools/st20-ld
+# t450-gcc that puts __init/__initdata into the "init" segment (freed after boot)
+CC      = $(TOPDIR)/arch/st20/tools/st20-cc
+AR      = ar
+NM      = true
+STRIP   = true
+OBJCOPY = true
+LIBGCC  := $(shell $(CC) -print-libgcc-file-name)
+
+# gcc 2.7.2 has no -fno-strict-aliasing.  (Strength reduction is on again: the cc1 crash on
+# fs/proc/array.c, fs/block_dev.c was a reg-stack bug, fixed in the compiler.)
+# No -fno-common: with it gcc-t800 puts uninitialised globals into .data as zeros; as
+# .comm lit merges them into bss, which linux.bin does not contain.
+CFLAGS := $(filter-out -fno-strict-aliasing -fno-common,$(CFLAGS)) -mt450 -DNO_MM -DNO_FPU \
+	-fsigned-char -DNO_FORGET -D__linux__ -DUTS_SYSNAME='"uClinux"'
+AFLAGS := $(AFLAGS) -DNO_MM -DNO_FPU
+
+SUBDIRS := arch/st20/kernel arch/st20/mm arch/st20/lib $(SUBDIRS)
+CORE_FILES := arch/st20/kernel/kernel.o arch/st20/mm/mm.o $(CORE_FILES)
+LIBS += arch/st20/lib/lib.a $(LIBGCC)
+
+# kernel image: linked at 0xc0001000 (0xc0000000 holds the syscall vector)
+HEAD := arch/st20/kernel/head.o
+LINKFLAGS = -T 0xc0001000 -mlinux.map
+
+# linux.bin = text + init + data: crossload's trailing bss zeros are dropped (head.ast
+# clears bss)
+linux.bin: linux
+	crossload -o linux.bin.full linux
+	head -c $$(awk '$$1 ~ /^(text|init|data)@@size$$/ {s += $$2} END {print s}' \
+		linux.map) linux.bin.full > linux.bin
+	rm -f linux.bin.full
+
+archclean:
+	rm -f linux.bin linux.map
+
+archmrproper:
+
+archdep:
