diff --git a/linux-2.4.x/arch/st20/tools/st20-cc b/linux-2.4.x/arch/st20/tools/st20-cc
new file mode 100755
index 000000000..760d8822d
--- /dev/null
+++ b/linux-2.4.x/arch/st20/tools/st20-cc
@@ -0,0 +1,55 @@
+#!/bin/bash
+# CC for the uClinux/ST20 kernel build: t450-gcc, except that `-c FILE.c` puts the __init
+# functions and __initdata objects of FILE into the assembler segment "init" (lit has no
+# named sections and gcc-t800 no section attribute, but ast has any number of segments,
+# laid out by head.ast as text, init, data, bss; free_initmem frees the init segment):
+#   1. t450-gcc -E -D__ST20_INIT_MARKS: include/linux/init.h then defines __init and
+#      __initdata as marker words; the names declared with them are read from the output
+#      (functions: the identifier before the first "(" after the marker; data: "name[...]
+#      MARK" or "MARK type name =")
+#   2. t450-gcc -S (the real compile, markers empty)
+#   3. arch/st20/tools/st20-initseg moves those functions' and objects' assembly (from
+#      their label to the next non-local column-0 line) into `.init`
+#   4. the assembler (t450-as = ast)
+# Everything else (-E, -M, .S/.ast, links) goes straight to t450-gcc.  Set ST20_NO_INITSEG
+# to compile normally.
+GCC=${ST20_GCC:-t450-gcc}
+TOOLS=$(dirname "$0")
+src=; out=; compile=0; args=()
+for a in "$@"; do
+  case "$a" in
+    -c) compile=1 ;;
+    -E|-S|-M|-MM|-MD|-MMD) compile=2 ;;
+  esac
+done
+if [ $compile != 1 ] || [ -n "$ST20_NO_INITSEG" ]; then exec $GCC "$@"; fi
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -c) ;;
+    -o) out=$2; shift ;;
+    *.c) src=$1; args+=("$1") ;;
+    *) args+=("$1") ;;
+  esac
+  shift
+done
+[ -n "$src" ] || exec $GCC -c ${out:+-o "$out"} "${args[@]}"
+[ -n "$out" ] || out=$(basename "${src%.c}").o
+tmp=$(mktemp -d /tmp/st20cc.XXXXXX) || exit 1
+trap 'rm -rf "$tmp"' EXIT
+# 1. names
+$GCC -E -D__ST20_INIT_MARKS "${args[@]}" > "$tmp/m.i" 2>/dev/null || exec $GCC -c -o "$out" "${args[@]}"
+names=$(perl -0777 -ne '
+  while (/__st20_init_mark__[\s\w*]*?(\w+)\s*\(/g) { print "F $1\n"; }
+  while (/(\w+)\s*(?:\[[^\]]*\]\s*)*__st20_initdata_mark__/g) { print "D $1\n"; }
+  while (/__st20_initdata_mark__[\s\w*]*?(\w+)\s*[\[=;,]/g) { print "D $1\n"; }
+' "$tmp/m.i" | sort -u)
+# 2. compile
+$GCC -S -o "$tmp/a.s" "${args[@]}" || exit 1
+# 3. move, 4. assemble
+if [ -n "$names" ]; then
+  echo "$names" > "$tmp/names"
+  perl "$TOOLS/st20-initseg" "$tmp/names" "$tmp/a.s" > "$tmp/b.s" || exit 1
+else
+  mv "$tmp/a.s" "$tmp/b.s"
+fi
+$GCC -c -o "$out" "$tmp/b.s"
diff --git a/linux-2.4.x/arch/st20/tools/st20-initseg b/linux-2.4.x/arch/st20/tools/st20-initseg
new file mode 100755
index 000000000..e9a228ec5
--- /dev/null
+++ b/linux-2.4.x/arch/st20/tools/st20-initseg
@@ -0,0 +1,92 @@
+#!/usr/bin/perl
+# st20-initseg NAMES FILE.s > OUT.s (from arch/st20/tools/st20-cc): moves the __init
+# functions ("F name" in NAMES) and __initdata objects ("D name") of gcc-t800's assembly
+# into the ast segment "init".
+#
+# A piece starts at its label `_name:` (a function in .text, an object in .data; an
+# object's `.align` line just before the label moves with it) and runs to the next
+# column-0 label that is not local (L@n:, LFn:, ...).  `.globl x;` lines inside it (gcc
+# declares external names at their first use, also inside initialisers) stay in it.  A
+# segment switch inside it (gcc emits string constants, LC@n, into .text at that point)
+# passes through unchanged (after a switch back to the piece's own segment, so that a
+# trailing `.align` stays where it was); when gcc switches back to the piece's segment and continues
+# with more of the piece (an indented line that is not `.align`, before any new label),
+# that switch becomes `.init` again.  String constants stay in .text (one literal may be
+# shared with other functions).
+use strict;
+my ($namesf, $sf) = @ARGV;
+my (%fn, %data);
+open(my $n, '<', $namesf) or die "$namesf: $!";
+while (<$n>) { $fn{$1} = 1 if /^F (\w+)/; $data{$1} = 1 if /^D (\w+)/; }
+close($n);
+open(my $s, '<', $sf) or die "$sf: $!";
+my @l = <$s>;
+close($s);
+
+my $seg = 'text';	# gcc's current segment
+my $piece = '';		# segment of the open init piece ('' = none)
+my $susp = '';		# segment of a piece interrupted by a segment switch
+my @out;
+
+# leave the init segment: back to $piece's segment; trailing `.align` lines belong to
+# whatever follows there, not to the piece
+sub close_piece {
+  my @al;
+  unshift @al, pop @out while @out && $out[-1] =~ /^\s+\.align\s/;
+  push @out, ".$piece\n", @al;
+  $piece = '';
+}
+
+sub is_local { return $_[0] =~ /^(L@\w+|LF\d+):/; }	# not LC@n (constants)
+
+# after a switch back to a piece's segment at line $i: does the piece continue?
+sub continues {
+  my ($i) = @_;
+  for (my $j = $i + 1; $j < @l; $j++) {
+    next if $l[$j] =~ /^\.globl\s/;
+    return is_local($l[$j]) if $l[$j] =~ /^\S/;	# a label or directive
+    return 0 if $l[$j] =~ /^\s+\.align\s/;		# alignment of the next object
+    return 1;
+  }
+  return 0;
+}
+
+for (my $i = 0; $i < @l; $i++) {
+  my $line = $l[$i];
+  if ($line =~ /^\.(text|data|bss)\s*$/) {
+    next if $piece ne '' && $1 eq $piece;	# a redundant switch inside the piece
+    $seg = $1;
+    if ($piece ne '') {				# leaving the init segment
+      $susp = $piece;
+      close_piece();
+    } elsif ($susp eq $seg) {
+      $susp = '';
+      if (continues($i)) {			# back to the interrupted piece
+        $piece = $seg;
+        push @out, ".init\n";
+        next;
+      }
+    }
+    push @out, $line;
+    next;
+  }
+  if ($piece ne '' && $line =~ /^[^\s.]/ && !is_local($line)) {
+    close_piece();				# a new non-local label: end of the piece
+  }
+  if ($piece eq '' && $line =~ /^_(\w+):/) {
+    my $name = $1;
+    if (($seg eq 'text' && $fn{$name}) || ($seg eq 'data' && $data{$name})) {
+      my $align;
+      if ($seg eq 'data' && @out && $out[-1] =~ /^\s+\.align\s/) { $align = pop @out; }
+      push @out, ".init\n";
+      push @out, $align if defined $align;
+      push @out, $line;
+      $piece = $seg;
+      $susp = '';
+      next;
+    }
+  }
+  push @out, $line;
+}
+close_piece() if $piece ne '';
+print @out;
diff --git a/linux-2.4.x/arch/st20/tools/st20-ld b/linux-2.4.x/arch/st20/tools/st20-ld
new file mode 100755
index 000000000..b028723f4
--- /dev/null
+++ b/linux-2.4.x/arch/st20/tools/st20-ld
@@ -0,0 +1,105 @@
+#!/bin/bash
+# ld for the uClinux/ST20 kernel build with ttools (lit has no relocatable output and no
+# named sections):
+#   ld -r -o X.o inputs...   X.o becomes an ar archive of all input objects
+#   ld ... inputs -o out     final link with lit.  Archive inputs (possibly nested: ar
+#                            members that are themselves archives) are flattened first,
+#                            members renamed to short unique names (lit reads only plain
+#                            archives).  Before linking, the initcall and __setup tables
+#                            are generated: every __initcall()/__setup() object
+#                            (include/linux/init.h, ST20 part) is a global named
+#                            __st20_ic__BASE__LINE__FN / __st20_su__BASE__LINE__FN; they are
+#                            listed in link order (object order, then source line) from
+#                            litdump, written to st20_tables.c (st20_initcall_table[],
+#                            st20_setup_table[], read by init/main.c), compiled and linked
+#                            after the head object.  The references from the tables also
+#                            pull in archive members only reachable through an initcall.
+# --start-group/--end-group and -g/-x/-X/-s are ignored.
+args=(); out=a.out; rel=0; ins=()
+while [ $# -gt 0 ]; do
+  case "$1" in
+    -r) rel=1 ;;
+    -g|-x|-X|-s|--start-group|--end-group) ;;
+    -o) out="$2"; shift ;;
+    *.o|*.a) ins+=("$1") ;;
+    *) args+=("$1") ;;
+  esac
+  shift
+done
+
+tmp=$(mktemp -d); n=0
+trap 'rm -rf "$tmp"' EXIT
+
+is_ar() { [ "$(head -c 7 "$1")" = '!<arch>' ]; }
+
+allobjs=()
+# flatten FILE into directory DIR as m%05d.o members (recursive for nested archives)
+flatten() {
+  local f=$1 dir=$2 d m a
+  if is_ar "$f"; then
+    d=$(mktemp -d "$tmp/x.XXXXXX"); a=$(readlink -f "$f")
+    (cd "$d" && ar x "$a")
+    for m in $(ar t "$f"); do flatten "$d/$m" "$dir"; done
+  else
+    n=$((n+1)); cp "$f" "$dir/$(printf m%05d.o $n)"
+    allobjs+=("$dir/$(printf m%05d.o $n)")
+  fi
+}
+
+if [ $rel = 1 ]; then
+  o=$(readlink -f "$(dirname "$out")")/$(basename "$out")
+  mkdir "$tmp/out"
+  for f in "${ins[@]}"; do flatten "$f" "$tmp/out"; done
+  rm -f "$out"
+  if [ $n -gt 0 ]; then (cd "$tmp/out" && ar rcS "$o" m*.o) || exit 1
+  else ar rcS "$o"; fi
+  exit 0
+fi
+
+# final link: objects stay objects, each archive input becomes one flat archive
+lins=(); k=0
+for f in "${ins[@]}"; do
+  if is_ar "$f"; then
+    k=$((k+1)); dir="$tmp/a$k"; mkdir "$dir"
+    flatten "$f" "$dir"
+    if ls "$dir"/m*.o >/dev/null 2>&1; then
+      (cd "$dir" && ar rcS "$tmp/a$k.a" m*.o) || exit 1
+      lins+=("$tmp/a$k.a")
+    fi
+  else
+    allobjs+=("$f")
+    lins+=("$f")
+  fi
+done
+
+# initcall/setup tables, in link order
+i=0
+for f in "${allobjs[@]}"; do
+  i=$((i+1))
+  litdump "$f" 2>/dev/null | sed -n 's/^.* is _\(__st20_\(ic\|su\)__[A-Za-z0-9_]*\), fragment defined here$/\1/p' |
+    while read -r s; do
+      line=$(echo "$s" | sed -n 's/^__st20_.._.*__\([0-9][0-9]*\)__.*$/\1/p')
+      printf '%06d %06d %s\n' "$i" "${line:-0}" "$s"
+    done
+done | sort > "$tmp/syms"
+{
+  echo '/* generated by arch/st20/tools/st20-ld: initcalls and __setup entries in link order */'
+  echo 'typedef int (*initcall_t)(void);'
+  echo 'struct kernel_param;'
+  awk '$3 ~ /^__st20_ic__/ {print "extern initcall_t " $3 ";"}' "$tmp/syms"
+  awk '$3 ~ /^__st20_su__/ {print "extern struct kernel_param " $3 ";"}' "$tmp/syms"
+  echo 'initcall_t *const st20_initcall_table[] = {'
+  awk '$3 ~ /^__st20_ic__/ {print "\t&" $3 ","}' "$tmp/syms"
+  echo '	0'
+  echo '};'
+  echo 'struct kernel_param *const st20_setup_table[] = {'
+  awk '$3 ~ /^__st20_su__/ {print "\t&" $3 ","}' "$tmp/syms"
+  echo '	0'
+  echo '};'
+} > "$tmp/st20_tables.c"
+cp "$tmp/st20_tables.c" "$(dirname "$out")/st20_tables.c"
+t450-gcc -O2 -c -o "$tmp/st20_tables.o" "$tmp/st20_tables.c" || exit 1
+echo "st20-ld: $(grep -c '&__st20_ic__' "$tmp/st20_tables.c") initcalls," \
+     "$(grep -c '&__st20_su__' "$tmp/st20_tables.c") setup entries"
+lins=("${lins[0]}" "$tmp/st20_tables.o" "${lins[@]:1}")
+lit "${args[@]}" -o "$out" "${lins[@]}"
