+#ifndef _ST20_PTRACE_H
+#define _ST20_PTRACE_H
+
+/*
+ * ST20 register state saved on kernel entry (system call or preemption).  ST20 has no
+ * general registers: a process is its Wptr (workspace = stack) and Iptr, plus the
+ * evaluation stack Areg-Creg (empty at calls, live at a preemption or signal stop).
+ *
+ * This is also the ptrace "user area" (PTRACE_PEEKUSER/POKEUSER, word offsets PT_* * 4;
+ * PTRACE_GETREGS copies PT_WORDS words): at a system call stop (PTRACE_SYSCALL) orig_nr
+ * and arg[] are the call, result is the return value at the exit stop; at a signal stop
+ * orig_nr is -1 (or the interrupted call) and wptr/iptr/areg-creg are the exact user
+ * state, which POKEUSER may change.  PT_TEXT/PT_DATA/PT_BSS follow (read only).
+ */
+#ifndef __ASSEMBLY__
+struct pt_regs {
+	long		orig_nr;	/* syscall number, -1 for a trap */
+	long		arg[6];		/* syscall arguments (arg[5] only for 6-argument calls) */
+	long		result;		/* syscall result */
+	unsigned long	wptr;		/* Wptr of the interrupted/calling code */
+	unsigned long	iptr;		/* Iptr to resume at */
+	unsigned long	status;		/* 1 = entered from user mode */
+	unsigned long	areg, breg, creg; /* evaluation stack (signal stops) */
+};
+#endif
+
+#define PT_ORIG_NR	0
+#define PT_ARG0		1
+#define PT_RESULT	7
+#define PT_WPTR		8
+#define PT_IPTR		9
+#define PT_STATUS	10
+#define PT_AREG		11
+#define PT_BREG		12
+#define PT_CREG		13
+#define PT_WORDS	14
+#define PT_TEXT		14	/* mm->start_code */
+#define PT_DATA		15	/* mm->start_data */
+#define PT_BSS		16	/* mm->end_data */
+#define PT_USER_WORDS	17
+
+#define PS_USER		1
+
+#define PTRACE_GETREGS		12
+#define PTRACE_SETREGS		13
+
+#ifdef __KERNEL__
+#ifndef __ASSEMBLY__
+#define user_mode(regs)		(((regs)->status & PS_USER) != 0)
+#define instruction_pointer(regs) ((regs)->iptr)
+extern void show_regs(struct pt_regs *);
+
+/* a system call's result at signal delivery, for restarting it (signal.c, syscalls.c) */
+struct st20_syscall_restart {
+	long		res;		/* its return value (-ERESTART* to restart) */
+	unsigned long	*uw;		/* the caller's workspace: uw[1..7] = nr, a..f */
+};
+#endif
+#endif
+
+#endif /* _ST20_PTRACE_H */
