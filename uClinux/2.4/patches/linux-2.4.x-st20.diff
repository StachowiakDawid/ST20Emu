diff --git a/linux-2.4.x/include/asm-st20/delay.h b/linux-2.4.x/include/asm-st20/delay.h
new file mode 100644
index 000000000..3494026e3
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/delay.h
@@ -0,0 +1,24 @@
+#ifndef _ST20_DELAY_H
+#define _ST20_DELAY_H
+
+#include <asm/param.h>
+
+/* busy loops calibrated by calibrate_delay() */
+extern __inline__ void __delay(unsigned long loops)
+{
+	volatile unsigned long n = loops;
+	while (n)
+		n--;
+}
+
+extern unsigned long loops_per_jiffy;
+
+extern __inline__ void udelay(unsigned long usecs)
+{
+	unsigned long long l = (unsigned long long) usecs * (loops_per_jiffy * HZ);
+	__delay((unsigned long) (l / 1000000));
+}
+
+#define ndelay(nsecs)	udelay(((nsecs) + 999) / 1000)
+
+#endif /* _ST20_DELAY_H */
