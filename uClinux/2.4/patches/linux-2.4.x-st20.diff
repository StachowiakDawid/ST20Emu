diff --git a/linux-2.4.x/include/linux/init.h b/linux-2.4.x/include/linux/init.h
index e1dbcecd0..5ac3eb38a 100644
--- a/linux-2.4.x/include/linux/init.h
+++ b/linux-2.4.x/include/linux/init.h
@@ -50,10 +50,31 @@ typedef void (*exitcall_t)(void);
 
 extern initcall_t __initcall_start, __initcall_end;
 
+#ifdef CONFIG_ST20
+/*
+ * ST20 (gcc-2.7.2-t800 + ttools lit): no named sections.  Each initcall and __setup entry
+ * is a global object named after its file (KBUILD_BASENAME), line and function; the
+ * kernel link (arch/st20/tools/st20-ld) lists them in link order into
+ * st20_initcall_table[] and st20_setup_table[] (init/main.c).
+ */
+#ifndef KBUILD_BASENAME
+#define KBUILD_BASENAME nobase
+#endif
+#define __ST20_TABNAME2(kind, base, line, fn)	__st20_##kind##__##base##__##line##__##fn
+#define __ST20_TABNAME(kind, base, line, fn)	__ST20_TABNAME2(kind, base, line, fn)
+extern initcall_t *const st20_initcall_table[];
+#define __initcall(fn)								\
+	initcall_t __ST20_TABNAME(ic, KBUILD_BASENAME, __LINE__, fn) = fn
+/* module_exit(): only a module image (arch/st20/kernel/module.c) uses it; in the kernel
+ * nothing refers to it and lit drops it with the exit function */
+#define __exitcall(fn)								\
+	exitcall_t __ST20_TABNAME(ec, KBUILD_BASENAME, __LINE__, fn) = fn
+#else
 #define __initcall(fn)								\
 	static initcall_t __initcall_##fn __init_call = fn
 #define __exitcall(fn)								\
 	static exitcall_t __exitcall_##fn __exit_call = fn
+#endif
 
 /*
  * Used for kernel command line parameter setup
@@ -65,9 +86,16 @@ struct kernel_param {
 
 extern struct kernel_param __setup_start, __setup_end;
 
+#ifdef CONFIG_ST20
+extern struct kernel_param *const st20_setup_table[];
+#define __setup(str, fn)								\
+	static char __setup_str_##fn[] = str;						\
+	struct kernel_param __ST20_TABNAME(su, KBUILD_BASENAME, __LINE__, fn) = { __setup_str_##fn, fn }
+#else
 #define __setup(str, fn)								\
 	static char __setup_str_##fn[] __initdata = str;				\
 	static struct kernel_param __setup_##fn __attribute__((unused)) __initsetup = { __setup_str_##fn, fn }
+#endif
 
 #endif /* __ASSEMBLY__ */
 
@@ -75,6 +103,26 @@ extern struct kernel_param __setup_start, __setup_end;
  * Mark functions and data as being only used at initialization
  * or exit time.
  */
+#if defined(CONFIG_ST20)
+/*
+ * No named sections in gcc-t800/lit: arch/st20/tools/st20-cc finds the names declared
+ * __init/__initdata in a preprocessing pass with __ST20_INIT_MARKS (these marker words
+ * are then the only use) and moves their assembly into the "init" segment, which
+ * free_initmem() frees.  __exit code is unreferenced and dropped by lit.
+ */
+#ifdef __ST20_INIT_MARKS
+#define __init		__st20_init_mark__
+#define __initdata	__st20_initdata_mark__
+#else
+#define __init
+#define __initdata
+#endif
+#define __exit
+#define __exitdata
+#define __initsetup
+#define __init_call
+#define __exit_call
+#else
 #ifndef NO_TEXT_SECTIONS
 #define __init		__attribute__ ((__section__ (".text.init")))
 #define __exit		__attribute__ ((unused, __section__(".text.exit")))
@@ -87,6 +135,7 @@ extern struct kernel_param __setup_start, __setup_end;
 #define __initsetup	__attribute__ ((unused,__section__ (".setup.init")))
 #define __init_call	__attribute__ ((unused,__section__ (".initcall.init")))
 #define __exit_call	__attribute__ ((unused,__section__ (".exitcall.exit")))
