diff --git a/linux-2.4.x/include/asm-st20/board.h b/linux-2.4.x/include/asm-st20/board.h
new file mode 100644
index 000000000..ac3fd6661
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/board.h
@@ -0,0 +1,28 @@
+#ifndef _ST20_BOARD_H
+#define _ST20_BOARD_H
+
+/*
+ * Samsung DSR9500 (STi5512): the only supported board.
+ *   SDRAM	0xc0000000-0xc07fffff (8 MB, EMI bank 0, set up by the ROM loader)
+ *   flash	0x7fe00000-0x7fffffff (2 MB), reset entry 0x7ffffffe
+ *   console	ASC at 0x20006000 (the original loader's UART, interrupt 7): printk + /dev/ttyS0
+ *   root fs	romfs image in the flash's "romfs" MTD partition (/dev/mtdblock1)
+ * Kernel: linked at 0xc0001000; 0xc0000000 holds the system call vector.
+ */
+#define ST20_BOARD_NAME		"Samsung DSR9500 (STi5512)"
+#define ST20_RAM_START		0xc0000000UL
+#define ST20_RAM_END		0xc0800000UL
+#define ST20_FLASH_START	0x7fe00000UL
+#define ST20_FLASH_END		0x80000000UL
+#define ST20_CONSOLE_ASC	0x20006000UL
+
+/* flash layout (MTD partitions, drivers/mtd/maps/dsr9500-flash.c; images placed by
+   tools/mkrom-dsr9500.py, which repeats these numbers): offsets from ST20_FLASH_START,
+   all 64 KB sector aligned */
+#define ST20_FLASH_KERNEL	0x000000UL	/* mtd0: kernel image, copied to 0xc0001000 */
+#define ST20_FLASH_ROMFS	0x0c0000UL	/* mtd1: root romfs */
+#define ST20_FLASH_JFFS2	0x170000UL	/* mtd2: JFFS2 (/etc/config), 8 blocks */
+#define ST20_FLASH_BOOT		0x1f0000UL	/* mtd3: loader, boot init blob, reset entry */
+#define ST20_FLASH_SIZE		0x200000UL
+
+#endif /* _ST20_BOARD_H */
