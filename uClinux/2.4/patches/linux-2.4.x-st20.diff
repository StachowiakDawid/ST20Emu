+extern char __down_interruptible;
+extern char __up;
+extern char tasklet_init;
+extern char netif_rx;
+extern char alloc_skb;
+extern char __kfree_skb;
+extern char kmem_cache_create;
+extern char kmem_cache_destroy;
+extern char kmem_cache_alloc;
+extern char kmem_cache_free;
+extern char request_irq;
+extern char free_irq;
+extern char interruptible_sleep_on_timeout;
+extern char jiffies, xtime;
+
+void *const st20_module_ksyms[] = {
+	&printk,
+	&sprintf,
+	&snprintf,
+	&vsprintf,
+	&simple_strtoul,
+	&simple_strtol,
+	&memcpy,
+	&memset,
+	&memmove,
+	&memcmp,
+	&strcpy,
+	&strncpy,
+	&strcat,
+	&strlen,
+	&strcmp,
+	&strncmp,
+	&strchr,
+	&kmalloc,
+	&kfree,
+	&vfree,
+	&__get_free_pages,
+	&free_pages,
+	&register_chrdev,
+	&unregister_chrdev,
+	&create_proc_entry,
+	&remove_proc_entry,
+	&proc_mkdir,
+	&add_timer,
+	&del_timer,
+	&mod_timer,
+	&__wake_up,
+	&interruptible_sleep_on,
+	&schedule,
+	&schedule_timeout,
+	&do_gettimeofday,
+	&panic,
+	&kernel_thread,
+	&send_sig,
+	&kill_proc,
+	&__down,
+	&__down_interruptible,
+	&__up,
+	&tasklet_init,
+	&netif_rx,
+	&alloc_skb,
+	&__kfree_skb,
+	&kmem_cache_create,
+	&kmem_cache_destroy,
+	&kmem_cache_alloc,
+	&kmem_cache_free,
