+};
diff --git a/linux-2.4.x/arch/st20/kernel/module.c b/linux-2.4.x/arch/st20/kernel/module.c
new file mode 100644
index 000000000..cee34e6fb
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/module.c
@@ -0,0 +1,245 @@
+/*
+ * arch/st20/kernel/module.c - loadable modules for uClinux/ST20 (no ELF, no MMU)
+ *
+ * The toolchain (ttools lit) has no relocatable output, so a module is linked on the host
+ * against the exact kernel it is loaded into (work/net/modules: modlink.sh links it twice,
+ * at 0x50000000 and 0x51000000, with every kernel symbol it uses as an absolute value from
+ * linux.map; mkmod.py diffs the two images into a .mod with relocations):
+ *
+ *   header  (struct st20_mod_header, little endian)
+ *   image   text + data as linked at hdr.base
+ *   n_abs   offsets of words holding module addresses (+= load - base)
+ *   n_pcrel (len << 24 | neg << 23 | offset, operand at base): a pfix/nfix sequence of len
+ *           bytes whose operand depends on the distance to the kernel (call, ldc sym-L;
+ *           ldpi): operand -= load - base (neg: +=), re-encoded in the same length
+ *
+ * init_module(image, len) (syscall 128) checks the header (magic, linux_banner hash = the
+ * kernel it was linked against), copies the image into kmalloc'd memory, clears bss,
+ * relocates, invalidates the I-cache and calls its init function (module_init(); a nonzero
+ * result unloads it again).  delete_module(name) (129) calls the module_exit() function and
+ * frees it; /proc/modules lists the loaded ones.  There is no use counting: unloading a
+ * module that still has open files or registered callbacks is the caller's problem.
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include <linux/proc_fs.h>
+#include <linux/init.h>
+#include <asm/uaccess.h>
+#include <asm/semaphore.h>
+#include <asm/pgalloc.h>
+
+#define ST20_MOD_MAGIC	0x4d303253	/* "S20M" */
+#define PFIX		2
+#define NFIX		6
+
+struct st20_mod_header {
+	unsigned long magic, version, banner_hash, base, size, bss;
+	unsigned long init, exit, n_abs, n_pcrel;
+	char name[24];
+};
+
+struct st20_module {
+	struct st20_module *next;
+	char name[24];
+	unsigned long size;		/* image + bss */
+	void (*exit)(void);
+	unsigned char *mem;
+};
+
+extern const char *linux_banner;
+static struct st20_module *modules;
+static DECLARE_MUTEX(module_sem);
+
+static unsigned long banner_hash(void)
+{
+	const unsigned char *p = (const unsigned char *) linux_banner;
+	unsigned long h = 0x811c9dc5;
+
+	while (*p)
+		h = (h ^ *p++) * 0x01000193;
+	return h;
+}
+
+/* encodes operand v for the instruction ending at p[n-1] in exactly n bytes */
+static int st20_reencode(unsigned char *p, int n, long v)
+{
+	unsigned char tmp[12];
+	int t = 0, fn = p[n - 1] >> 4;
+	long e = v;
+
+	for (;;) {
+		if (t == sizeof(tmp))
+			return -1;
+		tmp[t++] = fn << 4 | (e & 15);
+		if (e >= 0 && e < 16)
+			break;
+		if (e >= 16) {
+			e >>= 4;
+			fn = PFIX;
+		} else {
+			e = (~e) >> 4;
+			fn = NFIX;
+		}
+	}
+	if (t > n)
+		return -1;
+	while (n > t)
+		*p++ = PFIX << 4, n--;	/* leading pfix 0 */
+	while (t)
+		*p++ = tmp[--t];
+	return 0;
+}
+
+asmlinkage long st20_sys_init_module(const char *uimage, unsigned long len)
+{
+	struct st20_mod_header hdr;
+	struct st20_module *m, *x;
+	unsigned long *rel, delta, i;
+	unsigned char *mem;
+	long err;
+	int (*init)(void);
+
+	if (!capable(CAP_SYS_MODULE))
+		return -EPERM;
+	if (len < sizeof(hdr) || copy_from_user(&hdr, uimage, sizeof(hdr)))
+		return -EFAULT;
+	if (hdr.magic != ST20_MOD_MAGIC || hdr.version != 1)
+		return -ENOEXEC;
+	if (hdr.banner_hash != banner_hash()) {
+		printk(KERN_ERR "init_module: %.23s was linked against another kernel\n", hdr.name);
+		return -ENOEXEC;
+	}
+	if (hdr.size > len || hdr.n_abs > len / 4 || hdr.n_pcrel > len / 8 ||
+	    sizeof(hdr) + hdr.size + 4 * hdr.n_abs + 8 * hdr.n_pcrel != len ||
+	    hdr.init >= hdr.size || (hdr.exit != ~0UL && hdr.exit >= hdr.size))
+		return -ENOEXEC;
+	hdr.name[sizeof(hdr.name) - 1] = 0;
+
+	down(&module_sem);
+	err = -EEXIST;
+	for (x = modules; x; x = x->next)
+		if (!strcmp(x->name, hdr.name))
+			goto out;
+	err = -ENOMEM;
+	m = kmalloc(sizeof(*m), GFP_KERNEL);
+	mem = kmalloc(hdr.size + hdr.bss, GFP_KERNEL);
+	rel = kmalloc(4 * hdr.n_abs + 8 * hdr.n_pcrel + 4, GFP_KERNEL);
+	if (!m || !mem || !rel)
+		goto free;
+	err = -EFAULT;
+	if (copy_from_user(mem, uimage + sizeof(hdr), hdr.size) ||
+	    copy_from_user(rel, uimage + sizeof(hdr) + hdr.size, 4 * hdr.n_abs + 8 * hdr.n_pcrel))
+		goto free;
+	memset(mem + hdr.size, 0, hdr.bss);
+
+	/* relocate from hdr.base to mem */
+	err = -ENOEXEC;
+	delta = (unsigned long) mem - hdr.base;
+	for (i = 0; i < hdr.n_abs; i++) {
+		unsigned long o = rel[i];
+		if (o & 3 || o + 4 > hdr.size)
+			goto free;
+		*(unsigned long *) (mem + o) += delta;
+	}
+	for (i = 0; i < hdr.n_pcrel; i++) {
+		unsigned long w = rel[hdr.n_abs + 2 * i], o = w & 0x7fffff, n = w >> 24;
+		long v = (long) rel[hdr.n_abs + 2 * i + 1];
+		if (n == 0 || o + n > hdr.size)
+			goto free;
+		v = w & 0x800000 ? v + (long) delta : v - (long) delta;
+		if (st20_reencode(mem + o, n, v)) {
+			printk(KERN_ERR "init_module: %s: relocation at %lx does not fit\n", hdr.name, o);
+			goto free;
+		}
+	}
+	kfree(rel);
+	rel = NULL;
+	flush_icache_range((unsigned long) mem, (unsigned long) mem + hdr.size);
+
+	strcpy(m->name, hdr.name);
+	m->size = hdr.size + hdr.bss;
+	m->mem = mem;
+	m->exit = hdr.exit == ~0UL ? NULL : (void (*)(void)) (mem + hdr.exit);
+	init = (int (*)(void)) (mem + hdr.init);
+	printk(KERN_INFO "init_module: %s at %p (%lu bytes)\n", m->name, mem, m->size);
+	err = init();
+	if (err) {
+		printk(KERN_ERR "init_module: %s: init returned %ld\n", m->name, err);
+		if (err > 0)
+			err = -EINVAL;
+		goto free;
+	}
+	m->next = modules;
+	modules = m;
+	up(&module_sem);
+	return 0;
+free:
+	kfree(rel);
+	kfree(mem);
+	kfree(m);
+out:
+	up(&module_sem);
+	return err;
+}
+
+asmlinkage long st20_sys_delete_module(const char *uname)
+{
+	struct st20_module **pp, *m;
+	char name[24];
+	long err;
+
+	if (!capable(CAP_SYS_MODULE))
+		return -EPERM;
+	err = strncpy_from_user(name, uname, sizeof(name) - 1);
+	if (err < 0)
+		return err;
+	name[err] = 0;
+	down(&module_sem);
+	for (pp = &modules; (m = *pp); pp = &m->next)
+		if (!strcmp(m->name, name))
+			break;
+	err = -ENOENT;
+	if (m) {
+		err = -EBUSY;
+		if (m->exit) {
+			m->exit();
+			*pp = m->next;
+			printk(KERN_INFO "delete_module: %s\n", m->name);
+			kfree(m->mem);
+			kfree(m);
+			err = 0;
+		}
+	}
+	up(&module_sem);
+	return err;
+}
+
+static int modules_read_proc(char *page, char **start, off_t off, int count, int *eof,
+			     void *data)
+{
+	struct st20_module *m;
+	int len = 0;
+
+	down(&module_sem);
+	for (m = modules; m && len < PAGE_SIZE - 80; m = m->next)
+		len += sprintf(page + len, "%-20s %8lu  %p\n", m->name, m->size, m->mem);
+	up(&module_sem);
+	*eof = 1;
+	return len;
+}
+
+extern void *const st20_module_ksyms[];
+
+static int __init st20_modules_init(void)
+{
+	if (!st20_module_ksyms[0])	/* keeps ksyms.c's functions in the kernel */
+		return -ENOSYS;
+	create_proc_read_entry("modules", 0, NULL, modules_read_proc, NULL);
+	return 0;
+}
+
+__initcall(st20_modules_init);
diff --git a/linux-2.4.x/arch/st20/kernel/osd.c b/linux-2.4.x/arch/st20/kernel/osd.c
new file mode 100644
index 000000000..2b8472be9
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/osd.c
@@ -0,0 +1,370 @@
+/*
+ * arch/st20/kernel/osd.c - text console on the TV: STi5512 OSD, 80x30 characters of 8x16
+ *
+ * Mirrors what is written to the console (printk and /dev/ttyS0) onto the TV picture; the
+ * IR remote keyboard and the front panel give input, so the box can be used without a
+ * serial cable.  A small VT100 subset: cursor movement (ESC [ n A/B/C/D, ESC [ r;c H),
+ * ESC [ J / 2J, ESC [ K; colours (ESC [ ... m) are accepted and ignored.
+ *
+ * OSD (STi5512 datasheet section 21.5; block format as st20emu renders it, which the
+ * DSR9500 application's menus validate): each field (top/bottom) has its own list of
+ * blocks in SDRAM, from OSD_TOP/OSD_BOT (video registers 0x2a/0x2b, written high byte
+ * first, in units of 256 bytes from 0xc0000000).  A block is an 8-byte big-endian header
+ * (mode, first/last field line, mix weight, left/right pixel, link), a palette and the
+ * pixels.  Here: one 2-bit-per-pixel 640x240 block per field (the even and the odd pixel
+ * lines of the 640x480 window), then a terminating block with first line 0x1ff (as the
+ * DSR9500 loader's osd_init ends its list).
+ *
+ * Bring-up on the real board follows the DSR9500 loader (Decompilation/DSR9500 src/osd.c:
+ * av_init = dev_init + dev_regs, then OSD_CFG.ENA).
+ */
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/bootmem.h>
+#include <linux/string.h>
+#include <asm/system.h>
+#include <asm/font8x16.h>
+
+#define VID(a)		(*(volatile unsigned char *) (a))	/* video registers at 0 */
+#define DENC(a)		VID(0x1800 + (a))
+#define OSD_TOP		0x2a
+#define OSD_BOT		0x2b
+#define OSD_CFG		0x91
+#define OSD_CFG_ENA	0x04
+#define SDRAM		0xc0000000UL
+
+#define COLS		80
+#define ROWS		30
+#define WIDTH		(COLS * 8)		/* 640 */
+#define FIELD_LINES	(ROWS * 8)		/* 240 lines per field */
+#define PITCH		(WIDTH / 4)		/* 2 bpp: 160 bytes per line */
+#define TOP_LINE	48			/* first field line */
+#define LEFT		158			/* centred in the 720-pixel picture */
+#define BITMAP		(PITCH * FIELD_LINES)	/* 38400 */
+#define TERM_OFF	(((16 + BITMAP) + 127) & ~127)	/* terminator, 128-aligned */
+#define FIELD_SIZE	(((TERM_OFF + 8) + 255) & ~255)
+
+/* the two field buffers (77 KB) come from the boot allocator (setup.c), keeping them out of
+   the kernel image (crossload writes bss into the image) */
+static unsigned char *osd_mem;
+
+void __init st20_osd_alloc(void)
+{
+	osd_mem = alloc_bootmem(2 * FIELD_SIZE + 256);
+}
+static unsigned char *field_list[2];		/* header of each field's block */
+static unsigned char *bitmap[2];
+static int osd_ready;
+static int cx, cy;				/* cursor */
+static int esc_state, esc_args[4], esc_nargs;
+
+/* 2 bpp expansion of a font nibble: set pixel = colour 3, clear = colour 0 */
+static const unsigned char expand[16] = {
+	0x00, 0x03, 0x0c, 0x0f, 0x30, 0x33, 0x3c, 0x3f,
+	0xc0, 0xc3, 0xcc, 0xcf, 0xf0, 0xf3, 0xfc, 0xff,
+};
+
+static void put_be32(unsigned char *p, unsigned long v)
+{
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+/* block header: mode 0 (2 bpp), lines top..bottom, pixels left..right, link to SDRAM byte
+   offset link (0 = none; a multiple of 128) */
+static void put_header(unsigned char *h, int top, int bottom, int left, int right,
+		       unsigned long link)
+{
+	unsigned long n = link / 8;
+	unsigned long hi = ((unsigned long) top << 16) | (((n >> 4) & 7) << 9) | bottom;
+	unsigned long lo = (((n >> 7) & 0x3f) << 26) | ((unsigned long) left << 16) |
+			   (((n >> 13) & 0x3f) << 10) | right;
+
+	put_be32(h, hi);
+	put_be32(h + 4, lo);
+}
+
+/* palette entry: 6-bit luma, 4-bit Cb/Cr, opaque */
+static void put_colour(unsigned char *p, int y6, int cb, int cr)
+{
+	p[0] = y6 << 2;
+	p[1] = (cb << 4) | cr;
+}
+
+static void spin(int n)
+{
+	volatile int i;
+
+	for (i = 0; i < n * 50; i++)
+		;
+}
+
+static void wr16(unsigned long a, unsigned int v)
+{
+	VID(a) = v >> 8;
+	VID(a + 1) = v;
+}
+
+/* the DSR9500 loader's AV decoder / display / DENC set-up (dev_init, dev_reset, dev_regs) */
+static void av_init(void)
+{
+	unsigned char ctrl = 0xc1;
+
+	VID(0x5001) = 0x10;
+	(void) VID(0x3d);
+	VID(0x3c) = 0;
+	wr16(0x60, 0);
+	VID(3) = 0;
+	wr16(0x14, 0);
+	wr16(0x18, 0xfff);
+	wr16(0x1a, 0xfff);
+	VID(0x54) = 7;
+	VID(0x55) = 0xc;
+	VID(0x28) = 0x2d;
+	wr16(0x74, ((VID(0x74) << 8) | VID(0x75)) | 0x800);
+	VID(OSD_CFG) = 0;
+	wr16(0x70, 0x70);
+	wr16(0x72, 0x340);
+	wr16(0x6e, 0x16);
+	wr16(0x46, 0x136);
+	VID(2) = ctrl;
+	/* dev_reset */
+	VID(3) = 4;
+	VID(0x39) = 1;
+	spin(1);
+	VID(0x39) = 0;
+	VID(2) = ctrl | 4;
+	spin(1);
+	VID(2) = ctrl;
+	(void) VID(0x3b);
+	VID(0x40) = 0;
+	VID(0x41) = 0;
+	/* dev_regs: DENC configuration */
+	DENC(0) = 0x30;
+	DENC(1) = 0x60;
+	DENC(2) = 0x22;
+	DENC(3) = 0x42;
+	DENC(4) = 0x10;
+	DENC(5) = 0x61;
+	DENC(7) = 0;
+	DENC(8) = 0x20;
+	DENC(6) = 0x80;
+}
+
+static unsigned char *line(int field, int l)
+{
+	return bitmap[field] + l * PITCH;
+}
+
+static void draw_char(int col, int row, int c)
+{
+	const unsigned char *g = st20_font8x16 + (c & 0xff) * 16;
+	int y;
+
+	for (y = 0; y < 16; y++) {
+		unsigned char *p = line(y & 1, row * 8 + (y >> 1)) + col * 2;
+
+		p[0] = expand[g[y] >> 4];
+		p[1] = expand[g[y] & 15];
+	}
+}
+
+static void invert_cell(int col, int row)
+{
+	int y;
+
+	for (y = 0; y < 16; y++) {
+		unsigned char *p = line(y & 1, row * 8 + (y >> 1)) + col * 2;
+
+		p[0] ^= 0xff;
+		p[1] ^= 0xff;
+	}
+}
+
+static void clear_lines(int row0, int rows)
+{
+	int f;
+
+	for (f = 0; f < 2; f++)
+		memset(line(f, row0 * 8), 0, rows * 8 * PITCH);
+}
+
+static void clear_eol(int col, int row)
+{
+	int f, l;
+
+	for (f = 0; f < 2; f++)
+		for (l = 0; l < 8; l++)
+			memset(line(f, row * 8 + l) + col * 2, 0, (COLS - col) * 2);
+}
+
+static void scroll(void)
+{
+	int f;
+
+	for (f = 0; f < 2; f++)
+		memmove(line(f, 0), line(f, 8), (FIELD_LINES - 8) * PITCH);
+	clear_lines(ROWS - 1, 1);
+}
+
+static void newline(void)
+{
+	cx = 0;
+	if (++cy >= ROWS) {
+		scroll();
+		cy = ROWS - 1;
+	}
+}
+
+static int arg(int i, int def)
+{
+	return i < esc_nargs && esc_args[i] ? esc_args[i] : def;
+}
+
+static void csi(int c)
+{
+	switch (c) {
+	case 'A': cy -= arg(0, 1); break;
+	case 'B': cy += arg(0, 1); break;
+	case 'C': cx += arg(0, 1); break;
+	case 'D': cx -= arg(0, 1); break;
+	case 'H': case 'f': cy = arg(0, 1) - 1; cx = arg(1, 1) - 1; break;
+	case 'J':
+		if (arg(0, 0) == 2) {
+			clear_lines(0, ROWS);
+			cx = cy = 0;
+		} else {
+			clear_eol(cx, cy);
+			if (cy + 1 < ROWS)
+				clear_lines(cy + 1, ROWS - cy - 1);
+		}
+		break;
+	case 'K': clear_eol(cx, cy); break;
+	default: break;			/* m (colours) and others: ignored */
+	}
+	if (cx < 0) cx = 0;
+	if (cx >= COLS) cx = COLS - 1;
+	if (cy < 0) cy = 0;
+	if (cy >= ROWS) cy = ROWS - 1;
+}
+
+static void put(int c)
+{
+	if (esc_state == 1) {
+		if (c == '[') {
+			esc_state = 2;
+			esc_nargs = 0;
+			esc_args[0] = 0;
+			return;
+		}
+		esc_state = 0;
+		return;
+	}
+	if (esc_state == 2) {
+		if (c >= '0' && c <= '9') {
+			if (!esc_nargs)
+				esc_nargs = 1;
+			esc_args[esc_nargs - 1] = esc_args[esc_nargs - 1] * 10 + c - '0';
+			return;
+		}
+		if (c == ';') {
+			if (esc_nargs < 4)
+				esc_args[esc_nargs++] = 0;
+			if (esc_nargs == 1)
+				esc_args[esc_nargs++] = 0;
+			return;
+		}
+		esc_state = 0;
+		csi(c);
+		return;
+	}
+	switch (c) {
+	case 033: esc_state = 1; return;
+	case '\r': cx = 0; return;
+	case '\n': newline(); return;
+	case '\b': if (cx > 0) cx--; return;
+	case '\t': do put(' '); while (cx & 7); return;
+	case 7: return;
+	}
+	if (c < 0x20)
+		return;
+	if (cx >= COLS)
+		newline();
+	draw_char(cx, cy, c);
+	cx++;
+}
+
+void st20_osd_write(const char *s, int n)
+{
+	unsigned long flags;
+	int cur;
+
+	if (!osd_ready)
+		return;
+	save_flags(flags);
+	cli();
+	cur = cx < COLS;
+	if (cur)
+		invert_cell(cx, cy);		/* remove the cursor */
+	while (n-- > 0)
+		put((unsigned char) *s++);
+	if (cx < COLS)
+		invert_cell(cx, cy);		/* draw it */
+	restore_flags(flags);
+}
+
+static void set_list(int reg, unsigned char *list)
+{
+	unsigned long off = (unsigned long) list - SDRAM;
+
+	VID(reg) = (off >> 8) >> 8;		/* high byte first */
+	VID(reg) = off >> 8;
+}
+
+/* show other OSD lists (the frame buffer, drivers/video/st20fb.c), or the text console's
+   again with 0; the console keeps drawing into its own blocks meanwhile */
+void st20_osd_select(unsigned char *top, unsigned char *bottom)
+{
+	if (!top) {
+		if (!osd_ready)
+			return;
+		top = field_list[0];
+		bottom = field_list[1];
+	}
+	set_list(OSD_TOP, top);
+	set_list(OSD_BOT, bottom);
+	VID(OSD_CFG) |= OSD_CFG_ENA;
+}
+
+void st20_osd_init(void)
+{
+	unsigned long base = ((unsigned long) osd_mem + 255) & ~255UL;
+	int f;
+
+	if (!osd_mem)
+		return;
+	av_init();
+	for (f = 0; f < 2; f++) {
+		unsigned char *list = (unsigned char *) base + f * FIELD_SIZE;
+		unsigned long off = (unsigned long) list - SDRAM;
+
+		field_list[f] = list;
+		bitmap[f] = list + 16;
+		put_header(list, TOP_LINE, TOP_LINE + FIELD_LINES - 1, LEFT, LEFT + WIDTH - 1,
+			   off + TERM_OFF);
+		put_colour(list + 8, 4, 8, 8);		/* 0: black */
+		put_colour(list + 10, 0x10, 8, 8);	/* 1: grey */
+		put_colour(list + 12, 0x22, 3, 10);	/* 2: colour of the loader's screens */
+		put_colour(list + 14, 0x3a, 8, 8);	/* 3: white */
+		memset(bitmap[f], 0, BITMAP);
+		put_header(list + TERM_OFF, 0x1ff, 0x1ff, 0, 0, off + TERM_OFF);
+		set_list(f ? OSD_BOT : OSD_TOP, list);
+	}
+	VID(OSD_CFG) |= OSD_CFG_ENA;
+	cx = cy = 0;
+	osd_ready = 1;
+	st20_osd_write("uClinux/ST20 on the Samsung DSR9500 - TV console\r\n", 51);
+	printk("TV console: OSD %dx%d text, 8x16 font\n", COLS, ROWS);
+}
diff --git a/linux-2.4.x/arch/st20/kernel/panel.c b/linux-2.4.x/arch/st20/kernel/panel.c
new file mode 100644
index 000000000..0b558668a
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/panel.c
@@ -0,0 +1,220 @@
+/*
+ * arch/st20/kernel/panel.c - DSR9500 front panel: 4-digit LED display and keys
+ *
+ * Hardware (Decompilation/DSR9500 src/a_7fe8f738.c, st20emu src/board/DSR9500.cpp): a
+ * 16-bit shift register, data PIO4 bit 3, clock PIO4 bit 4, shifted MSB first and latched
+ * by pulsing PIO1 bit 7.  Bits 12-15 select a digit, bits 0-7 are its active-low segments.
+ * The same outputs drive the key matrix columns: with one column bit low and no digit
+ * selected, a pressed key pulls the return line PIO4 bit 2 low.  Keys: 0x04 up, 0x08 down,
+ * 0x80 power.
+ *
+ * The display is multiplexed by the high-priority tick (1 kHz: one digit per tick, through
+ * st20_tick_hook in time.c), which also scans the keys every 10 ms and queues changes;
+ * st20_panel_lp (low priority, st20_tick_lp_hook) types them into the console: up/down =
+ * cursor up/down, power = Enter, and reports presses and releases to the input layer
+ * (keys.c, /dev/input/event0) with CONFIG_INPUT.
+ * /dev/panel (char major 60): write up to four characters to show them, read them back.
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/proc_fs.h>
+#include <linux/major.h>
+#include <asm/system.h>
+#include <asm/uaccess.h>
+#include <asm/st20asc.h>
+
+#define PANEL_DATA	0x08	/* PIO4 */
+#define PANEL_CLOCK	0x10	/* PIO4 */
+#define PANEL_RETURN	0x04	/* PIO4, input */
+#define PANEL_LATCH	0x80	/* PIO1 */
+#define PANEL_MAJOR	60	/* char device /dev/panel (local/experimental major) */
+
+/* ASCII 0x20-0x5f -> segments (active low), the DSR9500 firmware's table */
+static const unsigned char segments[64] = {
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xbf, 0x7f, 0xff,
+	0xc0, 0xf9, 0xa4, 0xb0, 0x99, 0x92, 0x82, 0xf8, 0x80, 0x90, 0xff, 0xff, 0xff, 0xb7, 0xff, 0xff,
+	0xff, 0x88, 0x83, 0xc6, 0xa1, 0x86, 0x8e, 0xc2, 0x89, 0xf9, 0xe1, 0x8a, 0xc7, 0xc8, 0xab, 0xc0,
+	0x8c, 0x98, 0xaf, 0x92, 0x87, 0xc1, 0xe3, 0x81, 0x89, 0x91, 0xa4, 0xc6, 0xff, 0xf0, 0xff, 0xf7,
+};
+
+static volatile unsigned char panel_seg[4] = { 0xff, 0xff, 0xff, 0xff };
+static char panel_text[5] = "    ";
+static int digit, scan_div;
+static unsigned char keys_now, keys_seen;	/* HP: debounced state */
+static volatile unsigned short key_events[16];	/* HP -> LP: pressed | released << 8 */
+static volatile unsigned int ev_head, ev_tail;
+static int panel_ready;
+
+static void shift_out(unsigned int v)
+{
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		if (v & 0x8000)
+			PIO4(PIO_SET_OUT) = PANEL_DATA;
+		else
+			PIO4(PIO_CLR_OUT) = PANEL_DATA;
+		PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+		PIO4(PIO_CLR_OUT) = PANEL_CLOCK;
+		PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+		v <<= 1;
+	}
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+	PIO1(PIO_CLR_OUT) = PANEL_LATCH;
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+}
+
+static unsigned char scan_keys(void)
+{
+	static const unsigned char columns[3] = { 0x04, 0x08, 0x80 };
+	unsigned char pressed = 0;
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		shift_out((~columns[i]) & 0xff);		/* no digit selected */
+		if (!(PIO4(PIO_IN) & PANEL_RETURN))
+			pressed |= columns[i];
+	}
+	return pressed;
+}
+
+/* high priority, every 1 ms from the tick; returns 1 if a key event was queued */
+int st20_panel_hp(void)
+{
+	int event = 0;
+
+	if (!panel_ready)
+		return 0;
+	if (++scan_div >= 10) {
+		unsigned char k;
+
+		scan_div = 0;
+		k = scan_keys();
+		if (k == keys_now && k != keys_seen) {	/* stable for two scans */
+			unsigned char down = k & ~keys_seen, up = keys_seen & ~k;
+			unsigned int next = (ev_head + 1) % 16;
+
+			keys_seen = k;
+			if (next != ev_tail) {
+				key_events[ev_head] = down | up << 8;
+				ev_head = next;
+				event = 1;
+			}
+		}
+		keys_now = k;
+	}
+	digit = (digit + 1) & 3;
+	shift_out((0x1000 << digit) | panel_seg[digit]);
+	return event;
+}
+
+/* low priority (time.c): panel keys -> console */
+void st20_panel_lp(void)
+{
+	while (ev_tail != ev_head) {
+		unsigned int ev = key_events[ev_tail], k = ev & 0xff;
+
+		ev_tail = (ev_tail + 1) % 16;
+#ifdef CONFIG_INPUT
+		{
+			extern void st20_keys_panel(unsigned int down, unsigned int up);
+
+			st20_keys_panel(k, ev >> 8);
+		}
+#endif
+		if (k & 0x04)
+			st20_tty_input("\033[A", 3);
+		if (k & 0x08)
+			st20_tty_input("\033[B", 3);
+		if (k & 0x80)
+			st20_tty_input("\r", 1);
+	}
+}
+
+void st20_panel_set(const char *s, int n)
+{
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		int c = i < n ? s[i] : ' ';
+
+		if (c >= 'a' && c <= 'z')
+			c -= 'a' - 'A';
+		if (c < 0x20 || c > 0x5f)
+			c = ' ';
+		panel_text[i] = c;
+		panel_seg[i] = segments[c - 0x20];
+	}
+}
+
+static ssize_t panel_write(struct file *file, const char *buf, size_t count, loff_t *ppos)
+{
+	char tmp[4];
+	int i, n = 0;
+
+	for (i = 0; i < count && n < 4; i++) {
+		char c;
+
+		if (get_user(c, buf + i))
+			return -EFAULT;
+		if (c == '\n')
+			break;
+		tmp[n++] = c;
+	}
+	if (count)		/* uC-libc's stdio also writes 0 bytes at fflush */
+		st20_panel_set(tmp, n);
+	return count;
+}
+
+static ssize_t panel_read(struct file *file, char *buf, size_t count, loff_t *ppos)
+{
+	char tmp[6];
+	int n;
+
+	if (*ppos)
+		return 0;
+	memcpy(tmp, panel_text, 4);
+	tmp[4] = '\n';
+	n = count < 5 ? count : 5;
+	if (copy_to_user(buf, tmp, n))
+		return -EFAULT;
+	*ppos += n;
+	return n;
+}
+
+static struct file_operations panel_fops = {
+	read:	panel_read,
+	write:	panel_write,
+};
+
+extern int (*st20_tick_hook)(void);
+extern void (*st20_tick_lp_hook)(void);
+
+void __init st20_panel_init(void)
+{
+	/* PIO1 bit 7 and PIO4 bits 3, 4: outputs; PIO4 bit 2: input (as the firmware) */
+	PIO1(PIO_CLR_PC0) = PANEL_LATCH;
+	PIO1(PIO_SET_PC1) = PANEL_LATCH;
+	PIO1(PIO_CLR_PC2) = PANEL_LATCH;
+	PIO4(PIO_CLR_PC0) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_SET_PC1) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_CLR_PC2) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_SET_PC0) = PANEL_RETURN;
+	PIO4(PIO_CLR_PC1) = PANEL_RETURN;
+	PIO4(PIO_SET_PC2) = PANEL_RETURN;
+	PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+	st20_panel_set("boot", 4);
+	if (register_chrdev(PANEL_MAJOR, "panel", &panel_fops))
+		printk("panel: cannot register major %d\n", PANEL_MAJOR);
+	panel_ready = 1;
+	st20_tick_hook = st20_panel_hp;
+	st20_tick_lp_hook = st20_panel_lp;
+	printk("Front panel: 4-digit display (/dev/panel, major %d), keys up/down/power\n",
+	       PANEL_MAJOR);
+}
diff --git a/linux-2.4.x/arch/st20/kernel/process.c b/linux-2.4.x/arch/st20/kernel/process.c
new file mode 100644
index 000000000..4b56bfee4
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/process.c
@@ -0,0 +1,285 @@
+/*
+ * arch/st20/kernel/process.c - task creation, exec, idle for uClinux/ST20
+ *
+ * A task switched out by st20_resume() has thread.ksp = its Wptr, whose word 0 is the
+ * Iptr to continue at.  New tasks get a hand-made frame there (copy_thread,
+ * arch_kernel_thread).  Task structs and kernel stacks are the usual 8 KB task_union;
+ * current is a global (_current_task) switched by switch_to (asm/system.h).
+ */
+#include <linux/config.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/smp.h>
+#include <linux/smp_lock.h>
+#include <linux/stddef.h>
+#include <linux/unistd.h>
+#include <linux/ptrace.h>
+#include <linux/slab.h>
+#include <linux/user.h>
+#include <linux/a.out.h>
+#include <linux/reboot.h>
+
+
+#include <asm/uaccess.h>
+#include <asm/system.h>
+#include <asm/pgtable.h>
+
+static struct fs_struct init_fs = INIT_FS;
+static struct files_struct init_files = INIT_FILES;
+static struct signal_struct init_signals = INIT_SIGNALS;
+struct mm_struct init_mm = INIT_MM(init_mm);
+
+/* no alignment needed: current is a global, not derived from the stack pointer */
+union task_union init_task_union = { task: INIT_TASK(init_task_union.task) };
+
+struct task_struct *_current_task = &init_task_union.task;
+struct task_struct *st20_last_task;
+/* top of the current task's kernel stack, used by st20_syscall (entry.ast) */
+unsigned long st20_kstack;
+
+extern void st20_ret_from_fork(void);
+extern void st20_kthread_start(void);
+extern void st20_return_to_user(unsigned long *uw, long result);
+extern void st20_icache_invalidate(void);
+extern asmlinkage void schedule_tail(struct task_struct *prev);
+extern asmlinkage long sys_exit(int error_code);
+
+void cpu_idle(void)
+{
+	/* endless idle loop with no priority at all */
+	init_idle();
+	current->nice = 20;
+	current->counter = -100;
+	for (;;) {
+		if (current->need_resched)
+			schedule();
+	}
+}
+
+void machine_restart(char * __unused)
+{
+	st20_reboot();
+}
+
+void machine_halt(void)
+{
+	st20_reboot();
+}
+
+void machine_power_off(void)
+{
+	st20_reboot();
+}
+
+void show_regs(struct pt_regs * regs)
+{
+	printk("\nIptr: %08lx Wptr: %08lx status: %08lx nr: %ld\n",
+	       regs->iptr, regs->wptr, regs->status, regs->orig_nr);
+}
+
+/* the vfork child's stack copy is not needed after exec or exit */
+static void free_vfork_stack(void)
+{
+	if (current->thread.vfork_stack) {
+		kfree((void *) current->thread.vfork_stack);
+		current->thread.vfork_stack = 0;
+		current->thread.vfork_stack_end = 0;
+	}
+}
+
+void exit_thread(void)
+{
+	free_vfork_stack();
+}
+
+void flush_thread(void)
+{
+	free_vfork_stack();
+	set_fs(USER_DS);
+}
+
+void release_thread(struct task_struct *dead_task)
+{
+}
+
+/*
+ * vfork: the child gets a copy of the parent's user stack from the calling frame up to
+ * the end of the environment strings, with VFORK_HEADROOM below for its own calls.
+ * gcc-t800 shares workspace slots between locals that are dead on the child's path, so a
+ * child running in the parent's frames corrupts them; on the copy it cannot.  Pointers
+ * into the parent's stack still reach the parent's (unchanged) data, which is what
+ * vfork-then-exec code expects.
+ */
+#define VFORK_HEADROOM	8192
+#define VFORK_MAX	(64 * 1024)
+
+static void copy_vfork_stack(struct task_struct *p, struct pt_regs *childregs)
+{
+	unsigned long uw = childregs->wptr, top = current->mm ? current->mm->env_end : 0;
+	char *buf;
+
+	/* a vfork child still on its stack copy that vforks again (busybox init's sysinit
+	   child forks the command): copy that copy, up to its end; with env_end as the top
+	   it was too far away (> VFORK_MAX) and the grandchild shared the stack */
+	if (current->thread.vfork_stack && uw >= current->thread.vfork_stack &&
+	    uw < current->thread.vfork_stack_end)
+		top = current->thread.vfork_stack_end;
+
+	if (!(childregs->status & PS_USER) || top <= uw || top - uw > VFORK_MAX)
+		return;
+	buf = kmalloc(VFORK_HEADROOM + (top - uw), GFP_KERNEL);
+	if (!buf)
+		return;		/* fall back to sharing the stack */
+	memcpy(buf + VFORK_HEADROOM, (void *) uw, top - uw);
+	childregs->wptr = (unsigned long) buf + VFORK_HEADROOM;
+	p->thread.vfork_stack = (unsigned long) buf;
+	p->thread.vfork_stack_end = (unsigned long) buf + VFORK_HEADROOM + (top - uw);
+}
+
+/* builds the frame st20_resume returns through: w[0] = Iptr, w[5].. = words 1.. after ret */
+static unsigned long *new_frame(struct task_struct *p, void (*entry)(void))
+{
+	unsigned long *w = (unsigned long *) ((unsigned long) p + THREAD_SIZE - 64);
+
+	w[0] = (unsigned long) entry;
+	p->thread.ksp = (unsigned long) w;
+	return w;
+}
+
+int copy_thread(int nr, unsigned long clone_flags, unsigned long usp,
+		unsigned long topstk, struct task_struct * p, struct pt_regs * regs)
+{
+	struct pt_regs * childregs;
+	unsigned long *w;
+
+	childregs = (struct pt_regs *) ((unsigned long) p + THREAD_SIZE - 64 - 16
+					- sizeof(struct pt_regs));
+	*childregs = *regs;
+	childregs->result = 0;
+	if (usp && usp != regs->wptr)
+		childregs->wptr = usp;
+	p->thread.vfork_stack = 0;
+	p->thread.vfork_stack_end = 0;
+	p->thread.resume_valid = 0;
+	p->thread.saved_mask_valid = 0;
+	if (clone_flags & CLONE_VFORK)
+		copy_vfork_stack(p, childregs);
+	w = new_frame(p, st20_ret_from_fork);
+	w[5] = (unsigned long) childregs;
+	p->thread.usp = childregs->wptr;
+	p->thread.regs = childregs;
+	return 0;
+}
+
+/* binfmt_flat: the new program starts with Wptr = usp at pc (via thread.resume) */
+void st20_start_thread(struct pt_regs *regs, unsigned long pc, unsigned long usp)
+{
+	set_fs(USER_DS);
+	regs->iptr = pc;
+	regs->wptr = usp;
+	regs->status |= PS_USER;
+	current->thread.resume[0] = usp;
+	current->thread.resume[1] = pc;
+	current->thread.resume[2] = current->thread.resume[3] = current->thread.resume[4] = 0;
+	current->thread.resume_valid = 1;
+	st20_icache_invalidate();
+}
+
+/* child side of fork/clone (from entry.ast): continue the user code with result 0 */
+void st20_ret_from_fork_c(struct pt_regs *regs)
+{
+	schedule_tail(st20_last_task);
+	sti();
+	((unsigned long *) regs->wptr)[0] = regs->iptr;
+	st20_return_to_user((unsigned long *) regs->wptr, 0);
+}
+
+/* kernel_thread child (from entry.ast) */
+void st20_kthread_c(int (*fn)(void *), void *arg)
+{
+	schedule_tail(st20_last_task);
+	sti();
+	sys_exit(fn(arg));
+}
+
+int arch_kernel_thread(int (*fn)(void *), void * arg, unsigned long flags)
+{
+	struct pt_regs regs;
+	struct task_struct *p;
+	int pid;
+
+	memset(&regs, 0, sizeof(regs));
+	regs.orig_nr = -1;
+	/* the child must not run before its frame is set up below */
+	pid = do_fork(flags | CLONE_VM, 0, &regs, 0);
+	if (pid > 0) {
+		read_lock(&tasklist_lock);
+		p = find_task_by_pid(pid);
+		if (p) {
+			unsigned long *w = new_frame(p, st20_kthread_start);
+			w[5] = (unsigned long) fn;
+			w[6] = (unsigned long) arg;
+		}
+		read_unlock(&tasklist_lock);
+	}
+	return pid;
+}
+
+/* fill in the user structure for a core dump */
+void dump_thread(struct pt_regs * regs, struct user * dump)
+{
+	memset(dump, 0, sizeof(*dump));
+	dump->magic = CMAGIC;
+	dump->start_code = 0;
+	dump->start_stack = regs->wptr & ~(PAGE_SIZE - 1);
+	dump->u_tsize = ((unsigned long) current->mm->end_code) >> PAGE_SHIFT;
+	dump->u_dsize = ((unsigned long) (current->mm->brk + (PAGE_SIZE-1))) >> PAGE_SHIFT;
+	dump->u_dsize -= dump->u_tsize;
+	dump->u_ssize = 0;
+	dump->regs.wptr = regs->wptr;
+	dump->regs.iptr = regs->iptr;
+	dump->regs.status = regs->status;
+}
+
+/* system calls taking pt_regs: the dispatcher sets current->thread.regs */
+asmlinkage int sys_fork(void)
+{
+	/* no MMU: fork() is vfork(), the parent sleeps until the child's exec or exit */
+	return do_fork(CLONE_VFORK | CLONE_VM | SIGCHLD, 0, current->thread.regs, 0);
+}
+
+asmlinkage int sys_vfork(void)
+{
+	return do_fork(CLONE_VFORK | CLONE_VM | SIGCHLD, 0, current->thread.regs, 0);
+}
+
+asmlinkage int sys_clone(unsigned long clone_flags, unsigned long newsp)
+{
+	return do_fork(clone_flags, newsp, current->thread.regs, 0);
+}
+
+asmlinkage int sys_execve(char *name, char **argv, char **envp)
+{
+	int error;
+	char * filename;
+
+	lock_kernel();
+	filename = getname(name);
+	error = PTR_ERR(filename);
+	if (IS_ERR(filename))
+		goto out;
+	error = do_execve(filename, argv, envp, current->thread.regs);
+	putname(filename);
+out:
+	unlock_kernel();
+	return error;
+}
+
+unsigned long get_wchan(struct task_struct *p)
+{
+	if (!p || p == current || p->state == TASK_RUNNING)
+		return 0;
+	return thread_saved_pc(&p->thread);
+}
diff --git a/linux-2.4.x/arch/st20/kernel/ptrace.c b/linux-2.4.x/arch/st20/kernel/ptrace.c
new file mode 100644
index 000000000..711cb1c8d
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/ptrace.c
@@ -0,0 +1,186 @@
+/*
+ * arch/st20/kernel/ptrace.c - ptrace for uClinux/ST20
+ *
+ * Without an MMU a tracee's text and data are plain SDRAM: PEEK/POKE TEXT/DATA read and
+ * write the word at addr directly (any SDRAM address; flash for reading), POKETEXT also
+ * invalidates the instruction cache.  The user area (PEEKUSER/POKEUSER, GETREGS/SETREGS)
+ * is struct pt_regs (include/asm-st20/ptrace.h: orig_nr, arg[6], result, wptr, iptr,
+ * status, areg-creg; then start_code, start_data, end_data at PT_TEXT..PT_BSS).  A stopped
+ * tracee's thread.regs is the pt_regs of its system call stop (PTRACE_SYSCALL, syscalls.c)
+ * or of its signal stop (signal.c), so changes reach the tracee when it continues.
+ *
+ * PTRACE_SINGLESTEP is not supported (-EIO): the ST20-C2 has no trace flag (single step is
+ * only available through the diagnostic controller), and the only software breakpoint,
+ * `j 0` with the breakpoint trap enabled, is a jump: it discards Areg-Creg, which are live
+ * across most instruction boundaries of gcc-t800 code, so a breakpoint planted after an
+ * arbitrary instruction would corrupt the program.
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/smp_lock.h>
+#include <linux/errno.h>
+#include <linux/ptrace.h>
+#include <linux/user.h>
+#include <linux/string.h>
+#include <asm/uaccess.h>
+#include <asm/pgalloc.h>
+
+/* nothing to undo on detach (no single step) */
+void ptrace_disable(struct task_struct *child)
+{
+	child->ptrace &= ~PT_TRACESYS;
+}
+
+static int get_user_word(struct task_struct *child, long addr, unsigned long *val)
+{
+	struct pt_regs *regs = child->thread.regs;
+
+	if ((addr & 3) || addr < 0 || addr >= PT_USER_WORDS * 4)
+		return -EIO;
+	addr >>= 2;
+	if (addr < PT_WORDS) {
+		*val = regs ? ((unsigned long *) regs)[addr] : 0;
+		return 0;
+	}
+	if (!child->mm)
+		return -EIO;
+	switch (addr) {
+	case PT_TEXT:	*val = child->mm->start_code; break;
+	case PT_DATA:	*val = child->mm->start_data; break;
+	case PT_BSS:	*val = child->mm->end_data; break;
+	}
+	return 0;
+}
+
+static int put_user_word(struct task_struct *child, long addr, unsigned long val)
+{
+	struct pt_regs *regs = child->thread.regs;
+
+	if ((addr & 3) || addr < 0 || addr >= PT_WORDS * 4 || addr == PT_STATUS * 4 || !regs)
+		return -EIO;
+	((unsigned long *) regs)[addr >> 2] = val;
+	return 0;
+}
+
+asmlinkage int sys_ptrace(long request, long pid, long addr, long data)
+{
+	struct task_struct *child;
+	unsigned long tmp;
+	int ret, i;
+
+	lock_kernel();
+	ret = -EPERM;
+	if (request == PTRACE_TRACEME) {
+		if (current->ptrace & PT_PTRACED)
+			goto out;
+		current->ptrace |= PT_PTRACED;
+		ret = 0;
+		goto out;
+	}
+	ret = -ESRCH;
+	read_lock(&tasklist_lock);
+	child = find_task_by_pid(pid);
+	if (child)
+		get_task_struct(child);
+	read_unlock(&tasklist_lock);
+	if (!child)
+		goto out;
+
+	ret = -EPERM;
+	if (pid == 1)		/* you may not mess with init */
+		goto out_tsk;
+
+	if (request == PTRACE_ATTACH) {
+		ret = ptrace_attach(child);
+		goto out_tsk;
+	}
+	ret = ptrace_check_attach(child, request == PTRACE_KILL);
+	if (ret < 0)
+		goto out_tsk;
+
+	switch (request) {
+	case PTRACE_PEEKTEXT:
+	case PTRACE_PEEKDATA:
+		ret = -EIO;
+		if (!access_ok(VERIFY_READ, (void *) addr, sizeof(tmp)))
+			break;
+		memcpy(&tmp, (void *) addr, sizeof(tmp));
+		ret = put_user(tmp, (unsigned long *) data);
+		break;
+
+	case PTRACE_PEEKUSR:
+		ret = get_user_word(child, addr, &tmp);
+		if (!ret)
+			ret = put_user(tmp, (unsigned long *) data);
+		break;
+
+	case PTRACE_POKETEXT:
+	case PTRACE_POKEDATA:
+		ret = -EIO;
+		if (!access_ok(VERIFY_WRITE, (void *) addr, sizeof(data)))
+			break;
+		memcpy((void *) addr, &data, sizeof(data));
+		if (request == PTRACE_POKETEXT)
+			st20_icache_invalidate();
+		ret = 0;
+		break;
+
+	case PTRACE_POKEUSR:
+		ret = put_user_word(child, addr, data);
+		break;
+
+	case PTRACE_SYSCALL:
+	case PTRACE_CONT:
+		ret = -EIO;
+		if ((unsigned long) data > _NSIG)
+			break;
+		if (request == PTRACE_SYSCALL)
+			child->ptrace |= PT_TRACESYS;
+		else
+			child->ptrace &= ~PT_TRACESYS;
+		child->exit_code = data;
+		wake_up_process(child);
+		ret = 0;
+		break;
+
+	case PTRACE_KILL:
+		ret = 0;
+		if (child->state == TASK_ZOMBIE)
+			break;
+		child->exit_code = SIGKILL;
+		wake_up_process(child);
+		break;
+
+	case PTRACE_DETACH:
+		ret = ptrace_detach(child, data);
+		break;
+
+	case PTRACE_GETREGS:
+		ret = 0;
+		for (i = 0; i < PT_WORDS && !ret; i++) {
+			get_user_word(child, i * 4, &tmp);
+			ret = put_user(tmp, (unsigned long *) data + i);
+		}
+		break;
+
+	case PTRACE_SETREGS:
+		ret = child->thread.regs ? 0 : -EIO;
+		for (i = 0; i < PT_WORDS && !ret; i++) {
+			ret = get_user(tmp, (unsigned long *) data + i);
+			if (!ret && i != PT_STATUS)
+				put_user_word(child, i * 4, tmp);
+		}
+		break;
+
+	case PTRACE_SINGLESTEP:		/* no trace facility, see above */
+	default:
+		ret = -EIO;
+		break;
+	}
+out_tsk:
+	free_task_struct(child);
+out:
+	unlock_kernel();
+	return ret;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/semaphore.c b/linux-2.4.x/arch/st20/kernel/semaphore.c
new file mode 100644
index 000000000..690efce1e
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/semaphore.c
@@ -0,0 +1,132 @@
+/*
+ *  Generic semaphore code. Buyer beware. Do your own
+ * specific changes in <asm/semaphore-helper.h>
+ */
+
+#include <linux/config.h>
+#include <linux/sched.h>
+#include <asm/semaphore-helper.h>
+
+#ifndef CONFIG_RMW_INSNS
+spinlock_t semaphore_wake_lock;
+#endif
+
+/*
+ * Semaphores are implemented using a two-way counter:
+ * The "count" variable is decremented for each process
+ * that tries to sleep, while the "waking" variable is
+ * incremented when the "up()" code goes to wake up waiting
+ * processes.
+ *
+ * Notably, the inline "up()" and "down()" functions can
+ * efficiently test if they need to do any extra work (up
+ * needs to do something only if count was negative before
+ * the increment operation.
+ *
+ * waking_non_zero() (from asm/semaphore.h) must execute
+ * atomically.
+ *
+ * When __up() is called, the count was negative before
+ * incrementing it, and we need to wake up somebody.
+ *
+ * This routine adds one to the count of processes that need to
+ * wake up and exit.  ALL waiting processes actually wake up but
+ * only the one that gets to the "waking" field first will gate
+ * through and acquire the semaphore.  The others will go back
+ * to sleep.
+ *
+ * Note that these functions are only called when there is
+ * contention on the lock, and as such all this is the
+ * "non-critical" part of the whole semaphore business. The
+ * critical part is the inline stuff in <asm/semaphore.h>
+ * where we want to avoid any extra jumps and calls.
+ */
+void __up(struct semaphore *sem)
+{
+	wake_one_more(sem);
+	wake_up(&sem->wait);
+}
+
+/*
+ * Perform the "down" function.  Return zero for semaphore acquired,
+ * return negative for signalled out of the function.
+ *
+ * If called from __down, the return is ignored and the wait loop is
+ * not interruptible.  This means that a task waiting on a semaphore
+ * using "down()" cannot be killed until someone does an "up()" on
+ * the semaphore.
+ *
+ * If called from __down_interruptible, the return value gets checked
+ * upon return.  If the return value is negative then the task continues
+ * with the negative value in the return register (it can be tested by
+ * the caller).
+ *
+ * Either form may be used in conjunction with "up()".
+ *
+ */
+
+
+#define DOWN_HEAD(task_state)						\
+									\
+									\
+	current->state = (task_state);					\
+	add_wait_queue(&sem->wait, &wait);				\
+									\
+	/*								\
+	 * Ok, we're set up.  sem->count is known to be less than zero	\
+	 * so we must wait.						\
+	 *								\
+	 * We can let go the lock for purposes of waiting.		\
+	 * We re-acquire it after awaking so as to protect		\
+	 * all semaphore operations.					\
+	 *								\
+	 * If "up()" is called before we call waking_non_zero() then	\
+	 * we will catch it right away.  If it is called later then	\
+	 * we will have to go through a wakeup cycle to catch it.	\
+	 *								\
+	 * Multiple waiters contend for the semaphore lock to see	\
+	 * who gets to gate through and who has to wait some more.	\
+	 */								\
+	for (;;) {
+
+#define DOWN_TAIL(task_state)			\
+		current->state = (task_state);	\
+	}					\
+	current->state = TASK_RUNNING;		\
+	remove_wait_queue(&sem->wait, &wait);
+
+void __down(struct semaphore * sem)
+{
+	DECLARE_WAITQUEUE(wait, current);
+
+	DOWN_HEAD(TASK_UNINTERRUPTIBLE)
+	if (waking_non_zero(sem))
+		break;
+	schedule();
+	DOWN_TAIL(TASK_UNINTERRUPTIBLE)
+}
+
+int __down_interruptible(struct semaphore * sem)
+{
+	DECLARE_WAITQUEUE(wait, current);
+	int ret = 0;
+
+	DOWN_HEAD(TASK_INTERRUPTIBLE)
+
+	ret = waking_non_zero_interruptible(sem, current);
+	if (ret)
+	{
+		if (ret == 1)
+			/* ret != 0 only if we get interrupted -arca */
+			ret = 0;
+		break;
+	}
+	schedule();
+	DOWN_TAIL(TASK_INTERRUPTIBLE)
+	return ret;
+}
+
+int __down_trylock(struct semaphore * sem)
+{
+	return waking_non_zero_trylock(sem);
+}
diff --git a/linux-2.4.x/arch/st20/kernel/serial.c b/linux-2.4.x/arch/st20/kernel/serial.c
new file mode 100644
index 000000000..ae40e02da
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/serial.c
@@ -0,0 +1,233 @@
+/*
+ * arch/st20/kernel/serial.c - /dev/ttyS0: the RS-232 terminal on the board's ASC
+ * (DSR9500: ASC3, interrupt 7, set up by console.c like the original loader)
+ *
+ * Receive is interrupt driven: the high-priority top half (st20_asc_fast) empties the ASC
+ * into a ring like the original firmware's asc_isr, and st20_asc_rx moves the ring into the
+ * tty at low priority.  Transmit is polled.  set_termios programs baud rate, character
+ * size, parity and stop bits, so `stty 9600` etc. work.  st20_tty_input lets other input
+ * devices (IR remote keyboard, front panel) type into the same terminal.
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+#include <linux/serial.h>
+#include <linux/major.h>
+#include <linux/string.h>
+#include <linux/fcntl.h>
+#include <linux/mm.h>
+#include <linux/interrupt.h>
+#include <asm/system.h>
+#include <linux/init.h>
+#include <asm/uaccess.h>
+#include <asm/irq.h>
+#include <asm/board.h>
+#include <asm/st20asc.h>
+
+#define SERIAL_TYPE_NORMAL	1	/* as in the 2.0 serial drivers */
+#define ASC_IRQ			7	/* ASC3 */
+#define RX_RING			1024
+
+static struct tty_driver st20_serial_driver;
+static int st20_serial_refcount;
+static struct tty_struct *st20_serial_table[1];
+static struct termios *st20_serial_termios[1];
+static struct termios *st20_serial_termios_locked[1];
+static struct tty_struct *st20_tty;	/* the open tty, or 0 */
+
+static unsigned char rx_ring[RX_RING];
+static volatile unsigned int rx_head, rx_tail;	/* head: HP writer, tail: LP reader */
+static unsigned long rx_overruns;
+
+/* high priority: empty the receiver (the interrupt is level-triggered on RxBufFull) */
+static int st20_asc_fast(void)
+{
+	int got = 0;
+
+	while (ASC(ASC_STATUS) & ASC_STATUS_RXFULL) {
+		unsigned char c = ASC(ASC_RXBUF);
+		unsigned int next = (rx_head + 1) % RX_RING;
+
+		if (next != rx_tail) {
+			rx_ring[rx_head] = c;
+			rx_head = next;
+		} else
+			rx_overruns++;
+		got = 1;
+	}
+	return got;
+}
+
+static void push_chars(const unsigned char *s, int n)
+{
+	struct tty_struct *tty = st20_tty;
+
+	if (!tty)
+		return;
+	while (n-- > 0 && tty->flip.count < TTY_FLIPBUF_SIZE)
+		tty_insert_flip_char(tty, *s++, 0);
+	tty_flip_buffer_push(tty);
+}
+
+/* low priority: ring -> tty */
+static void st20_asc_rx(int irq, void *dev_id, struct pt_regs *regs)
+{
+	while (rx_tail != rx_head) {
+		unsigned char c = rx_ring[rx_tail];
+
+		rx_tail = (rx_tail + 1) % RX_RING;
+		push_chars(&c, 1);
+	}
+}
+
+void st20_tty_input(const char *s, int n)
+{
+	push_chars((const unsigned char *) s, n);
+}
+
+static int st20_open(struct tty_struct *tty, struct file *filp)
+{
+	if (MINOR(tty->device) - tty->driver.minor_start != 0)
+		return -ENODEV;
+	st20_tty = tty;
+	return 0;
+}
+
+static void st20_close(struct tty_struct *tty, struct file *filp)
+{
+	if (tty->count <= 1)
+		st20_tty = 0;
+}
+
+extern void st20_osd_write(const char *s, int n);
+
+/* line disciplines that send on their own (SLIP) wait for write_wakeup after each write;
+ * transmission is polled, so everything is out when st20_write returns: wake them from a
+ * tasklet (not from inside their own write) */
+static void st20_write_wakeup(unsigned long data)
+{
+	struct tty_struct *tty = st20_tty;
+
+	if (!tty)
+		return;
+	if ((tty->flags & (1 << TTY_DO_WRITE_WAKEUP)) && tty->ldisc.write_wakeup)
+		(tty->ldisc.write_wakeup)(tty);
+	wake_up_interruptible(&tty->write_wait);
+}
+
+static DECLARE_TASKLET(st20_wakeup_tasklet, st20_write_wakeup, 0);
+
+static int st20_write(struct tty_struct *tty, int from_user, const unsigned char *buf,
+		      int count)
+{
+	char chunk[64];
+	int i, n, done = 0;
+
+	while (done < count) {
+		n = count - done > (int) sizeof(chunk) ? (int) sizeof(chunk) : count - done;
+		if (from_user) {
+			if (copy_from_user(chunk, buf + done, n))
+				return done ? done : -EFAULT;
+		} else
+			memcpy(chunk, buf + done, n);
+		for (i = 0; i < n; i++)
+			st20_asc_putc(chunk[i]);
+		if (tty->ldisc.num == N_TTY)	/* no SLIP frames on the TV */
+			st20_osd_write(chunk, n);
+		done += n;
+	}
+	if (tty->flags & (1 << TTY_DO_WRITE_WAKEUP))
+		tasklet_schedule(&st20_wakeup_tasklet);
+	return count;
+}
+
+static void st20_put_char(struct tty_struct *tty, unsigned char ch)
+{
+	st20_asc_putc(ch);
+	st20_osd_write((char *) &ch, 1);
+}
+
+static int st20_write_room(struct tty_struct *tty)
+{
+	return 512;
+}
+
+static int st20_chars_in_buffer(struct tty_struct *tty)
+{
+	return 0;
+}
+
+static const unsigned long baud_table[] = {
+	0, 50, 75, 110, 134, 150, 200, 300, 600, 1200, 1800, 2400, 4800, 9600, 19200, 38400,
+	57600, 115200, 230400, 460800
+};
+
+static void st20_set_termios(struct tty_struct *tty, struct termios *old)
+{
+	unsigned int cflag = tty->termios->c_cflag;
+	unsigned long baud, ctrl;
+	int i = cflag & CBAUD;
+
+	if (i & CBAUDEX) {
+		i &= ~CBAUDEX;
+		i += 15;
+	}
+	baud = i < (int) (sizeof(baud_table) / sizeof(baud_table[0])) ? baud_table[i] : 115200;
+	if (!baud)
+		baud = 115200;
+	if (cflag & PARENB)
+		ctrl = (cflag & CSIZE) == CS7 ? ASC_CTRL_MODE_7P : ASC_CTRL_MODE_8P;
+	else
+		ctrl = ASC_CTRL_MODE_8;
+	if (cflag & PARODD)
+		ctrl |= ASC_CTRL_ODD;
+	ctrl |= (cflag & CSTOPB) ? ASC_CTRL_STOP_2 : ASC_CTRL_STOP_1;
+	ctrl |= ASC_CTRL_RUN | ((cflag & CREAD) ? ASC_CTRL_RXEN : 0);
+	st20_asc_set_line(baud, ctrl);
+}
+
+int __init st20_serial_init(void)
+{
+	memset(&st20_serial_driver, 0, sizeof(struct tty_driver));
+	st20_serial_driver.magic = TTY_DRIVER_MAGIC;
+	st20_serial_driver.driver_name = "serial";
+	st20_serial_driver.name = "ttyS";
+	st20_serial_driver.major = TTY_MAJOR;
+	st20_serial_driver.minor_start = 64;
+	st20_serial_driver.num = 1;
+	st20_serial_driver.type = TTY_DRIVER_TYPE_SERIAL;
+	st20_serial_driver.subtype = SERIAL_TYPE_NORMAL;
+	st20_serial_driver.init_termios = tty_std_termios;
+	st20_serial_driver.init_termios.c_cflag = B115200 | CS8 | CREAD | HUPCL | CLOCAL;
+	st20_serial_driver.flags = TTY_DRIVER_REAL_RAW;
+	st20_serial_driver.refcount = &st20_serial_refcount;
+	st20_serial_driver.table = st20_serial_table;
+	st20_serial_driver.termios = st20_serial_termios;
+	st20_serial_driver.termios_locked = st20_serial_termios_locked;
+	st20_serial_driver.open = st20_open;
+	st20_serial_driver.close = st20_close;
+	st20_serial_driver.write = st20_write;
+	st20_serial_driver.put_char = st20_put_char;
+	st20_serial_driver.write_room = st20_write_room;
+	st20_serial_driver.chars_in_buffer = st20_chars_in_buffer;
+	st20_serial_driver.set_termios = st20_set_termios;
+
+	if (tty_register_driver(&st20_serial_driver))
+		panic("Couldn't register ST20 serial driver\n");
+	if (st20_request_fast_irq(ASC_IRQ, st20_asc_fast, st20_asc_rx, "ttyS0"))
+		printk("ttyS0: cannot get interrupt %d\n", ASC_IRQ);
+	ASC(ASC_INTEN) = ASC_INTEN_RXFULL;
+	printk("ttyS0 at ASC %08lx (irq %d), %lu Hz clock, 115200 8N1\n", ST20_CONSOLE_ASC,
+	       ASC_IRQ, st20_asc_clock);
+	{
+		extern void st20_panel_init(void), st20_ir_init(void), st20_osd_init(void);
+
+		st20_osd_init();	/* TV console output */
+		st20_panel_init();	/* the other console input devices */
+		st20_ir_init();
+	}
+	return 0;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/setup.c b/linux-2.4.x/arch/st20/kernel/setup.c
new file mode 100644
index 000000000..8e4f5d9f4
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/setup.c
@@ -0,0 +1,153 @@
+/*
+ * arch/st20/kernel/setup.c - uClinux/ST20 machine setup (board: asm/board.h)
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/string.h>
+#include <linux/major.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/bootmem.h>
+#include <linux/seq_file.h>
+#include <linux/delay.h>
+#include <linux/unistd.h>
+
+#include <asm/system.h>
+#include <asm/setup.h>
+#include <asm/irq.h>
+#include <asm/pgtable.h>
+#include <asm/board.h>
+
+static void st20_avmem_alloc(const char *cmd);
+
+extern char _stext, _etext, _edata, _end, __init_begin, __init_end;
+extern long st20_syscall();
+extern void st20_console_init(void);
+extern void st20_icache_enable(void);
+
+unsigned long memory_start;
+unsigned long memory_end;
+
+/* rootfstype: the root is romfs; mount_root would otherwise try JFFS2 on it first */
+static char command_line[256] = "rootfstype=romfs";
+char saved_command_line[256];
+
+void __init setup_arch(char **cmdline_p)
+{
+	int bootmap_size;
+
+	st20_console_init();
+	printk("uClinux/ST20 on " ST20_BOARD_NAME ", gcc-2.7.2-t800 + ttools\n");
+	printk("KERNEL -> TEXT=%08lx-%08lx INIT=%08lx-%08lx DATA=%08lx-%08lx BSS=%08lx-%08lx\n",
+	       (unsigned long) &_stext, (unsigned long) &_etext,
+	       (unsigned long) &__init_begin, (unsigned long) &__init_end,
+	       (unsigned long) &__init_end, (unsigned long) &_edata,
+	       (unsigned long) &_edata, (unsigned long) &_end);
+
+	st20_icache_enable();
+
+	/* user programs call the kernel through this word */
+	*(unsigned long *) ST20_SYSCALL_VECTOR = (unsigned long) st20_syscall;
+	st20_kstack = (unsigned long) &init_task + THREAD_SIZE;
+
+	init_mm.start_code = (unsigned long) &_stext;
+	init_mm.end_code = (unsigned long) &_etext;
+	init_mm.end_data = (unsigned long) &_edata;
+	init_mm.brk = (unsigned long) &_end;
+
+	ROOT_DEV = MKDEV(31, 1);	/* mtdblock1: the flash's romfs partition */
+
+	memcpy(saved_command_line, command_line, sizeof(saved_command_line));
+	*cmdline_p = command_line;
+
+	memory_start = PAGE_ALIGN((unsigned long) &_end);
+	memory_end = ST20_RAM_END;
+
+	/* all memory after the kernel to the boot allocator, its bitmap at the start */
+	bootmap_size = init_bootmem_node(NODE_DATA(0), memory_start >> PAGE_SHIFT,
+					 PAGE_OFFSET >> PAGE_SHIFT, memory_end >> PAGE_SHIFT);
+	free_bootmem(memory_start, memory_end - memory_start);
+	reserve_bootmem(memory_start, bootmap_size);
+
+	{ extern void st20_osd_alloc(void); st20_osd_alloc(); }	/* TV console buffers */
+#ifdef CONFIG_FB_ST20OSD
+	{ extern void st20fb_alloc(void); st20fb_alloc(); }	/* /dev/fb0 (drivers/video/st20fb.c) */
+#endif
+	st20_avmem_alloc(command_line);
+	paging_init();
+}
+
+/*
+ * Optional boot reservation of the MPEG decoders' memory for the DVB module
+ * (modules/dvb/av.c): "avmem=KB" on the command line (2048 for bit buffers + three
+ * 720x576 frames).  The decoders address SDRAM with 14-bit pointers in 256-byte units,
+ * so it must lie in the low 4 MB, which the boot allocator can promise.  Default 0: the
+ * module takes a 2 MB page block at its first VIDEO_PLAY instead, so RAM is only spent
+ * when the decoders are used.
+ */
+#define ST20_AVMEM_KB	0
+unsigned long st20_avmem_start, st20_avmem_size;
+
+static void __init st20_avmem_alloc(const char *cmd)
+{
+	unsigned long kb = ST20_AVMEM_KB;
+	const char *p;
+
+	for (p = cmd; *p; p++)
+		if (!strncmp(p, "avmem=", 6) && (p == cmd || p[-1] == ' ')) {
+			kb = simple_strtoul(p + 6, 0, 0);
+			break;
+		}
+	st20_avmem_size = PAGE_ALIGN(kb * 1024);
+	if (st20_avmem_size)
+		st20_avmem_start = (unsigned long) alloc_bootmem_pages(st20_avmem_size);
+	if (st20_avmem_size)
+		printk("avmem: %lu KB at %08lx%s\n", st20_avmem_size >> 10, st20_avmem_start,
+		       st20_avmem_start + st20_avmem_size > ST20_RAM_START + 0x400000 ?
+		       " (beyond the decoders' 4 MB!)" : "");
+}
+
+extern unsigned long st20_ovf_traps, st20_fpe_traps;
+
+static int show_cpuinfo(struct seq_file *m, void *v)
+{
+	seq_printf(m, "CPU:\t\tST20-C2 (STi5512)\n"
+		   "Board:\t\t" ST20_BOARD_NAME "\n"
+		   "BogoMips:\t%lu.%02lu\n"
+		   "Calibration:\t%lu loops\n"
+		   "Overflow traps:\t%lu continued, %lu division errors\n",
+		   (loops_per_jiffy * HZ) / 500000, ((loops_per_jiffy * HZ) / 5000) % 100,
+		   loops_per_jiffy * HZ, st20_ovf_traps, st20_fpe_traps);
+	return 0;
+}
+
+static void *c_start(struct seq_file *m, loff_t *pos)
+{
+	return *pos < 1 ? (void *) 1 : NULL;
+}
+
+static void *c_next(struct seq_file *m, void *v, loff_t *pos)
+{
+	++*pos;
+	return c_start(m, pos);
+}
+
+static void c_stop(struct seq_file *m, void *v)
+{
+}
+
+struct seq_operations cpuinfo_op = {
+	start:	c_start,
+	next:	c_next,
+	stop:	c_stop,
+	show:	show_cpuinfo,
+};
+
+void st20_reboot(void)
+{
+	cli();
+	for (;;)
+		;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/signal.c b/linux-2.4.x/arch/st20/kernel/signal.c
new file mode 100644
index 000000000..1133b48cc
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/signal.c
@@ -0,0 +1,448 @@
+/*
+ * arch/st20/kernel/signal.c - signal delivery for uClinux/ST20
+ *
+ * The user state at a delivery point is five words: Wptr, Iptr, Areg, Breg, Creg (exact:
+ * continuing there with `restart` resumes the program as if nothing happened).  For a user
+ * handler, st20_handle_signals pushes a context (old mask + that state) below the Wptr --
+ * on ST20 the workspace below Wptr is always free -- and makes the program continue in the
+ * handler as if called from st20_sigtramp (entry.ast, kernel text run in user mode), which
+ * calls sigreturn when the handler returns.  Delivery points: the end of every system call
+ * (syscalls.c) and the end of a preemption that interrupted user code (time.c), so a busy
+ * program still gets SIGINT.  Handlers without SA_SIGINFO get the old frame (sigaction 67
+ * with one word of mask, as uC-libc uses it, or rt_sigaction): handler(sig), sigcontext,
+ * sigreturn (119).  SA_SIGINFO handlers get handler(sig, siginfo_t *, struct ucontext *)
+ * with the siginfo and a ucontext (uc_mcontext = the sigcontext, full uc_sigmask) in the
+ * frame, and return through st20_rt_sigtramp, which calls rt_sigreturn (173).
+ *
+ * System call restarting (as i386): a call that returns -ERESTARTNOHAND, -ERESTARTSYS or
+ * -ERESTARTNOINTR when a signal interrupted it is made again if no handler runs, or if the
+ * handler has SA_RESTART (-ERESTARTSYS) or always (-ERESTARTNOINTR); otherwise it
+ * returns -EINTR.  2.4 has no -ERESTART_RESTARTBLOCK.  Restarting continues the user
+ * code at st20_syscall_restart (see syscalls.c), under the handler's frame if one runs.
+ *
+ * ptrace: a traced task stops at signal delivery (TASK_STOPPED, exit_code = signal) with
+ * its exact user state in a pt_regs (thread.regs) that the tracer reads and may change.
+ */
+#include <linux/config.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/kernel.h>
+#include <linux/signal.h>
+#include <linux/errno.h>
+#include <linux/wait.h>
+#include <linux/ptrace.h>
+#include <linux/unistd.h>
+#include <linux/stddef.h>
+#include <asm/uaccess.h>
+#include <asm/ucontext.h>
+
+#define _BLOCKABLE (~(sigmask(SIGKILL) | sigmask(SIGSTOP)))
+
+struct st20_sigctx {
+	unsigned long mask;
+	unsigned long state[5];		/* Wptr, Iptr, Areg, Breg, Creg */
+};
+
+/* SA_SIGINFO frame, above the handler's 4-word call frame (sig, &info, &uc) */
+struct st20_rt_sigframe {
+	struct siginfo info;
+	struct ucontext uc;
+};
+
+extern void st20_sigtramp(void), st20_rt_sigtramp(void), st20_syscall_restart(void);
+asmlinkage long sys_wait4(pid_t pid, unsigned int * stat_addr, int options,
+			  struct rusage * ru);
+
+/* wait for a signal with set blocked; the handler's context restores the old mask */
+static int st20_sigsuspend(sigset_t *set)
+{
+	sigset_t saveset;
+
+	spin_lock_irq(&current->sigmask_lock);
+	saveset = current->blocked;
+	current->blocked = *set;
+	recalc_sigpending(current);
+	spin_unlock_irq(&current->sigmask_lock);
+
+	for (;;) {
+		current->state = TASK_INTERRUPTIBLE;
+		schedule();
+		if (signal_pending(current))
+			break;
+	}
+	current->thread.saved_mask = saveset;
+	current->thread.saved_mask_valid = 1;
+	return -EINTR;
+}
+
+asmlinkage int sys_sigsuspend(int restart, unsigned long oldmask, old_sigset_t mask)
+{
+	sigset_t set;
+
+	siginitset(&set, mask & _BLOCKABLE);
+	return st20_sigsuspend(&set);
+}
+
+asmlinkage int sys_rt_sigsuspend(sigset_t *unewset, size_t sigsetsize)
+{
+	sigset_t set;
+
+	if (sigsetsize != sizeof(sigset_t))
+		return -EINVAL;
+	if (copy_from_user(&set, unewset, sizeof(set)))
+		return -EFAULT;
+	sigdelsetmask(&set, ~_BLOCKABLE);
+	return st20_sigsuspend(&set);
+}
+
+asmlinkage int sys_sigaction(int sig, const struct old_sigaction *act,
+			     struct old_sigaction *oact)
+{
+	struct k_sigaction new_ka, old_ka;
+	int ret;
+
+	if (act) {
+		old_sigset_t mask;
+		if (verify_area(VERIFY_READ, act, sizeof(*act)) ||
+		    __get_user(new_ka.sa.sa_handler, &act->sa_handler) ||
+		    __get_user(new_ka.sa.sa_restorer, &act->sa_restorer))
+			return -EFAULT;
+		__get_user(new_ka.sa.sa_flags, &act->sa_flags);
+		__get_user(mask, &act->sa_mask);
+		siginitset(&new_ka.sa.sa_mask, mask);
+	}
+
+	ret = do_sigaction(sig, act ? &new_ka : NULL, oact ? &old_ka : NULL);
+
+	if (!ret && oact) {
+		if (verify_area(VERIFY_WRITE, oact, sizeof(*oact)) ||
+		    __put_user(old_ka.sa.sa_handler, &oact->sa_handler) ||
+		    __put_user(old_ka.sa.sa_restorer, &oact->sa_restorer))
+			return -EFAULT;
+		__put_user(old_ka.sa.sa_flags, &oact->sa_flags);
+		__put_user(old_ka.sa.sa_mask.sig[0], &oact->sa_mask);
+	}
+	return ret;
+}
+
+asmlinkage int sys_sigaltstack(const stack_t *uss, stack_t *uoss)
+{
+	return do_sigaltstack(uss, uoss, current->thread.usp);
+}
+
+asmlinkage int sys_sigreturn(unsigned long __unused)
+{
+	struct pt_regs *regs = current->thread.regs;
+	struct st20_sigctx *ctx;
+	sigset_t set;
+	int i;
+
+	if (!regs)
+		return -EINVAL;
+	/* st20_sigtramp entered the kernel with its frame 4 words below the context */
+	ctx = (struct st20_sigctx *) (regs->wptr + 16);
+	if (verify_area(VERIFY_READ, ctx, sizeof(*ctx)))
+		do_exit(SIGSEGV);
+	siginitset(&set, ctx->mask & _BLOCKABLE);
+	spin_lock_irq(&current->sigmask_lock);
+	current->blocked.sig[0] = set.sig[0];
+	recalc_sigpending(current);
+	spin_unlock_irq(&current->sigmask_lock);
+	for (i = 0; i < 5; i++)
+		current->thread.resume[i] = ctx->state[i];
+	current->thread.resume_valid = 1;
+	return ctx->state[2];
+}
+
+asmlinkage int sys_rt_sigreturn(unsigned long __unused)
+{
+	struct pt_regs *regs = current->thread.regs;
+	struct st20_rt_sigframe *rt;
+	sigset_t set;
+	int i;
+
+	if (!regs)
+		return -EINVAL;
+	/* st20_rt_sigtramp entered the kernel with its frame 4 words below the rt frame */
+	rt = (struct st20_rt_sigframe *) (regs->wptr + 16);
+	if (verify_area(VERIFY_READ, rt, sizeof(*rt)))
+		do_exit(SIGSEGV);
+	set = rt->uc.uc_sigmask;
+	sigdelsetmask(&set, ~_BLOCKABLE);
+	spin_lock_irq(&current->sigmask_lock);
+	current->blocked = set;
+	recalc_sigpending(current);
+	spin_unlock_irq(&current->sigmask_lock);
+	for (i = 0; i < 5; i++)
+		current->thread.resume[i] = rt->uc.uc_mcontext.sc_state[i];
+	current->thread.resume_valid = 1;
+	return rt->uc.uc_mcontext.sc_state[2];
+}
+
+/* the Wptr below which a handler's frame goes: the alternate stack (SA_ONSTACK) or u[0] */
+static unsigned long frame_base(struct k_sigaction *ka, unsigned long w)
+{
+	if ((ka->sa.sa_flags & SA_ONSTACK) && current->sas_ss_size && !on_sig_stack(w))
+		return current->sas_ss_sp + current->sas_ss_size;
+	return w;
+}
+
+/* make the user state u[5] continue in the handler of signr (old frame) */
+static void setup_frame(struct k_sigaction *ka, int signr, unsigned long *u,
+			unsigned long oldmask)
+{
+	struct st20_sigctx *ctx;
+	unsigned long *frame;
+	int i;
+
+	ctx = (struct st20_sigctx *) ((frame_base(ka, u[0]) - sizeof(*ctx)) & ~3UL);
+	frame = (unsigned long *) ctx - 4;
+	if (verify_area(VERIFY_WRITE, frame, sizeof(*ctx) + 16))
+		do_exit(SIGSEGV);
+	ctx->mask = oldmask;
+	for (i = 0; i < 5; i++)
+		ctx->state[i] = u[i];
+	frame[0] = (unsigned long) st20_sigtramp;	/* return address */
+	frame[1] = signr;				/* argument */
+	u[0] = (unsigned long) frame;
+	u[1] = (unsigned long) ka->sa.sa_handler;
+	u[2] = signr;
+	u[3] = u[4] = 0;
+}
+
+/* SA_SIGINFO: handler(signr, &rt->info, &rt->uc), returning to st20_rt_sigtramp */
+static void setup_rt_frame(struct k_sigaction *ka, int signr, siginfo_t *info,
+			   unsigned long *u, sigset_t *oldset)
+{
+	struct st20_rt_sigframe *rt;
+	unsigned long *frame;
+	int i;
+
+	rt = (struct st20_rt_sigframe *) ((frame_base(ka, u[0]) - sizeof(*rt)) & ~3UL);
+	frame = (unsigned long *) rt - 4;
+	if (verify_area(VERIFY_WRITE, frame, sizeof(*rt) + 16))
+		do_exit(SIGSEGV);
+	if (copy_siginfo_to_user(&rt->info, info))
+		do_exit(SIGSEGV);
+	rt->uc.uc_flags = 0;
+	rt->uc.uc_link = 0;
+	rt->uc.uc_stack.ss_sp = (void *) current->sas_ss_sp;
+	rt->uc.uc_stack.ss_flags = sas_ss_flags(u[0]);
+	rt->uc.uc_stack.ss_size = current->sas_ss_size;
+	rt->uc.uc_mcontext.sc_mask = oldset->sig[0];
+	for (i = 0; i < 5; i++)
+		rt->uc.uc_mcontext.sc_state[i] = u[i];
+	rt->uc.uc_sigmask = *oldset;
+	frame[0] = (unsigned long) st20_rt_sigtramp;	/* return address */
+	frame[1] = signr;				/* arguments */
+	frame[2] = (unsigned long) &rt->info;
+	frame[3] = (unsigned long) &rt->uc;
+	u[0] = (unsigned long) frame;
+	u[1] = (unsigned long) ka->sa.sa_handler;
+	u[2] = signr;
+	u[3] = frame[2];
+	u[4] = frame[3];
+}
+
+/* continue the user state u by making the system call in sc again */
+static void restart_syscall(unsigned long *u, struct st20_syscall_restart *sc)
+{
+	u[0] = (unsigned long) sc->uw;
+	u[1] = (unsigned long) st20_syscall_restart;
+	u[2] = u[3] = u[4] = 0;
+}
+
+static inline int is_restart(long res)
+{
+	return res == -ERESTARTSYS || res == -ERESTARTNOINTR || res == -ERESTARTNOHAND;
+}
+
+/*
+ * A traced task stops for its tracer (2.4 do_signal): u is its user state, which the
+ * tracer can read and change through thread.regs while it is stopped.  Returns the
+ * signal to deliver instead (0: none).
+ */
+static int ptrace_signal_stop(int signr, unsigned long *u, struct st20_syscall_restart *sc)
+{
+	struct pt_regs regs, *saved = current->thread.regs;
+
+	memset(&regs, 0, sizeof(regs));
+	regs.orig_nr = sc ? (long) sc->uw[1] : -1;
+	regs.result = sc ? sc->res : 0;
+	regs.wptr = u[0];
+	regs.iptr = u[1];
+	regs.areg = u[2];
+	regs.breg = u[3];
+	regs.creg = u[4];
+	regs.status = PS_USER;
+	current->thread.regs = &regs;
+	current->exit_code = signr;
+	current->state = TASK_STOPPED;
+	notify_parent(current, SIGCHLD);
+	schedule();
+	current->thread.regs = saved;
+	u[0] = regs.wptr;
+	u[1] = regs.iptr;
+	u[2] = regs.areg;
+	u[3] = regs.breg;
+	u[4] = regs.creg;
+	signr = current->exit_code;
+	current->exit_code = 0;
+	return signr;
+}
+
+/* system call stop for PTRACE_SYSCALL (entry and exit, syscalls.c) */
+void st20_syscall_trace(struct pt_regs *regs)
+{
+	if ((current->ptrace & (PT_PTRACED|PT_TRACESYS)) != (PT_PTRACED|PT_TRACESYS))
+		return;
+	current->exit_code = SIGTRAP;
+	current->state = TASK_STOPPED;
+	notify_parent(current, SIGCHLD);
+	schedule();
+	if (current->exit_code) {
+		send_sig(current->exit_code, current, 1);
+		current->exit_code = 0;
+	}
+}
+
+/*
+ * Handles the pending signals of the current (user) task at a delivery point; u is its user
+ * state, sc the system call it returns from (NULL: none, or exec/sigreturn).  Returns 1 if
+ * u has changed (a handler runs, or the call is restarted).
+ */
+int st20_handle_signals(unsigned long *u, struct st20_syscall_restart *sc)
+{
+	siginfo_t info;
+	struct k_sigaction *ka;
+	sigset_t oldset = current->thread.saved_mask_valid ?
+			  current->thread.saved_mask : current->blocked;
+	int signr, changed = 0;
+
+	if (sc && !is_restart(sc->res))
+		sc = NULL;
+	for (;;) {
+		spin_lock_irq(&current->sigmask_lock);
+		signr = dequeue_signal(&current->blocked, &info);
+		spin_unlock_irq(&current->sigmask_lock);
+		if (!signr)
+			break;
+
+		if ((current->ptrace & PT_PTRACED) && signr != SIGKILL) {
+			unsigned long w = u[0], i = u[1];
+
+			signr = ptrace_signal_stop(signr, u, sc);
+			if (u[0] != w || u[1] != i) {
+				changed = 1;	/* the tracer moved it: no restart */
+				sc = NULL;
+			}
+			if (!signr || signr == SIGSTOP)
+				continue;
+			if (signr != info.si_signo) {
+				info.si_signo = signr;
+				info.si_errno = 0;
+				info.si_code = SI_USER;
+				info.si_pid = current->p_pptr->pid;
+				info.si_uid = current->p_pptr->uid;
+			}
+			if (sigismember(&current->blocked, signr)) {
+				send_sig_info(signr, &info, current);
+				continue;
+			}
+		}
+
+		ka = &current->sig->action[signr-1];
+		if (ka->sa.sa_handler == SIG_IGN) {
+			if (signr != SIGCHLD)
+				continue;
+			while (sys_wait4(-1, NULL, WNOHANG, NULL) > 0)
+				;
+			continue;
+		}
+		if (ka->sa.sa_handler == SIG_DFL) {
+			int exit_code = signr;
+
+			if (current->pid == 1)
+				continue;
+			switch (signr) {
+			case SIGCONT: case SIGCHLD: case SIGWINCH: case SIGURG:
+				continue;
+			case SIGTSTP: case SIGTTIN: case SIGTTOU:
+				if (is_orphaned_pgrp(current->pgrp))
+					continue;
+				/* fall through */
+			case SIGSTOP: {
+				struct signal_struct *sig;
+				current->state = TASK_STOPPED;
+				current->exit_code = signr;
+				sig = current->p_pptr->sig;
+				if (sig && !(sig->action[SIGCHLD-1].sa.sa_flags & SA_NOCLDSTOP))
+					notify_parent(current, SIGCHLD);
+				schedule();
+				continue;
+			}
+			default:
+				sig_exit(signr, exit_code, &info);
+				/* not reached */
+			}
+		}
+
+		/* user handler: first the interrupted system call's fate */
+		if (sc) {
+			switch (sc->res) {
+			case -ERESTARTSYS:
+				if (ka->sa.sa_flags & SA_RESTART) {
+					restart_syscall(u, sc);
+					break;
+				}
+				/* fall through */
+			case -ERESTARTNOHAND:
+				u[2] = -EINTR;
+				break;
+			case -ERESTARTNOINTR:
+				restart_syscall(u, sc);
+				break;
+			}
+			sc = NULL;
+		}
+		if (ka->sa.sa_flags & SA_SIGINFO)
+			setup_rt_frame(ka, signr, &info, u, &oldset);
+		else
+			setup_frame(ka, signr, u, oldset.sig[0]);
+		if (ka->sa.sa_flags & SA_ONESHOT)
+			ka->sa.sa_handler = SIG_DFL;
+		if (!(ka->sa.sa_flags & SA_NODEFER)) {
+			spin_lock_irq(&current->sigmask_lock);
+			sigorsets(&current->blocked, &current->blocked, &ka->sa.sa_mask);
+			sigaddset(&current->blocked, signr);
+			recalc_sigpending(current);
+			spin_unlock_irq(&current->sigmask_lock);
+		}
+		current->thread.saved_mask_valid = 0;
+		return 1;
+	}
+	if (current->thread.saved_mask_valid) {
+		spin_lock_irq(&current->sigmask_lock);
+		current->blocked = current->thread.saved_mask;
+		recalc_sigpending(current);
+		spin_unlock_irq(&current->sigmask_lock);
+		current->thread.saved_mask_valid = 0;
+	}
+	if (sc) {		/* no handler ran: make the call again */
+		restart_syscall(u, sc);
+		changed = 1;
+	}
+	return changed;
+}
+
+/* as i386: the kernel-internal __SI_* class bits of si_code are not copied */
+int copy_siginfo_to_user(siginfo_t *to, siginfo_t *from)
+{
+	siginfo_t tmp;
+
+	if (!access_ok(VERIFY_WRITE, to, sizeof(siginfo_t)))
+		return -EFAULT;
+	tmp = *from;
+	tmp.si_code = (short) from->si_code;
+	return copy_to_user(to, &tmp, sizeof(siginfo_t)) ? -EFAULT : 0;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/sys_st20.c b/linux-2.4.x/arch/st20/kernel/sys_st20.c
new file mode 100644
index 000000000..68a9b4f21
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/sys_st20.c
@@ -0,0 +1,216 @@
+/*
+ * arch/st20/kernel/sys_st20.c - architecture specific system calls (after h8300's)
+ */
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/smp.h>
+#include <linux/smp_lock.h>
+#include <linux/stat.h>
+#include <linux/mman.h>
+#include <linux/file.h>
+#include <linux/utsname.h>
+#include <linux/sem.h>
+#include <linux/msg.h>
+#include <linux/shm.h>
+#include <asm/uaccess.h>
+#include <asm/ipc.h>
+
+asmlinkage int sys_pipe(unsigned long * fildes)
+{
+	int fd[2];
+	int error;
+
+	error = do_pipe(fd);
+	if (!error) {
+		if (copy_to_user(fildes, fd, 2*sizeof(int)))
+			error = -EFAULT;
+	}
+	return error;
+}
+
+/* common code for old and new mmaps */
+static inline long do_mmap2(
+	unsigned long addr, unsigned long len,
+	unsigned long prot, unsigned long flags,
+	unsigned long fd, unsigned long pgoff)
+{
+	int error = -EBADF;
+	struct file * file = NULL;
+
+	flags &= ~(MAP_EXECUTABLE | MAP_DENYWRITE);
+	if (!(flags & MAP_ANONYMOUS)) {
+		file = fget(fd);
+		if (!file)
+			goto out;
+	}
+
+	down_write(&current->mm->mmap_sem);
+	error = do_mmap_pgoff(file, addr, len, prot, flags, pgoff);
+	up_write(&current->mm->mmap_sem);
+
+	if (file)
+		fput(file);
+out:
+	return error;
+}
+
+asmlinkage long sys_mmap2(unsigned long addr, unsigned long len,
+	unsigned long prot, unsigned long flags,
+	unsigned long fd, unsigned long pgoff)
+{
+	return do_mmap2(addr, len, prot, flags, fd, pgoff);
+}
+
+/*
+ * Perform the select(nd, in, out, ex, tv) and mmap() system
+ * calls. Linux/m68k cloned Linux/i386, which didn't use to be able to
+ * handle more than 4 system call parameters, so these system calls
+ * used a memory block for parameter passing..
+ */
+
+struct mmap_arg_struct {
+	unsigned long addr;
+	unsigned long len;
+	unsigned long prot;
+	unsigned long flags;
+	unsigned long fd;
+	unsigned long offset;
+};
+
+asmlinkage int old_mmap(struct mmap_arg_struct *arg)
+{
+	struct mmap_arg_struct a;
+	int error = -EFAULT;
+
+	if (copy_from_user(&a, arg, sizeof(a)))
+		goto out;
+
+	error = -EINVAL;
+	if (a.offset & ~PAGE_MASK)
+		goto out;
+
+	a.flags &= ~(MAP_EXECUTABLE | MAP_DENYWRITE);
+
+	error = do_mmap2(a.addr, a.len, a.prot, a.flags, a.fd, a.offset >> PAGE_SHIFT);
+out:
+	return error;
+}
+
+extern asmlinkage int sys_select(int, fd_set *, fd_set *, fd_set *, struct timeval *);
+
+struct sel_arg_struct {
+	unsigned long n;
+	fd_set *inp, *outp, *exp;
+	struct timeval *tvp;
+};
+
+asmlinkage int old_select(struct sel_arg_struct *arg)
+{
+	struct sel_arg_struct a;
+
+	if (copy_from_user(&a, arg, sizeof(a)))
+		return -EFAULT;
+	/* sys_select() does the appropriate kernel locking */
+	return sys_select(a.n, a.inp, a.outp, a.exp, a.tvp);
+}
+
+/*
+ * sys_ipc() is the de-multiplexer for the SysV IPC calls (as i386).  It takes 6 arguments
+ * (fifth: SEMTIMEDOP's timeout, MSGRCV version 1's msgtyp), which only the 6-argument
+ * system call convention passes (syscalls.c, only for those two calls); uC-libc calls it
+ * with 5 (fifth = 0).
+ * Shared memory on NO_MM (ipc/shm.c): a segment is one kmalloc'd block (at most 128 KB),
+ * shmat returns its address (shmaddr must be 0: no fixed address without an MMU), shmdt
+ * only counts the detach; segments are not detached at exit.
+ */
+asmlinkage int sys_ipc(uint call, int first, int second, int third, void *ptr, long fifth)
+{
+#ifdef CONFIG_SYSVIPC
+	int version, ret;
+
+	version = call >> 16;	/* hack for backward compatibility */
+	call &= 0xffff;
+
+	switch (call) {
+	case SEMOP:
+		return sys_semtimedop(first, (struct sembuf *) ptr, second, NULL);
+	case SEMTIMEDOP:
+		return sys_semtimedop(first, (struct sembuf *) ptr, second,
+				      (const struct timespec *) fifth);
+	case SEMGET:
+		return sys_semget(first, second, third);
+	case SEMCTL: {
+		union semun fourth;
+		if (!ptr)
+			return -EINVAL;
+		if (get_user(fourth.__pad, (void **) ptr))
+			return -EFAULT;
+		return sys_semctl(first, second, third, fourth);
+	}
+	case MSGSND:
+		return sys_msgsnd(first, (struct msgbuf *) ptr, second, third);
+	case MSGRCV:
+		switch (version) {
+		case 0: {
+			struct ipc_kludge tmp;
+			if (!ptr)
+				return -EINVAL;
+			if (copy_from_user(&tmp, (struct ipc_kludge *) ptr, sizeof(tmp)))
+				return -EFAULT;
+			return sys_msgrcv(first, tmp.msgp, second, tmp.msgtyp, third);
+		}
+		default:
+			return sys_msgrcv(first, (struct msgbuf *) ptr, second, fifth, third);
+		}
+	case MSGGET:
+		return sys_msgget((key_t) first, second);
+	case MSGCTL:
+		return sys_msgctl(first, second, (struct msqid_ds *) ptr);
+	case SHMAT: {
+		ulong raddr;
+		ret = sys_shmat(first, (char *) ptr, second, &raddr);
+		if (ret)
+			return ret;
+		return put_user(raddr, (ulong *) third);
+	}
+	case SHMDT:
+		return sys_shmdt((char *) ptr);
+	case SHMGET:
+		return sys_shmget(first, second, third);
+	case SHMCTL:
+		return sys_shmctl(first, second, (struct shmid_ds *) ptr);
+	}
+#endif
+	return -ENOSYS;
+}
+
+asmlinkage int sys_ioperm(unsigned long from, unsigned long num, int on)
+{
+	return -ENOSYS;
+}
+
+asmlinkage int sys_cacheflush(unsigned long addr, int scope, int cache, unsigned long len)
+{
+	return 0;
+}
+
+asmlinkage int sys_pause(void)
+{
+	current->state = TASK_INTERRUPTIBLE;
+	schedule();
+	return -ERESTARTNOHAND;
+}
+
+/* uname (109) with the old struct, as i386 */
+asmlinkage int sys_uname(struct old_utsname * name)
+{
+	int err;
+
+	if (!name)
+		return -EFAULT;
+	down_read(&uts_sem);
+	err = copy_to_user(name, &system_utsname, sizeof (*name));
+	up_read(&uts_sem);
+	return err ? -EFAULT : 0;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/syscalls.c b/linux-2.4.x/arch/st20/kernel/syscalls.c
new file mode 100644
index 000000000..04f8b3e78
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/syscalls.c
@@ -0,0 +1,178 @@
+/*
+ * arch/st20/kernel/syscalls.c - system call table and dispatcher (generated list, same
+ * numbering as include/asm-st20/unistd.h)
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/ptrace.h>
+#include <linux/unistd.h>
+#include <asm/system.h>
+#include <asm/signal.h>
+#include <asm/ipc.h>
+
+/* #define ST20_TRACE_SYSCALLS */	/* printk fork/exec/exit/wait4 calls */
+
+typedef long (*syscall_t)(long, long, long, long, long, long);
+extern const syscall_t st20_sys_call_table[];
+extern const unsigned long st20_nr_syscalls;
+
+
+extern void st20_return_to_user(unsigned long *uw, long result);
+extern void st20_restart(unsigned long *record);
+extern int st20_handle_signals(unsigned long *u, struct st20_syscall_restart *sc);
+extern void st20_syscall_trace(struct pt_regs *regs);
+
+static long dispatch(struct pt_regs *regs)
+{
+	unsigned long nr = regs->orig_nr;
+
+	if (nr >= st20_nr_syscalls)
+		return -ENOSYS;
+	return st20_sys_call_table[nr](regs->arg[0], regs->arg[1], regs->arg[2],
+				       regs->arg[3], regs->arg[4], regs->arg[5]);
+}
+
+/*
+ * The calls with a 6th argument word (uw[7], see st20_syscall_c).  Only these read it:
+ * callers of 5-argument calls (uC-libc's stubs, the vfork stub) pass 5 words, and the
+ * word above them is the caller's own frame -- not necessarily ever written.  ipc uses
+ * its 6th argument only for SEMTIMEDOP and MSGRCV version 1, so uC-libc's and uClibc's
+ * 5-argument ipc() stay valid for everything else.
+ */
+static inline int six_args(unsigned long nr, unsigned long a)
+{
+	if (nr == __NR_mmap2)
+		return 1;
+	if (nr == __NR_ipc)
+		return (a & 0xffff) == SEMTIMEDOP || ((a & 0xffff) == MSGRCV && (a >> 16) != 0);
+	return 0;
+}
+
+#define ST20_STATUS_VALID	0x80000000UL
+#define ST20_TRAP_REASON	0x00003fffUL
+
+/*
+ * Continues user code exactly at u = { Wptr, Iptr, Areg, Breg, Creg } (exec, sigreturn,
+ * signal handlers): a state record with the current enables/status (stshadow of our own
+ * priority) and `restart`.  Never returns.
+ */
+void st20_resume_user(unsigned long *u)
+{
+	unsigned long rec[7];
+	int i;
+
+	sti();
+	__asm__ __volatile__ ("stshadow" : : "cP" (rec), "bP" (1), "aP" (7) : "memory");
+	rec[1] = (rec[1] | ST20_STATUS_VALID) & ~ST20_TRAP_REASON;
+	for (i = 0; i < 5; i++)
+		rec[2 + i] = u[i];
+	st20_restart(rec);
+}
+
+/*
+ * Called from st20_syscall (entry.ast) on the task's kernel stack.  uw is the caller's
+ * workspace: uw[0] = return Iptr, uw[1..6] = nr, a..e, and for the 6-argument calls
+ * (six_args) uw[7] = f -- the caller passes (nr, a, b, c, d, e, f) as the 7 arguments of a
+ * plain gcc-t800 call through the vector, so nr..b arrive through Areg-Creg (`call` stores
+ * them in uw[1..3]) and c..f are the caller's outgoing argument words uw[4..7].  A plain
+ * return goes back through entry.ast (`ret` on uw with Areg = result); exec, sigreturn,
+ * signal handlers and restarted calls continue through st20_resume_user.
+ *
+ * Restarting (-ERESTARTSYS & co., st20_handle_signals): uw[1..7] still hold the call, so
+ * the call is made again by continuing the user code at st20_syscall_restart (entry.ast,
+ * kernel text run in user mode) with Wptr = uw, which jumps into the vector again
+ * exactly like the original call did; it then returns to uw[0] as the original would have.
+ */
+long st20_syscall_c(unsigned long *uw)
+{
+	struct pt_regs regs;
+	struct pt_regs *saved = current->thread.regs;
+	struct st20_syscall_restart sc;
+	unsigned long u[5];
+	int i, exact = 0;
+	long res;
+
+	regs.orig_nr = uw[1];
+	for (i = 0; i < 5; i++)
+		regs.arg[i] = uw[2 + i];
+	regs.arg[5] = six_args(regs.orig_nr, regs.arg[0]) ? uw[7] : 0;
+	regs.wptr = (unsigned long) uw;
+	regs.iptr = uw[0];
+	regs.status = PS_USER;
+	regs.result = 0;
+	regs.areg = regs.breg = regs.creg = 0;
+	current->thread.regs = &regs;
+	current->thread.usp = (unsigned long) uw;
+	current->thread.resume_valid = 0;
+#ifdef ST20_TRACE_SYSCALLS
+	if (regs.orig_nr == 2 || regs.orig_nr == 11 || regs.orig_nr == 1 || regs.orig_nr == 114)
+		printk("[pid %d sys %ld(%lx,%lx,%lx) uw=%p ret=%lx]\n", current->pid, regs.orig_nr,
+		       regs.arg[0], regs.arg[1], regs.arg[2], uw, uw[0]);
+#endif
+	if (current->ptrace & PT_TRACESYS)
+		st20_syscall_trace(&regs);	/* entry stop: the tracer may change the call */
+	res = dispatch(&regs);
+	if (current->ptrace & PT_TRACESYS) {
+		regs.result = res;
+		st20_syscall_trace(&regs);	/* exit stop */
+		res = regs.result;
+	}
+	current->thread.regs = saved;
+
+	if (current->thread.resume_valid) {	/* exec or sigreturn */
+		for (i = 0; i < 5; i++)
+			u[i] = current->thread.resume[i];
+		current->thread.resume_valid = 0;
+		exact = 1;
+	} else {
+		/* as `ret` would continue: Iptr = uw[0], Wptr = uw + 4 words, Areg = result
+		   (vfork: the child ran on this stack, so uw[0] comes from pt_regs) */
+		uw[0] = regs.iptr;
+		u[0] = (unsigned long) (uw + 4);
+		u[1] = regs.iptr;
+		u[2] = res;
+		u[3] = u[4] = 0;
+	}
+	if (current->need_resched)	/* return to user mode: the place to reschedule */
+		schedule();
+	sc.res = res;
+	sc.uw = uw;
+	if (signal_pending(current) || current->thread.saved_mask_valid) {
+		if (st20_handle_signals(u, exact ? NULL : &sc))
+			exact = 1;
+	} else if (res == -ERESTARTSYS || res == -ERESTARTNOINTR || res == -ERESTARTNOHAND) {
+		u[2] = res = -EINTR;	/* nothing to restart for (no signal is pending) */
+	}
+	if (exact)
+		st20_resume_user(u);
+	return u[2];
+}
+
+/* the kernel's own _syscallN calls (init/main.c): same table, no stack switch */
+long st20_kernel_syscall(long nr, long a, long b, long c, long d, long e)
+{
+	struct pt_regs regs;
+	struct pt_regs *saved = current->thread.regs;
+	unsigned long here;
+	long res;
+
+	regs.orig_nr = nr;
+	regs.arg[0] = a; regs.arg[1] = b; regs.arg[2] = c; regs.arg[3] = d; regs.arg[4] = e;
+	regs.arg[5] = 0;
+	regs.wptr = (unsigned long) &here;
+	regs.iptr = 0;
+	regs.status = 0;
+	current->thread.regs = &regs;
+	current->thread.resume_valid = 0;
+	res = dispatch(&regs);
+	if (res == -ERESTARTSYS || res == -ERESTARTNOINTR || res == -ERESTARTNOHAND)
+		res = -EINTR;
+	current->thread.regs = saved;
+	if (current->thread.resume_valid) {
+		/* a kernel thread exec'ed a user program (init): enter it */
+		current->thread.resume_valid = 0;
+		st20_resume_user(current->thread.resume);
+	}
+	return res;
+}
diff --git a/linux-2.4.x/arch/st20/kernel/syscalltab.c b/linux-2.4.x/arch/st20/kernel/syscalltab.c
new file mode 100644
index 000000000..007792fb3
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/syscalltab.c
@@ -0,0 +1,445 @@
+/*
+ * arch/st20/kernel/syscalltab.c - system call table (numbers as in asm-st20/unistd.h,
+ * the m68k/h8300 2.4 numbering; 109 = old uname); no headers, so the K&R declarations
+ * below do not clash with the real prototypes
+ */
+typedef long (*syscall_t)(long, long, long, long, long);
+
