+#ifndef _ST20_ASC_H
+#define _ST20_ASC_H
+
+/* STi5512 ASC (UART) and PIO registers used by arch/st20 (Register Manual 7145562) */
+#include <asm/board.h>
+
+#define ASC(o)		(*(volatile unsigned long *) (ST20_CONSOLE_ASC + (o)))
+#define ASC_BAUD	0x00
+#define ASC_TXBUF	0x04
+#define ASC_RXBUF	0x08
+#define ASC_CTRL	0x0c
+#define ASC_INTEN	0x10
+#define ASC_STATUS	0x14
+
+#define ASC_STATUS_RXFULL	0x001
+#define ASC_STATUS_TXEMPTY	0x002
+#define ASC_INTEN_RXFULL	0x001
+
+/* control: mode bits 0-2, stop bits 3-4, odd parity 5, run 7, receiver enable 8 */
+#define ASC_CTRL_MODE_8		0x001	/* 8 data bits */
+#define ASC_CTRL_MODE_7P	0x003	/* 7 data bits + parity */
+#define ASC_CTRL_MODE_8P	0x007	/* 8 data bits + parity */
+#define ASC_CTRL_STOP_1		0x008
+#define ASC_CTRL_STOP_2		0x018
+#define ASC_CTRL_ODD		0x020
+#define ASC_CTRL_RUN		0x080
+#define ASC_CTRL_RXEN		0x100
+#define ASC_CTRL_8N1		(ASC_CTRL_MODE_8 | ASC_CTRL_STOP_1 | ASC_CTRL_RUN | ASC_CTRL_RXEN)
+
+/* PIO ports at 0x2000c000 + port * 0x1000 */
+#define PIO_BASE(port)	(0x2000c000UL + (port) * 0x1000UL)
+#define PIO(port, o)	(*(volatile unsigned long *) (PIO_BASE(port) + (o)))
+#define PIO1(o)		PIO(1, o)
+#define PIO3(o)		PIO(3, o)
+#define PIO4(o)		PIO(4, o)
+#define PIO_SET_OUT	0x04
+#define PIO_CLR_OUT	0x08
+#define PIO_IN		0x10
+#define PIO_SET_PC0	0x24
+#define PIO_CLR_PC0	0x28
+#define PIO_SET_PC1	0x34
+#define PIO_CLR_PC1	0x38
+#define PIO_SET_PC2	0x44
+#define PIO_CLR_PC2	0x48
