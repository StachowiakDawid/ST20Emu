+/*
+ * include/asm-st20/flat.h -- uClinux flat-format executables (bFLT rev 4 as written by
+ * ../tools/mkflat.py: pointer words to relocate are stored big-endian in the file)
+ */
+#ifndef __ST20_FLAT_H__
+#define __ST20_FLAT_H__
+
+#define	flat_stack_align(sp)			/* nothing needed */
+#define	flat_argvp_envp_on_stack()		0	/* crt0: sp[0] = argc, sp[1..] = argv[] */
+#define	flat_old_ram_flag(flags)		(flags)
+#define	flat_reloc_valid(reloc, size)		((reloc) <= (size))
+#define	flat_get_relocate_addr(rel)		(rel)
+#define	flat_get_addr_from_rp(rp, relval)	get_unaligned(rp)	/* the loader applies ntohl */
+#define	flat_put_addr_at_rp(rp, addr, rel)	put_unaligned((addr), (rp))
+
+#endif /* __ST20_FLAT_H__ */
