+	((*(__st20_syscall_t *) ST20_SYSCALL_VECTOR) \
+	 ((long)(nr), (long)(a), (long)(b), (long)(c), (long)(d), (long)(e)))
+#define __st20_syscall6(nr,a,b,c,d,e,f) \
+	((*(__st20_syscall6_t *) ST20_SYSCALL_VECTOR) \
+	 ((long)(nr), (long)(a), (long)(b), (long)(c), (long)(d), (long)(e), (long)(f)))
+
