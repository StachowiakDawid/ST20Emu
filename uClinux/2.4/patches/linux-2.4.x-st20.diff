diff --git a/linux-2.4.x/include/asm-st20/irq.h b/linux-2.4.x/include/asm-st20/irq.h
new file mode 100644
index 000000000..9beabe061
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/irq.h
@@ -0,0 +1,23 @@
+#ifndef _ST20_IRQ_H_
+#define _ST20_IRQ_H_
+
+/* Linux IRQ = STi5512 interrupt source (ASC3 = 7, PWM/IR = 11, ...), arch/st20/kernel/irq.c */
+#define NR_IRQS 32
+
+static __inline__ int irq_cannonicalize(int irq)
+{
+	return irq;
+}
+
+extern void enable_irq(unsigned int);
+extern void disable_irq(unsigned int);
+#define enable_irq_nosync(x)	enable_irq(x)
+#define disable_irq_nosync(x)	disable_irq(x)
+
+/* a high-priority top half plus (optionally) a Linux handler for the work it queues */
+struct pt_regs;
+extern int st20_request_fast_irq(unsigned int irq, int (*fast)(void),
+				 void (*handler)(int, void *, struct pt_regs *),
+				 const char *devname);
+
+#endif /* _ST20_IRQ_H_ */
