+#
+# arch/st20/kernel/Makefile
+#
+# hand-written assembly is *.ast (make clean deletes *.s)
+%.o: %.ast
+	$(AS) -o $@ $<
+
+all: kernel.o head.o
+
+O_TARGET := kernel.o
+obj-y := entry.o setup.o process.o traps.o irq.o time.o signal.o sys_st20.o syscalls.o ptrace.o \
+	 syscalltab.o semaphore.o console.o serial.o osd.o panel.o ir.o
