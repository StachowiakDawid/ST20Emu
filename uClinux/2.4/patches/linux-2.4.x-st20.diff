+extern char remove_proc_entry;
+extern char proc_mkdir;
+extern char add_timer;
+extern char del_timer;
+extern char mod_timer;
+extern char __wake_up;
+extern char interruptible_sleep_on;
+extern char schedule;
+extern char schedule_timeout;
