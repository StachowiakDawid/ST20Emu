diff --git a/linux-2.4.x/drivers/mtd/maps/dsr9500-flash.c b/linux-2.4.x/drivers/mtd/maps/dsr9500-flash.c
new file mode 100644
index 000000000..121d01889
--- /dev/null
+++ b/linux-2.4.x/drivers/mtd/maps/dsr9500-flash.c
@@ -0,0 +1,151 @@
+/*
+ * drivers/mtd/maps/dsr9500-flash.c - MTD map for the Samsung DSR9500's flash
+ *
+ * 2 MB of 16-bit NOR flash at 0x7fe00000-0x7fffffff (asm/board.h).  The original boot
+ * loader (Decompilation/DSR9500 src/hw.c flash_detect/flash_write) accepts AMD (1),
+ * Fujitsu (4), Samsung (0xec) and SST (0xbf) parts and programs them with the AMD command
+ * set (unlock cycles at word 0x5555/0x2aaa, sector erase 0x30, SST block erase 0x50), so a
+ * real board is probed with CFI first and JEDEC second (AMD command set, cfi_cmdset_0002).
+ *
+ * st20emu models no flash chip on --board dsr9500: the flash is plain memory there, and
+ * command writes would land in the array.  So before any probe one word is tested: a
+ * 0xf0f0 store (read/reset, harmless on an AMD chip) that reads back means RAM-like
+ * flash; the word is restored and the map is driven by map_ram (erase = fill with 0xff)
+ * with 64 KB erase blocks like the real chip's main sectors.  Neither probe nor test
+ * leaves anything in the array.  A chip that answers neither probe is mapped read-only
+ * (map_rom).
+ *
+ * Partitions (asm/board.h ST20_FLASH_*; tools/mkrom-dsr9500.py writes the images):
+ *   mtd0 kernel  0x000000-0x0bffff  768 KB  kernel image (crossload output, without bss)
+ *   mtd1 romfs   0x0c0000-0x16ffff  704 KB  root file system (/dev/mtdblock1)
+ *   mtd2 jffs2   0x170000-0x1effff  512 KB  JFFS2, mounted on /etc/config by /etc/rc
+ *                (8 erase blocks: this JFFS2 keeps 5 free for writes and GC, so about
+ *                192 KB hold data)
+ *   mtd3 boot    0x1f0000-0x1fffff   64 KB  loader, boot init blob, reset entry (read-only)
+ */
+#include <linux/config.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/string.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/map.h>
+#include <linux/mtd/partitions.h>
+#include <asm/board.h>
+
+static __u8 dsr_read8(struct map_info *map, unsigned long ofs)
+{
+	return *(volatile __u8 *) (map->map_priv_1 + ofs);
+}
+
+static __u16 dsr_read16(struct map_info *map, unsigned long ofs)
+{
+	return *(volatile __u16 *) (map->map_priv_1 + ofs);
+}
+
+static __u32 dsr_read32(struct map_info *map, unsigned long ofs)
+{
+	return *(volatile __u32 *) (map->map_priv_1 + ofs);
+}
+
+static void dsr_copy_from(struct map_info *map, void *to, unsigned long from, ssize_t len)
+{
+	memcpy(to, (void *) (map->map_priv_1 + from), len);
+}
+
+static void dsr_write8(struct map_info *map, __u8 d, unsigned long adr)
+{
+	*(volatile __u8 *) (map->map_priv_1 + adr) = d;
+}
+
+static void dsr_write16(struct map_info *map, __u16 d, unsigned long adr)
+{
+	*(volatile __u16 *) (map->map_priv_1 + adr) = d;
+}
+
+static void dsr_write32(struct map_info *map, __u32 d, unsigned long adr)
+{
+	*(volatile __u32 *) (map->map_priv_1 + adr) = d;
+}
+
+static void dsr_copy_to(struct map_info *map, unsigned long to, const void *from, ssize_t len)
+{
+	memcpy((void *) (map->map_priv_1 + to), from, len);
+}
+
+static struct map_info dsr_map = {
+	name:		"DSR9500 flash",
+	size:		ST20_FLASH_SIZE,
+	buswidth:	2,
+	read8:		dsr_read8,
+	read16:		dsr_read16,
+	read32:		dsr_read32,
+	copy_from:	dsr_copy_from,
+	write8:		dsr_write8,
+	write16:	dsr_write16,
+	write32:	dsr_write32,
+	copy_to:	dsr_copy_to,
+	map_priv_1:	ST20_FLASH_START,
+};
+
+static struct mtd_partition dsr_parts[] = {
+	{ name: "kernel", offset: ST20_FLASH_KERNEL, size: ST20_FLASH_ROMFS - ST20_FLASH_KERNEL },
+	{ name: "romfs", offset: ST20_FLASH_ROMFS, size: ST20_FLASH_JFFS2 - ST20_FLASH_ROMFS },
+	{ name: "jffs2", offset: ST20_FLASH_JFFS2, size: ST20_FLASH_BOOT - ST20_FLASH_JFFS2 },
+	{ name: "boot", offset: ST20_FLASH_BOOT, size: ST20_FLASH_SIZE - ST20_FLASH_BOOT,
+	  mask_flags: MTD_WRITEABLE },
+};
+
+static struct mtd_info *dsr_mtd;
+
+/* 1 if the flash takes plain stores (st20emu), leaving the array as it was */
+static int __init flash_is_ram(void)
+{
+	volatile __u16 *p = (volatile __u16 *) ST20_FLASH_START;
+	__u16 old;
+	int ram;
+
+	if (*p == 0xf0f0)
+		p++;
+	old = *p;
+	*p = 0xf0f0;			/* AMD read/reset command */
+	ram = *p == 0xf0f0;
+	if (ram)
+		*p = old;
+	return ram;
+}
+
+int __init dsr9500_flash_init(void)
+{
+	const char *how;
+
+	if (flash_is_ram()) {
+		dsr_mtd = do_map_probe("map_ram", &dsr_map);
+		if (dsr_mtd)
+			dsr_mtd->erasesize = 0x10000;
+		how = "RAM-like (emulator), map_ram";
+	} else {
+		how = "CFI";
+		dsr_mtd = do_map_probe("cfi_probe", &dsr_map);
+		if (!dsr_mtd) {
+			how = "JEDEC";
+			dsr_mtd = do_map_probe("jedec_probe", &dsr_map);
+		}
+		if (!dsr_mtd) {
+			how = "unknown chip, read-only";
+			dsr_mtd = do_map_probe("map_rom", &dsr_map);
+		}
+	}
+	if (!dsr_mtd) {
+		printk("DSR9500 flash: no MTD driver\n");
+		return -ENXIO;
+	}
+	dsr_mtd->module = THIS_MODULE;
+	printk("DSR9500 flash: %ld KB at 0x%08lx, %s, erase block %d KB\n",
+	       ST20_FLASH_SIZE >> 10, ST20_FLASH_START, how, dsr_mtd->erasesize >> 10);
+	return add_mtd_partitions(dsr_mtd, dsr_parts, sizeof(dsr_parts) / sizeof(dsr_parts[0]));
+}
+
+module_init(dsr9500_flash_init);
+MODULE_LICENSE("GPL");
