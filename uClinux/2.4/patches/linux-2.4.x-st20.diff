+
+/*
+ * ST20: no protection without an MMU, so a system call is an indirect call through the
+ * kernel's entry pointer stored at ST20_SYSCALL_VECTOR (arch/st20/kernel/entry.ast):
+ * (nr, a, b, c, d, e) -> result, a plain gcc-t800 call.  6-argument calls (mmap2; ipc
+ * SEMTIMEDOP and MSGRCV version 1) pass a 7th word f: (nr, a, b, c, d, e, f); the kernel
+ * reads that word only for them (arch/st20/kernel/syscalls.c six_args), so 6-word callers
+ * stay valid for everything else.
+ * The kernel's own calls go to the dispatcher directly.
+ */
+#define ST20_SYSCALL_VECTOR 0xc0000000UL
+
+typedef long (*__st20_syscall_t)(long, long, long, long, long, long);
+typedef long (*__st20_syscall6_t)(long, long, long, long, long, long, long);
+
