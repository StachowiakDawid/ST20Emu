@@ -0,0 +1,124 @@
+/*
+ * arch/st20/kernel/ksyms.c - kernel functions kept for loadable modules
+ *
+ * lit drops every fragment nothing refers to, so a function only modules call would
+ * not be in the kernel (or its linux.map, against which modules are linked).  This table
+ * refers to those that modules commonly need (module.c refers to the table); everything
+ * else the kernel already uses is available too.  Only functions the kernel has anyway
+ * are listed (each extra one costs flash: add e.g. request_irq, register_netdev, sscanf
+ * here when a module needs them).  No headers: the declarations are
+ * only for taking the addresses.
+ */
+extern char printk;
+extern char sprintf;
+extern char snprintf;
+extern char vsprintf;
+extern char simple_strtoul;
+extern char simple_strtol;
+extern char memcpy;
+extern char memset;
