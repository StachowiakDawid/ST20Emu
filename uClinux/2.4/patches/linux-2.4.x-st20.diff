diff --git a/linux-2.4.x/arch/st20/kernel/time.c b/linux-2.4.x/arch/st20/kernel/time.c
new file mode 100644
index 000000000..2c8e7e518
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/time.c
@@ -0,0 +1,214 @@
+/*
+ * arch/st20/kernel/time.c - timer tick and preemption for uClinux/ST20
+ *
+ * The whole kernel is one low-priority ST20 process.  The tick is st20_tick_proc
+ * (entry.ast), a high-priority process that waits 1 ms on the 1 MHz high-priority timer
+ * and calls st20_tick_hp (a jiffy every 10th time, HZ = 100).  Waking up, it preempts the
+ * low-priority kernel, whose registers the CPU then keeps in the low-priority shadow bank.
+ * st20_tick_hp counts the tick and, unless a preemption is already being handled,
+ * redirects the kernel like OS20 does when an interrupt preempts a task (os20
+ * c2c4/ksuspend.c): stshadow saves the kernel's state record (enables, status, Wptr, Iptr,
+ * Areg-Creg) into a frame below its Wptr, and ldshadow points it at st20_preempt.  When the
+ * high-priority side deschedules, the kernel continues in st20_preempt, which runs
+ * st20_preempt_c (do_timer, interrupts, softirqs, schedule) and resumes the interrupted
+ * code with `restart` on the saved record.
+ *
+ * This works at any instruction boundary (gcc-t800 loops often have no j, so timeslicing
+ * would not do).  cli() clears the low-priority process-interrupt enable, so high priority
+ * cannot preempt a critical section; the tick then waits until sti().
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/time.h>
+#include <linux/timex.h>
+#include <linux/interrupt.h>
+#include <linux/mm.h>
+#include <linux/init.h>
+#include <asm/system.h>
+#include <asm/ptrace.h>
+#include <asm/hardirq.h>
+#include <asm/softirq.h>
+
+#define LOW_PRIORITY		1
+#define HIGH_PRIORITY		0
+#define ST20_STATUS_VALID	0x80000000UL	/* status: a process was running */
+#define ST20_STATUS_INTERRUPTED	0x7c000000UL	/* status: inside an interruptible op */
+#define ST20_TRAP_REASON	0x00003fffUL	/* status: trap reason bits */
+#define SHADOW_CONTROL		2		/* status, Wptr, Iptr */
+#define SHADOW_STATE		7		/* enables, status, Wptr, Iptr, Areg-Creg */
+
+extern void st20_tick_proc(void), st20_preempt(void);
+extern void st20_do_irqs(struct pt_regs *regs);
+extern volatile unsigned long st20_irq_pending;
+
+extern rwlock_t xtime_lock;
+
+volatile unsigned long st20_ticks_pending;
+volatile int st20_preempting;		/* the kernel is redirected to st20_preempt */
+
+static unsigned long tick_ws[256];	/* high-priority tick process */
+
+static inline void st20_runp(unsigned long descriptor)
+{
+	__asm__ __volatile__ ("runp" : : "aP" (descriptor) : "memory");
+}
+
+static inline unsigned long st20_clockenb(unsigned long mask)
+{
+	unsigned long old;
+	__asm__ __volatile__ ("clockenb" : "=a" (old) : "aP" (mask) : "memory");
+	return old;
+}
+
+static inline void st20_stshadow(unsigned long sel, unsigned long prio, unsigned long *buf)
+{
+	__asm__ __volatile__ ("stshadow" : : "cP" (buf), "bP" (prio), "aP" (sel) : "memory");
+}
+
+static inline void st20_ldshadow(unsigned long sel, unsigned long prio, unsigned long *buf)
+{
+	__asm__ __volatile__ ("ldshadow" : : "cP" (buf), "bP" (prio), "aP" (sel) : "memory");
+}
+
+/* Wptr w is on the current task's kernel stack (else: user code, or a vfork stack copy) */
+static inline int on_kernel_stack(unsigned long w)
+{
+	return w <= st20_kstack && st20_kstack - w <= THREAD_SIZE - sizeof(struct task_struct);
+}
+
+/*
+ * Points the preempted low-priority kernel at st20_preempt (high priority only).  The
+ * frame f lies below the kernel's Wptr (free workspace on ST20), or near the top of the
+ * task's kernel stack when user code was running; f[4..10] receives the state record.
+ */
+void st20_redirect_lp(void)
+{
+	unsigned long sh[4], *f, w;
+	int user;
+
+	if (st20_preempting)
+		return;
+	st20_stshadow(SHADOW_CONTROL, LOW_PRIORITY, sh);
+	if (!(sh[1] & ST20_STATUS_VALID) || (sh[1] & ST20_STATUS_INTERRUPTED))
+		return;			/* not running / inside a block move: next tick */
+	w = sh[2];
+	user = !on_kernel_stack(w);
+	if (!user)
+		f = (unsigned long *) (w - 128);
+	else
+		f = (unsigned long *) (st20_kstack - 128);
+	f[1] = user;
+	st20_stshadow(SHADOW_STATE, LOW_PRIORITY, &f[4]);
+	f[5] &= ~ST20_TRAP_REASON;
+	sh[2] = (unsigned long) f;
+	sh[3] = (unsigned long) st20_preempt;
+	st20_ldshadow(SHADOW_CONTROL, LOW_PRIORITY, sh);
+	st20_preempting = 1;
+}
+
+/* high-priority tick (from st20_tick_proc).  High-priority external events (device
+   interrupts, irq.c) are off meanwhile: their handlers redirect the kernel too. */
+#define ST20_HP_EXTERNAL	0x40	/* gintdis/gintenb mask bit 6 = Enables bit 22 */
+
+static int tick_div;
+int (*st20_tick_hook)(void);		/* 1 ms high-priority work (front panel), or 0 */
+void (*st20_tick_lp_hook)(void);	/* its low-priority part */
+
+void st20_tick_hp(void)
+{
+	unsigned long old = __st20_gintdis(ST20_HP_EXTERNAL);
+	int work = st20_tick_hook ? st20_tick_hook() : 0;
+
+	if (++tick_div >= 10) {			/* every 10 ms: a jiffy */
+		tick_div = 0;
+		st20_ticks_pending++;
+		work = 1;
+	}
+	if (work)
+		st20_redirect_lp();
+	if (old & ST20_HP_EXTERNAL)
+		__st20_gintenb(ST20_HP_EXTERNAL);
+}
+
+extern int st20_handle_signals(unsigned long *u, struct st20_syscall_restart *sc);
+
+/*
+ * The work of a timer/device interrupt, at low priority (from st20_preempt).  f is the
+ * redirect frame: f[1] = user code was interrupted, f[4..10] = its state record, which
+ * `restart` resumes; a signal for user code is delivered by changing that record.
+ */
+void st20_preempt_c(unsigned long *f)
+{
+	struct pt_regs regs;
+	unsigned long flags, n;
+	int user = f[1] && current->mm != NULL;
+
+	memset(&regs, 0, sizeof(regs));
+	regs.orig_nr = -1;
+	regs.iptr = f[7];
+	regs.wptr = f[6];
+	if (user)
+		regs.status = PS_USER;
+
+	irq_enter(0, 0);
+	for (;;) {
+		__save_and_cli(flags);
+		n = st20_ticks_pending;
+		st20_ticks_pending = 0;
+		__restore_flags(flags);
+		while (n--)
+			do_timer(&regs);
+		if (st20_tick_lp_hook)
+			st20_tick_lp_hook();
+		if (!st20_irq_pending)
+			break;
+		st20_do_irqs(&regs);
+	}
+	irq_exit(0, 0);
+	st20_preempting = 0;
+
+	if (softirq_pending(0))
+		do_softirq();
+	/* only user code is preempted: kernel code is not preemptible (e.g. a task between
+	   "state = TASK_INTERRUPTIBLE" and its own schedule() would be dropped from the run
+	   queue and never woken); kernel code reschedules on return to user mode */
+	if (user && current->need_resched)
+		schedule();
+	if (user && signal_pending(current)) {
+		/* record: enables, status, Wptr, Iptr, Areg, Breg, Creg */
+		if (st20_handle_signals(&f[6], NULL))
+			f[5] &= ~ST20_TRAP_REASON;
+	}
+}
+
+void __init time_init(void)
+{
+	xtime.tv_sec = 0;
+	xtime.tv_usec = 0;
+
+	st20_clockenb(3);	/* both timers (already running after reset on st20emu) */
+	/* Wptr = &tick_ws[240]: the process keeps its deadline in W[1] and calls C below Wptr */
+	tick_ws[240 - 1] = (unsigned long) st20_tick_proc;	/* W[-1] = Iptr */
+	st20_runp((unsigned long) &tick_ws[240] | HIGH_PRIORITY);
+}
+
+void do_gettimeofday(struct timeval *tv)
+{
+	unsigned long flags;
+
+	read_lock_irqsave(&xtime_lock, flags);
+	*tv = xtime;
+	read_unlock_irqrestore(&xtime_lock, flags);
+}
+
+void do_settimeofday(struct timeval *tv)
+{
+	write_lock_irq(&xtime_lock);
+	xtime = *tv;
+	time_adjust = 0;
+	time_status |= STA_UNSYNC;
+	time_maxerror = NTP_PHASE_LIMIT;
+	time_esterror = NTP_PHASE_LIMIT;
+	write_unlock_irq(&xtime_lock);
+}
diff --git a/linux-2.4.x/arch/st20/kernel/traps.c b/linux-2.4.x/arch/st20/kernel/traps.c
new file mode 100644
index 000000000..2ccbc9510
--- /dev/null
+++ b/linux-2.4.x/arch/st20/kernel/traps.c
@@ -0,0 +1,191 @@
+/*
+ * arch/st20/kernel/traps.c - error traps for uClinux/ST20
+ *
+ * The low-priority error trap groups run st20_error_trap1/2 (entry.ast) on their own
+ * workspace.  Without an MMU nothing stops a user program from executing garbage, but these
+ * traps at least turn the usual results of that into a signal for the program instead of a
+ * hung board.  A fatal trap in kernel code is a panic.
+ *
+ * Trap records: 0x80000040 + priority * 0x80 + group * 0x20, +0x10 for the trapped process
+ * (enables, status, Wptr, Iptr; Iptr = after the trapping instruction).  Group 1 (error):
+ * IntegerError (cb, csub0, ...: range checks gcc-t800 does not emit) and IntegerOverflow;
+ * group 2 (system): IllegalOpcode.
+ *
+ * Integer division by zero: on the ST20-C2 `div` and `rem` (and `ldiv`, Creg >= Areg)
+ * signal IntegerOverflow, the same error as an overflowing add, adc, sub, mul, ladd, lsub
+ * or fmul -- and gcc-t800 emits add/adc/sub for wrapping C arithmetic (hashes, checksums,
+ * time comparisons), so the trap cannot simply be fatal.  The overflow trap is enabled for
+ * low priority and the handler decodes the trapping instruction from the bytes before the
+ * trapped Iptr: `22 FC` (div), `21 FF` (rem) or `21 FA` (ldiv), not preceded by a further
+ * pfix/nfix byte, is a division error -> SIGFPE (si_code FPE_INTDIV, si_addr = the
+ * instruction) for user code, a panic in the kernel.  Any other instruction continues
+ * exactly: the result is the wrapped value (as without the trap), and entry.ast restores
+ * Areg-Creg before `tret`.  The last byte identifies the instruction: an `opr` with
+ * operand 0x2C/0x1F/0x1A needs exactly that pfix byte, and a single-byte sub (FC) or the
+ * other overflow ops end in a different byte or follow no 0x22/0x21 pfix.  `div` by -1 of
+ * MostNeg (overflow, not by zero) also gives SIGFPE, as on i386.  The handler runs with
+ * all enables off (descriptor word 0), so it is not preempted.  st20_ovf_traps counts the
+ * continued overflow traps (/proc/cpuinfo).
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/signal.h>
+#include <linux/mm.h>
+#include <linux/init.h>
+#include <asm/system.h>
+#include <asm/ptrace.h>
+#include <asm/uaccess.h>
+
+#define LP_TRAP_HANDLER(g)	((volatile unsigned long *) (0x800000c0UL + (g) * 0x20))
+#define LP_TRAP_TRAPPED(g)	((volatile unsigned long *) (0x800000d0UL + (g) * 0x20))
+#define INTEGER_ERR_TRAPENB	0x02
+#define INTEGER_OVF_TRAPENB	0x04
+#define ILL_OPCODE_TRAPENB	0x08
+#define ST20_STATUS_VALID	0x80000000UL
+#define ST20_TRAP_REASON	0x00003fffUL
+
+extern void st20_error_trap1(void), st20_error_trap2(void), st20_trap_kill(void);
+extern void st20_resume_user(unsigned long *u);
+extern int st20_handle_signals(unsigned long *u, struct st20_syscall_restart *sc);
+extern unsigned long st20_kstack;
+extern char _stext, __init_end;		/* kernel code: text + init segments */
+
+static unsigned long trap_ws[2][256];
+
+unsigned long st20_ovf_traps;		/* overflow traps continued (wrapping arithmetic) */
+unsigned long st20_fpe_traps;		/* division errors */
+
+/* the fault, for st20_trap_kill_c: Wptr, Iptr, Areg-Creg, cause, instruction address */
+static unsigned long fault_state[5], fault_cause, fault_addr;
+
+static inline unsigned long st20_trapenb(unsigned long priority, unsigned long mask)
+{
+	unsigned long old;
+	__asm__ __volatile__ ("trapenb" : "=a" (old) : "bP" (priority), "aP" (mask) : "memory");
+	return old;
+}
+
+/* is the instruction that ends just before iptr div, rem or ldiv? */
+static int division_insn(unsigned long iptr)
+{
+	unsigned char *p = (unsigned char *) iptr;
+	unsigned char op, pf, before;
+
+	if (!access_ok(VERIFY_READ, p - 3, 3))
+		return 0;
+	op = p[-1];
+	pf = p[-2];
+	before = p[-3] & 0xf0;
+	if (before == 0x20 || before == 0x60)	/* a longer pfix/nfix chain: other opr */
+		return 0;
+	return (pf == 0x22 && op == 0xfc) || (pf == 0x21 && (op == 0xff || op == 0xfa));
+}
+
+/* trap handler body: low priority, trap workspace, all enables off; regs = Areg-Creg
+   of the trapped code (group 1 only), restored by entry.ast after a plain return */
+void st20_error_trap_c(int group, unsigned long *regs)
+{
+	volatile unsigned long *trapped = LP_TRAP_TRAPPED(group);
+	unsigned long status = trapped[1];
+	unsigned long iptr = trapped[3];
+	unsigned long cause = status & ST20_TRAP_REASON;
+	unsigned long *f;
+	int kernel = iptr >= (unsigned long) &_stext && iptr < (unsigned long) &__init_end;
+
+	if (cause & INTEGER_OVF_TRAPENB) {
+		if (!division_insn(iptr)) {
+			st20_ovf_traps++;
+			trapped[1] = status & ~ST20_TRAP_REASON;
+			return;			/* wrapped result: continue */
+		}
+		st20_fpe_traps++;
+		if (kernel)
+			panic("ST20 division by zero in kernel at %08lx (Wptr %08lx)",
+			      iptr - 2, trapped[2]);
+	}
+	if (kernel)
+		panic("ST20 %s in kernel at %08lx (Wptr %08lx)",
+		      (cause & ILL_OPCODE_TRAPENB) ? "illegal instruction" : "integer error",
+		      iptr, trapped[2]);
+	fault_cause = cause;
+	fault_addr = (cause & INTEGER_OVF_TRAPENB) ? iptr - 2 : iptr;
+	fault_state[0] = trapped[2];
+	fault_state[1] = iptr;
+	fault_state[2] = regs ? regs[0] : 0;
+	fault_state[3] = regs ? regs[1] : 0;
+	fault_state[4] = regs ? regs[2] : 0;
+	/* continue in st20_trap_kill on the task's kernel stack */
+	f = (unsigned long *) (st20_kstack - 128);
+	trapped[1] = (status | ST20_STATUS_VALID) & ~ST20_TRAP_REASON;
+	trapped[2] = (unsigned long) f;
+	trapped[3] = (unsigned long) st20_trap_kill;
+}
+
+/*
+ * A fatal trap in user code, at low priority on the kernel stack: signal the task
+ * (catchable; a handler that returns continues after the faulting instruction, Areg
+ * undefined), deliver it at once and continue the user code exactly.
+ */
+void st20_trap_kill_c(void)
+{
+	unsigned long u[5];
+	struct siginfo info;
+	int i, sig;
+
+	sti();
+	for (i = 0; i < 5; i++)
+		u[i] = fault_state[i];
+	memset(&info, 0, sizeof(info));
+	if (fault_cause & ILL_OPCODE_TRAPENB) {
+		sig = SIGILL;
+		info.si_code = ILL_ILLOPC;
+	} else if (fault_cause & INTEGER_OVF_TRAPENB) {
+		sig = SIGFPE;
+		info.si_code = FPE_INTDIV;
+	} else {
+		sig = SIGFPE;
+		info.si_code = FPE_INTOVF;	/* IntegerError: a range check */
+	}
+	info.si_signo = sig;
+	info.si_addr = (void *) fault_addr;
+	if (current->sig->action[sig-1].sa.sa_handler == SIG_DFL)
+		printk("pid %d (%s): %s at %08lx, killed\n", current->pid, current->comm,
+		       sig == SIGILL ? "illegal instruction" :
+		       info.si_code == FPE_INTDIV ? "division by zero" : "integer error",
+		       fault_addr);
+	force_sig_info(sig, &info, current);
+	if (!st20_handle_signals(u, NULL))
+		do_exit(sig);	/* (not reached: force_sig_info unblocks, SIG_DFL kills) */
+	st20_resume_user(u);
+}
+
+void __init trap_init(void)
+{
+	/* handler descriptors: enables 0 (all off while it runs), status, Wptr, Iptr */
+	LP_TRAP_HANDLER(1)[0] = 0;
+	LP_TRAP_HANDLER(1)[1] = 0;
+	LP_TRAP_HANDLER(1)[2] = (unsigned long) &trap_ws[0][240];
+	LP_TRAP_HANDLER(1)[3] = (unsigned long) st20_error_trap1;
+	LP_TRAP_HANDLER(2)[0] = 0;
+	LP_TRAP_HANDLER(2)[1] = 0;
+	LP_TRAP_HANDLER(2)[2] = (unsigned long) &trap_ws[1][240];
+	LP_TRAP_HANDLER(2)[3] = (unsigned long) st20_error_trap2;
+	st20_trapenb(1, ILL_OPCODE_TRAPENB | INTEGER_ERR_TRAPENB | INTEGER_OVF_TRAPENB);
+}
+
+void die_if_kernel(char *str, struct pt_regs *regs, long err)
+{
+	if (regs && user_mode(regs))
+		return;
+	printk("%s: %08lx\n", str, err);
+	if (regs)
+		show_regs(regs);
+	do_exit(SIGSEGV);
+}
+
+/* sysrq / show_task: no stack unwinding on ST20 (workspace frames carry no links) */
+void show_trace_task(struct task_struct *tsk)
+{
+	printk("  ksp %08lx resume %08lx\n", tsk->thread.ksp, thread_saved_pc(&tsk->thread));
+}
+
