diff --git a/linux-2.4.x/include/asm-st20/system.h b/linux-2.4.x/include/asm-st20/system.h
new file mode 100644
index 000000000..4b9d4a79c
--- /dev/null
+++ b/linux-2.4.x/include/asm-st20/system.h
@@ -0,0 +1,115 @@
+#ifndef _ST20_SYSTEM_H
+#define _ST20_SYSTEM_H
+
+#include <linux/config.h>
+#include <linux/linkage.h>
+
+/*
+ * The whole kernel runs as one low-priority ST20 process.  "Interrupts off" means: no
+ * high-priority preemption, no timeslice trap and no external interrupt at low priority,
+ * i.e. the low three global interrupt enables (gintdis/gintenb mask bits 0-2).
+ */
+#define ST20_LP_ENABLES 7UL
+
+static inline unsigned long __st20_gintdis(unsigned long mask)
+{
+	unsigned long old;
+	__asm__ __volatile__ ("gintdis" : "=a" (old) : "aP" (mask) : "memory");
+	return old;
+}
+
+static inline unsigned long __st20_gintenb(unsigned long mask)
+{
+	unsigned long old;
+	__asm__ __volatile__ ("gintenb" : "=a" (old) : "aP" (mask) : "memory");
+	return old;
+}
+
+#define __save_flags(x)	((x) = __st20_gintdis(0))
+#define __cli()		((void) __st20_gintdis(ST20_LP_ENABLES))
+#define __sti()		((void) __st20_gintenb(ST20_LP_ENABLES))
+#define __restore_flags(x) \
+	do { unsigned long __f = (x) & ST20_LP_ENABLES; \
+	     (void) __st20_gintdis(ST20_LP_ENABLES); \
+	     if (__f) (void) __st20_gintenb(__f); } while (0)
+#define __save_and_cli(x)	do { __save_flags(x); __cli(); } while (0)
+#define __save_and_sti(x)	do { __save_flags(x); __sti(); } while (0)
+
+#define local_irq_save(x)	__save_and_cli(x)
+#define local_irq_set(x)	__save_and_sti(x)
+#define local_irq_restore(x)	__restore_flags(x)
+#define local_irq_disable()	__cli()
+#define local_irq_enable()	__sti()
+
+#define cli()			__cli()
+#define sti()			__sti()
+#define save_flags(x)		__save_flags(x)
+#define restore_flags(x)	__restore_flags(x)
+#define save_and_cli(x)		__save_and_cli(x)
+#define save_and_set(x)		__save_and_sti(x)
+
+#define nop()	__asm__ __volatile__ ("nop" : : : "memory")
+#define mb()	__asm__ __volatile__ ("" : : : "memory")
+#define rmb()	mb()
+#define wmb()	mb()
+#define set_mb(var, value)	do { var = value; mb(); } while (0)
+#define set_wmb(var, value)	do { var = value; wmb(); } while (0)
+#define smp_mb()	barrier()
+#define smp_rmb()	barrier()
+#define smp_wmb()	barrier()
+
+#define prepare_to_switch()	do { } while (0)
+
+/*
+ * switch_to: arch/st20/kernel/entry.ast st20_resume saves the Wptr (whose word 0 is the
+ * resume Iptr) in prev->thread.ksp and continues next.  current and the kernel stack top
+ * (st20_kstack, used by the system call entry and the preemption redirect) are switched
+ * with it; last = the task that switched back to us.
+ */
+struct task_struct;
+struct thread_struct;
+asmlinkage void st20_resume(struct thread_struct *prev, struct thread_struct *next);
+extern struct task_struct *_current_task, *st20_last_task;
+extern unsigned long st20_kstack;
+
+#define switch_to(prev,next,last) do { \
+	unsigned long __sf; \
+	__save_and_cli(__sf); \
+	st20_last_task = (prev); \
+	_current_task = (next); \
+	st20_kstack = (unsigned long) (next) + THREAD_SIZE; \
+	st20_resume(&(prev)->thread, &(next)->thread); \
+	(last) = st20_last_task; \
+	__restore_flags(__sf); \
+} while (0)
+
+static inline unsigned long __xchg(unsigned long x, volatile void *ptr, int size)
+{
+	unsigned long tmp = 0, flags;
+
+	__save_and_cli(flags);
+	switch (size) {
+	case 1:
+		tmp = *(volatile unsigned char *) ptr;
+		*(volatile unsigned char *) ptr = x;
+		break;
+	case 2:
+		tmp = *(volatile unsigned short *) ptr;
+		*(volatile unsigned short *) ptr = x;
+		break;
+	case 4:
+		tmp = *(volatile unsigned long *) ptr;
+		*(volatile unsigned long *) ptr = x;
+		break;
+	}
+	__restore_flags(flags);
+	return tmp;
+}
+
+#define xchg(ptr,x) ((__typeof__(*(ptr)))__xchg((unsigned long)(x),(ptr),sizeof(*(ptr))))
+#define tas(ptr) (xchg((ptr),1))
+
+extern void st20_reboot(void);
+#define HARD_RESET_NOW() st20_reboot()
+
+#endif /* _ST20_SYSTEM_H */
