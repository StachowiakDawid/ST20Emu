+/* sys/ucontext.h for uClinux/ST20: the user state at a signal is Wptr, Iptr, Areg, Breg,
+   Creg (arch/st20/kernel/signal.c); getcontext and friends are not implemented. */
+#ifndef _SYS_UCONTEXT_H
+#define _SYS_UCONTEXT_H	1
+
+#include <features.h>
+#include <signal.h>
+
+typedef int greg_t;
+
+/* Number of general registers.  */
+#define NGREG	5
+
+/* Container for all general registers.  */
+typedef greg_t gregset_t[NGREG];
+
+#ifdef __USE_GNU
+enum
+{
+  REG_WPTR = 0,
+#define REG_WPTR	REG_WPTR
+  REG_IPTR = 1,
+#define REG_IPTR	REG_IPTR
+  REG_AREG = 2,
+#define REG_AREG	REG_AREG
+  REG_BREG = 3,
+#define REG_BREG	REG_BREG
+  REG_CREG = 4
+#define REG_CREG	REG_CREG
+};
+#endif
+
+/* Context to describe whole processor state.  */
+typedef struct
+  {
+    gregset_t gregs;
+  } mcontext_t;
+
+/* Userlevel context.  */
+typedef struct ucontext
+  {
+    unsigned long int uc_flags;
+    struct ucontext *uc_link;
+    stack_t uc_stack;
+    mcontext_t uc_mcontext;
+    __sigset_t uc_sigmask;
+  } ucontext_t;
+
+#endif /* sys/ucontext.h */
