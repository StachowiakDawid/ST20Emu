+
+TOPDIR=../../../../
+include $(TOPDIR)Rules.mak
+
+# hand-written assembly is *.ast, assembled by ast (no preprocessor)
+AST=ast
+
+UCLIBC_CTOR_DTOR=n
+
+CRT0_OBJ = crt0.o
+CTOR_TARGETS=$(TOPDIR)lib/crti.o $(TOPDIR)lib/crtn.o
+
+SSRC=setjmp.ast vfork.ast
+SOBJS=$(patsubst %.ast,%.o, $(SSRC))
+
+CSRC=
+COBJS=$(patsubst %.c,%.o, $(CSRC))
+
+OBJS=$(SOBJS) $(COBJS)
+
+all: $(OBJS) $(LIBC)
+
+$(LIBC): ar-target
+
+ar-target: $(OBJS) $(CRT0_OBJ) $(CTOR_TARGETS)
+	$(AR) $(ARFLAGS) $(LIBC) $(OBJS)
+	$(INSTALL) -d $(TOPDIR)lib/
+	cp $(CRT0_OBJ) $(TOPDIR)lib/
+	cp $(TOPDIR)lib/crt0.o $(TOPDIR)lib/crt1.o
+
+$(CRT0_OBJ): crt0.ast
+	$(AST) -o $@ $<
+
+$(SOBJS): %.o : %.ast
+	$(AST) -o $@ $<
+
+$(COBJS): %.o : %.c
+	$(CC) $(CFLAGS) -c $< -o $@
+
+# no .init/.fini sections in lit: empty crti.o/crtn.o archives for the gcc driver
+$(TOPDIR)lib/crti.o:
+	$(INSTALL) -d $(TOPDIR)lib/
+	$(AR) $(ARFLAGS) $(TOPDIR)lib/crti.o
+$(TOPDIR)lib/crtn.o:
+	$(INSTALL) -d $(TOPDIR)lib/
+	$(AR) $(ARFLAGS) $(TOPDIR)lib/crtn.o
+
+headers:
+
+clean:
+	$(RM) *.[oa] *~ core
