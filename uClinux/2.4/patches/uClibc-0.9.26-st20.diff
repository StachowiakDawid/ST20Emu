--- uClibc-0.9.26/libc/sysdeps/linux/st20/vfork.ast	1970-01-01 01:00:00
+++ uClibc-0.9.26/libc/sysdeps/linux/st20/vfork.ast	2026-11-12 02:05:25
@@ -0,0 +1,47 @@
+// libc/sysdeps/linux/st20/vfork.ast - vfork() (and fork(): no MMU, fork = vfork)
+//
+// Called like any function: W[0] = return Iptr, W[1..3] are this function's (argument
+// slots).  It makes a 4-word frame below W for the system call (W'[0] = Lret, W'[1] =
+// __NR_vfork) and jumps (gcall) into the kernel entry stored at 0xc0000000, which takes
+// W' as the caller's frame and continues as `ret` from it would: at Lret with Wptr = W
+// and Areg = the result.  The vfork child continues the same way on its copy of the stack
+// (arch/st20/kernel/process.c copy_vfork_stack).  Signal frames go below Wptr, i.e. over
+// W', which is dead by then; W[1] (ours) holds the result.  A result in -4095..-1 is an
+// error: errno = -result, return -1.
+.globl __errno;
+.text
+.globl _vfork;
+_vfork:
+	ajw -4
+	ldc 190		// __NR_vfork
+	stl 1
+	ldc Lret-Lh
+	ldpi
+Lh:
+	stl 0		// W'[0] = Lret: the kernel returns there
+	ldc -1073741824	// 0xc0000000: the kernel entry pointer
+	ldnl 0
+	gcall
+Lret:
+	stl 1		// Wptr = W again (kernel `ret` from W'): W[1] = result
+	ldl 1
+	ldc -4096
+	gtu		// result >u -4096: an error code
+	cj Lok
+	ldc 0
+	ldl 1
+	diff		// -result
+	ldc __errno-Le
+	ldpi
+Le:
+	stnl 0		// errno (uClibc's _errno)
+	ldc -1
+	ret
+Lok:
+	ldl 1
+	ret
+
+.globl _fork;
+_fork = _vfork
+.globl ___libc_fork;
+___libc_fork = _vfork
