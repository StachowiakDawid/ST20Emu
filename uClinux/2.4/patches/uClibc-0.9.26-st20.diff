--- uClibc-0.9.26/libc/sysdeps/linux/st20/setjmp.ast	1970-01-01 01:00:00
+++ uClibc-0.9.26/libc/sysdeps/linux/st20/setjmp.ast	2026-11-11 20:46:49
@@ -0,0 +1,69 @@
+// libc/sysdeps/linux/st20/setjmp.ast - setjmp/longjmp for uClibc on uClinux/ST20
+// (gcc-t800 generic model).  After `call`: W[0] = return Iptr, W[1..3] = arguments.
+// __jmpbuf[0] = the caller's Wptr after the return (W + 4 words), [1] = return Iptr.
+// No registers survive a call, so that is the whole machine context; the signal mask
+// part is done by __sigjmp_save (C), called with our own W as its caller's frame.
+// lit: one global label per fragment, aliases are assignments.
+.text
+.globl ___sigjmp_save;
+
+// int __sigsetjmp(jmp_buf env, int savemask)
+.globl ___sigsetjmp;
+___sigsetjmp:
+	ldl 0
+	ldl 1
+	stnl 1
+	ldlp 4
+	ldl 1
+	stnl 0
+	ldl 2		// savemask
+	ldl 1		// env
+	call ___sigjmp_save	// returns 0
+	ret
+
+// int setjmp(jmp_buf env) = __sigsetjmp(env, 1)
+.globl _setjmp;
+_setjmp:
+	ldl 0
+	ldl 1
+	stnl 1
+	ldlp 4
+	ldl 1
+	stnl 0
+	ldc 1
+	ldl 1
+	call ___sigjmp_save
+	ret
+
+// int _setjmp(jmp_buf env) = __sigsetjmp(env, 0)
+.globl __setjmp;
+__setjmp:
+	ldl 0
+	ldl 1
+	stnl 1
+	ldlp 4
+	ldl 1
+	stnl 0
+	ldc 0
+	ldl 1
+	call ___sigjmp_save
+	ret
+
+// void __longjmp(__jmp_buf env, int val): continue at env[1] with Wptr = env[0] and
+// Areg = val (common/longjmp.c already made it nonzero), by building a call frame below
+// env[0] whose word 0 is the Iptr and returning through it.
+.globl ___longjmp;
+___longjmp:
+	ldl 1
+	ldnl 1
+	ldl 1
+	ldnl 0
+	adc -16
+	stnl 0
+	ldl 2
+	ldl 1
+	ldnl 0
+	adc -16
+	gajw
+	rev
+	ret
