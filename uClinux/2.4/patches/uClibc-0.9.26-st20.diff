+++ uClibc-0.9.26/libc/sysdeps/linux/st20/crt0.ast	2026-11-11 20:46:49
@@ -0,0 +1,42 @@
+// libc/sysdeps/linux/st20/crt0.ast - start of a uClinux/ST20 flat (bFLT) program, uClibc
+//
+// Linked at 0 = the first byte after the 64-byte bFLT header; text, data, bss back to back
+// (created in that order).  The kernel enters @@hook with Wptr = sp:
+// sp[0] = argc, sp[1..argc] = argv[], 0, envp[], 0 (fs/binfmt_flat.c, ST20 has no
+// argv/envp pointers on the stack).  gcc-t800: arguments 1..3 in Areg, Breg, Creg.
+.text
+.data
+.bss
+.text
+.globl text@@start;
+.globl text@@size;
+.globl data@@start;
+.globl data@@size;
+.globl bss@@start;
+.globl bss@@size;
+data@@start = text@@start + text@@size
+bss@@start = data@@start + data@@size
+
+// segment ends, read from the link map by tools/mkflat.py
+.globl __etext;
+__etext = text@@start + text@@size
+.globl __edata;
+__edata = data@@start + data@@size
+.globl __end;
+__end = bss@@start + bss@@size
+
+.globl ___uClibc_main;
+.globl @@hook;
+@@hook:
+	.need __etext
+	.need __edata
+	.need __end
+	ldl 0		// envp = &argv[argc + 1]
+	adc 2
+	ldlp 0
+	wsub
+	ldlp 1		// argv
+	ldl 0		// argc
+	call ___uClibc_main	// __uClibc_main(argc, argv, envp), does not return
+LC1:
+	j LC1
