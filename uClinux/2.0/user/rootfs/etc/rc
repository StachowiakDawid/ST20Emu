#!/bin/sh
# Run once by init (sysinit). Root is a read-only romfs in flash.
PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc
# writable /tmp: 512 KB minix file system on the RAM disk
mkfs.minix /dev/ram0 512 >/dev/null
mount -t minix /dev/ram0 /tmp
mkdir /tmp/var
echo "uCL " >/dev/panel
echo
echo "Welcome to uClinux 2.0.39 on the ST20 (Samsung DSR9500, STi5512)"
echo "busybox 0.60.5, /tmp is a RAM disk"
echo
