+++ ttools-2.0beta2/ast/scan.c	2026-11-12 01:29:05
@@ -4407,8 +4407,13 @@
 static void
 mk_string_space (int leng_requested)
 {
+    /* grow until the request fits: a single token (a run of plain
+       characters) can be longer than the doubled buffer */
     if (stringlenmax - stringlen < leng_requested) {
-	stringlenmax = stringlenmax? stringlenmax*2: 80;
+	if (stringlenmax == 0)
+	    stringlenmax = 80;
+	while (stringlenmax - stringlen < leng_requested)
+	    stringlenmax *= 2;
 	string = (char *) xrealloc (string, stringlenmax);
     }
 }
