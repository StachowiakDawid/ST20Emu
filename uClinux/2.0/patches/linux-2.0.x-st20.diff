diff --git a/linux-2.0.x/arch/st20/Rules.make b/linux-2.0.x/arch/st20/Rules.make
new file mode 100644
index 000000000..725cd4fed
--- /dev/null
+++ b/linux-2.0.x/arch/st20/Rules.make
@@ -0,0 +1,23 @@
+#
+# arch/st20/Rules.make: ST20 (DSR9500, STi5512) with gcc-2.7.2-t800 (t450) + ttools
+#
+CROSS_COMPILE = t450-
+AS      = ast
+LD      = st20-ldr
+AR      = ar
+NM      = true
+STRIP   = true
+OBJCOPY = true
+LIBGCC  = $(shell $(CC) -print-libgcc-file-name)
+
+CFLAGS := $(CFLAGS) -mt450 -DNO_MM -DNO_FPU -fsigned-char -DNO_FORGET \
+	-DUTS_SYSNAME='"uClinux"'
+AFLAGS := $(AFLAGS) -DNO_MM -DNO_FPU
+
+SUBDIRS := arch/$(ARCH)/kernel arch/$(ARCH)/mm arch/$(ARCH)/lib $(SUBDIRS)
+ARCHIVES := arch/$(ARCH)/kernel/kernel.o arch/$(ARCH)/mm/mm.o $(ARCHIVES)
+LIBS += arch/$(ARCH)/lib/lib.a $(LIBGCC)
+
+# kernel image: linked at 0xc0001000 (0xc0000000 holds the syscall vector)
+HEAD := arch/st20/kernel/head.o
+LINKFLAGS = -T 0xc0001000 -mlinux.map
