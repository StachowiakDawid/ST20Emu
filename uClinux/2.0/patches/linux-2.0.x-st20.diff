diff --git a/linux-2.0.x/arch/st20/kernel/console.c b/linux-2.0.x/arch/st20/kernel/console.c
new file mode 100644
index 000000000..f86d7fbe0
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/console.c
@@ -0,0 +1,74 @@
+/*
+ * arch/st20/kernel/console.c - the board's RS-232 port (DSR9500: ASC3 at 0x20006000) and
+ * the printk console on it.
+ *
+ * Set up as the original DSR9500 loader does (Decompilation/DSR9500 src/m_ab80.c asc_init):
+ * PIO4 bit 0 = TXD (alternate-function output), bit 1 = RXD (input); 115200 baud with a
+ * reload of 0x1b, or 0x20 when the configuration register's low six bits read 1 (the
+ * faster-clocked board version); 8 data bits, 1 stop, no parity, receiver on.  Done in
+ * setup_arch, so printk works on real hardware from the first line.  The tty driver
+ * (serial.c) adds interrupts and termios.
+ */
+#include <linux/kernel.h>
+#include <asm/board.h>
+#include <asm/st20asc.h>
+
+extern void register_console(void (*proc)(const char *));
+
+unsigned long st20_asc_clock;		/* ASC input clock = 16 * reload * baud, in Hz */
+
+void st20_asc_set_line(unsigned long baud, unsigned long ctrl)
+{
+	unsigned long reload = (st20_asc_clock + 8 * baud) / (16 * baud);
+
+	ASC(ASC_CTRL) = 0;
+	ASC(ASC_BAUD) = reload ? reload : 1;
+	ASC(ASC_CTRL) = ctrl;
+}
+
+void st20_asc_init(void)
+{
+	unsigned long reload;
+
+	/* PIO4 bit 0: PC2,PC1,PC0 = 1,1,0 (alternate output); bit 1: 1,0,0 (input) */
+	PIO4(PIO_CLR_PC0) = 3;
+	PIO4(PIO_SET_PC0) = 0;
+	PIO4(PIO_CLR_PC1) = 3;
+	PIO4(PIO_SET_PC1) = 1;
+	PIO4(PIO_CLR_PC2) = 3;
+	PIO4(PIO_SET_PC2) = 3;
+	reload = (ST20_CONFIG_REG & 0x3f) == 1 ? 0x20 : 0x1b;
+	st20_asc_clock = 16 * reload * 115200;
+	ASC(ASC_INTEN) = 0;
+	st20_asc_set_line(115200, ASC_CTRL_8N1);
+}
+
+void st20_asc_putc(int c)
+{
+	int n = 200000;
+
+	while (!(ASC(ASC_STATUS) & ASC_STATUS_TXEMPTY) && --n)
+		;
+	ASC(ASC_TXBUF) = c & 0xff;
+}
+
+/* the TV console (osd.c) mirrors the RS-232 output */
+extern void st20_osd_write(const char *s, int n);
+
+static void st20_console_print(const char *s)
+{
+	const char *p;
+
+	for (p = s; *p; p++) {
+		if (*p == '\n')
+			st20_asc_putc('\r');
+		st20_asc_putc(*p);
+	}
+	st20_osd_write(s, p - s);
+}
+
+void st20_console_init(void)
+{
+	st20_asc_init();
+	register_console(st20_console_print);
+}
diff --git a/linux-2.0.x/arch/st20/kernel/entry.ast b/linux-2.0.x/arch/st20/kernel/entry.ast
new file mode 100644
index 000000000..a4a268dea
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/entry.ast
@@ -0,0 +1,199 @@
+// arch/st20/kernel/entry.ast - context switch and user/kernel transitions
+//
+// gcc-t800 generic model: after `call`, W[0] = return Iptr, W[1..3] = first three
+// argument words (from Areg..Creg), further arguments at W[4..].  Areg returns the result.
+
+// external names
+.globl _st20_syscall_c;
+.globl _st20_kthread_c;
+.globl _st20_kstack;
+.globl _st20_ret_from_fork_c;
+.globl _st20_tick_hp;
+.globl _st20_irq_hp;
+.globl _st20_error_trap_c;
+.globl _st20_preempt_c;
+.globl _st20_ticks_pending;
+
+.text
+
+// void st20_resume(struct thread_struct *prev, struct thread_struct *next)
+// tss.ksp (word 0) = Wptr whose W[0] is the Iptr to continue at.
+.globl _st20_resume;
+_st20_resume:
+	ldlp 0
+	ldl 1
+	stnl 0
+	ldl 2
+	ldnl 0
+	gajw
+	ret
+
+// long st20_syscall(nr, a, b, c, d, e) - user entry, through ST20_SYSCALL_VECTOR.
+// Runs the C dispatcher on the current task's kernel stack (st20_kstack) and returns to
+// the caller's workspace with the result in Areg.
+.globl _st20_syscall;
+_st20_syscall:
+	ldc _st20_kstack-LS1
+	ldpi
+LS1:
+	ldnl 0
+	gajw
+	ajw -4
+	stl 3
+	ldl 3
+	call _st20_syscall_c
+	ldl 3
+	gajw
+	rev
+	ret
+
+// void st20_return_to_user(unsigned long *uw, long result) - never returns
+// Wptr = uw, Areg = result, then `ret` continues at uw[0] with Wptr = uw + 4 words.
+.globl _st20_return_to_user;
+_st20_return_to_user:
+	ldl 2
+	ldl 1
+	gajw
+	rev
+	ret
+
+// child side of fork/clone: st20_resume "returns" here (see copy_thread); W[1] holds the
+// child's pt_regs.  Return 0 to the user code at regs->wptr / regs->iptr.
+.globl _st20_ret_from_fork;
+_st20_ret_from_fork:
+	ldl 1
+	call _st20_ret_from_fork_c
+	// not reached
+LF1:
+	j LF1
+
+// kernel_thread child: W[1] = fn, W[2] = arg
+.globl _st20_kthread_start;
+_st20_kthread_start:
+	ldl 2
+	ldl 1
+	call _st20_kthread_c
+LK1:
+	j LK1
+
+// ---- tick and preemption (see time.c) ----
+
+// High-priority tick process: every 1 ms of the 1 MHz high-priority timer it calls
+// st20_tick_hp (front-panel refresh; every 10th call a jiffy, HZ = 100, and a redirect of
+// the preempted low-priority kernel to st20_preempt).  W[1] = next deadline.
+.globl _st20_tick_proc;
+_st20_tick_proc:
+	ldtimer
+	stl 1
+LT1:
+	ldl 1
+	adc 1000
+	stl 1
+	ldl 1
+	tin
+	call _st20_tick_hp
+	j LT1
+
+// The preempted low-priority code continues here (set up by st20_tick_hp) with Wptr = f;
+// f[4..10] is its state record (enables, status, Wptr, Iptr, Areg, Breg, Creg), which
+// `restart` resumes exactly after st20_preempt_c has done the interrupt work.
+.globl _st20_preempt;
+_st20_preempt:
+	ldlp 0			// st20_preempt_c(f): it may change the record (signals)
+	call _st20_preempt_c
+	ldlp 4
+	restart
+
+// ---- device interrupts (see irq.c) ----
+// INC level N runs st20_irq_entryN at high priority on that level's workspace; the C
+// handler queues or does the urgent part, then iret returns to whatever was preempted.
+
+.globl _st20_irq_entry0;
+_st20_irq_entry0:
+	ldc 0
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry1;
+_st20_irq_entry1:
+	ldc 1
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry2;
+_st20_irq_entry2:
+	ldc 2
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry3;
+_st20_irq_entry3:
+	ldc 3
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry4;
+_st20_irq_entry4:
+	ldc 4
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry5;
+_st20_irq_entry5:
+	ldc 5
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry6;
+_st20_irq_entry6:
+	ldc 6
+	call _st20_irq_hp
+	iret
+
+.globl _st20_irq_entry7;
+_st20_irq_entry7:
+	ldc 7
+	call _st20_irq_hp
+	iret
+
+// ---- user state, signals, error traps (signal.c, traps.c) ----
+
+// void st20_restart(unsigned long *record) - continue the process described by record
+// (enables, status, Wptr, Iptr, Areg, Breg, Creg); never returns
+.globl _st20_restart;
+_st20_restart:
+	ldl 1
+	restart
+
+// Signal return trampoline, in kernel text but run in user mode: a signal handler (entered
+// as if called, with this as return address) returns here with Wptr = the saved context;
+// below it, call sigreturn (119) through the kernel entry like the libc vfork stub does.
+.globl _st20_sigtramp;
+_st20_sigtramp:
+	ajw -4
+	ldc 119
+	stl 1
+	ldc -1073741824		// 0xc0000000: the kernel entry pointer
+	ldnl 0
+	gcall
+
+// Low-priority trap handlers for errors: st20_error_trap_c(group) on their own workspace.
+// Group 1 = error (integer error), group 2 = system (illegal opcode).
+.globl _st20_error_trap1;
+_st20_error_trap1:
+	ldc 1
+	call _st20_error_trap_c
+	tret
+.globl _st20_error_trap2;
+_st20_error_trap2:
+	ldc 2
+	call _st20_error_trap_c
+	tret
+
+// error trap redirect target (traps.c): kill the faulting user task, at low priority
+.globl _st20_trap_kill_c;
+.globl _st20_trap_kill;
+_st20_trap_kill:
+	call _st20_trap_kill_c
+LTK:
+	j LTK
diff --git a/linux-2.0.x/arch/st20/kernel/head.ast b/linux-2.0.x/arch/st20/kernel/head.ast
new file mode 100644
index 000000000..420819fda
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/head.ast
@@ -0,0 +1,46 @@
+// arch/st20/kernel/head.ast - kernel entry at text@@start (-T in arch/st20/Rules.make)
+// (.ast, not .s: the kernel's "make clean" deletes every *.s)
+//
+// Segments are loaded back to back (text, data, bss); __stext/__etext/__edata/__end are
+// the C symbols _stext/_etext/_edata/_end.
+// Create the segments in load order (lit writes them in first-seen order and crossload
+// lays them out back to back in that order).
+.text
+.data
+.bss
+.text
+
+.globl text@@start;
+.globl text@@size;
+.globl data@@size;
+.globl bss@@size;
+.globl data@@start;
+.globl bss@@start;
+.globl _start_kernel;
+
+data@@start = text@@start + text@@size
+bss@@start = data@@start + data@@size
+
+.globl __stext;
+__stext = text@@start
+.globl __etext;
+__etext = text@@start + text@@size
+.globl __edata;
+__edata = data@@start + data@@size
+.globl __end;
+__end = bss@@start + bss@@size
+
+.text
+.globl @@hook;
+@@hook:
+	// Wptr = top of the boot stack (start_kernel and the idle task run on it)
+	ldc st20_boot_stack+8192-32-LH1
+	ldpi
+LH1:
+	gajw
+	call _start_kernel
+LH2:
+	j LH2
+
+// boot/idle task stack
+.comm st20_boot_stack, 8192
diff --git a/linux-2.0.x/arch/st20/kernel/ir.c b/linux-2.0.x/arch/st20/kernel/ir.c
new file mode 100644
index 000000000..7e02c6d4c
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/ir.c
@@ -0,0 +1,172 @@
+/*
+ * arch/st20/kernel/ir.c - DSR9500 IR remote as a keyboard for the console
+ *
+ * Hardware as the original firmware's IR driver uses it (Decompilation/DSR9500
+ * src/a_7fe8f738.c f_7fe8fd9b / f_7fe8fc90): the receiver output (active low) is on PIO3
+ * bit 3 and PWM CaptureIn0 (PWM block at 0x2000b000, interrupt source 11).  The capture
+ * counter runs from the system clock / (prescale + 1); each falling edge latches it.
+ *
+ * The high-priority top half (ir_fast) only stores capture values in a ring.  ir_lp
+ * decodes NEC frames by the time between falling edges (leader 13.5 ms, repeat 11.25 ms,
+ * bit 0 1.125 ms, bit 1 2.25 ms), accepts the receiver's customer code 0xfe01 and types the
+ * command's text from st20_ir_keymap (generated with the Flipper Zero file by
+ * tools/mkirkeys.py) into the console.  A held key repeats after three repeat frames.
+ * The tick rate of the capture counter is measured against jiffies at start-up, so the
+ * decoder does not depend on the board's clock setting.
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/interrupt.h>
+#include <linux/string.h>
+#include <asm/system.h>
+#include <asm/st20asc.h>
+#include <asm/irkeys.h>
+
+#define PWM(o)		(*(volatile unsigned long *) (0x2000b000UL + (o)))
+#define PWM_CAPTURE0	0x10
+#define PWM_EDGE0	0x30
+#define PWM_CONTROL	0x50
+#define PWM_ENABLE	0x54
+#define PWM_STATUS	0x58
+#define PWM_ACK		0x5c
+#define PWM_COUNT	0x64	/* capture counter */
+#define PWM_CAP0_INT	0x002
+#define IR_PIN		0x08	/* PIO3 bit 3 */
+#define IR_IRQ		11
+#define IR_CUSTOMER	0xfe01
+
+extern int st20_request_fast_irq(unsigned int irq, int (*fast)(void),
+				 void (*handler)(int, void *, struct pt_regs *), const char *name);
+
+static volatile unsigned long edges[64];	/* capture values of falling edges */
+static volatile unsigned int e_head, e_tail;
+static unsigned long ticks_per_ms = 1;		/* measured in st20_ir_init */
+
+static int ir_fast(void)
+{
+	unsigned long st = PWM(PWM_STATUS);
+	int got = 0;
+
+	if (st & PWM_CAP0_INT) {
+		unsigned int next = (e_head + 1) % 64;
+
+		if (!(PIO3(PIO_IN) & IR_PIN) && next != e_tail) {	/* receiver output low */
+			edges[e_head] = PWM(PWM_CAPTURE0);
+			e_head = next;
+			got = 1;
+		}
+	}
+	PWM(PWM_ACK) = st & 0x1ff;
+	return got;
+}
+
+/* decoder state */
+static unsigned long last_edge;
+static int have_last, bits = -1, repeats;
+static unsigned long frame;
+static int last_cmd = -1;
+
+static void ir_key(int cmd)
+{
+	const char *s = st20_ir_keymap[cmd & 0xff];
+
+	if (s)
+		st20_tty_input(s, strlen(s));
+}
+
+static int near(unsigned long us, unsigned long want, unsigned long tol)
+{
+	return us + tol >= want && us <= want + tol;
+}
+
+static void ir_edge(unsigned long cap)
+{
+	unsigned long us;
+
+	if (!have_last) {
+		have_last = 1;
+		last_edge = cap;
+		return;
+	}
+	us = cap - last_edge;			/* ticks; long gaps are "idle" */
+	us = us > 100 * ticks_per_ms ? 100000 : us * 1000 / ticks_per_ms;
+	last_edge = cap;
+	if (near(us, 13500, 1500)) {			/* leader: start a frame */
+		bits = 0;
+		frame = 0;
+		repeats = 0;
+		return;
+	}
+	if (near(us, 11250, 1000) && bits < 0) {	/* repeat frame */
+		if (last_cmd >= 0 && ++repeats > 3)
+			ir_key(last_cmd);
+		return;
+	}
+	if (bits < 0)
+		return;
+	if (near(us, 1125, 350))
+		bits++;
+	else if (near(us, 2250, 450))
+		frame |= 1UL << bits++;
+	else {
+		bits = -1;				/* garbage: wait for a leader */
+		return;
+	}
+	if (bits == 32) {
+		int cmd = (frame >> 16) & 0xff;
+
+		bits = -1;
+		if ((frame & 0xffff) == IR_CUSTOMER && ((frame >> 24) & 0xff) == (~cmd & 0xff)) {
+			last_cmd = cmd;
+			ir_key(cmd);
+		} else
+			last_cmd = -1;
+	}
+}
+
+static void ir_lp(int irq, void *dev_id, struct pt_regs *regs)
+{
+	while (e_tail != e_head) {
+		unsigned long cap = edges[e_tail];
+
+		e_tail = (e_tail + 1) % 64;
+		ir_edge(cap);
+	}
+}
+
+void st20_ir_init(void)
+{
+	unsigned long c0, j0, ctrl;
+
+	/* PIO3 bit 3: PC2,PC1,PC0 = 1,0,1 (input), as the firmware */
+	PIO3(PIO_SET_PC0) = IR_PIN;
+	PIO3(PIO_CLR_PC1) = IR_PIN;
+	PIO3(PIO_SET_PC2) = IR_PIN;
+	/* PWM enable, capture prescale 0x1c (/29), capture enable; falling edges on input 0 */
+	ctrl = PWM(PWM_CONTROL);
+	ctrl = (ctrl & ~0x1fUL) | 0xf | 0x200;
+	ctrl = (ctrl & ~0x1f0UL) | 0x1c0 | 0x400;
+	PWM(PWM_CONTROL) = ctrl;
+	PWM(PWM_EDGE0) = 2;
+	PWM(PWM_ACK) = 0x1ff;
+
+	/* capture counter rate against jiffies (100 ms) */
+	j0 = jiffies;
+	while (jiffies == j0)
+		;
+	c0 = PWM(PWM_COUNT);
+	j0 = jiffies;
+	while (jiffies < j0 + 10)
+		;
+	ticks_per_ms = (PWM(PWM_COUNT) - c0) / 100;
+	if (!ticks_per_ms)
+		ticks_per_ms = 1;
+
+	if (st20_request_fast_irq(IR_IRQ, ir_fast, ir_lp, "ir")) {
+		printk("ir: cannot get interrupt %d\n", IR_IRQ);
+		return;
+	}
+	PWM(PWM_ENABLE) = PWM_CAP0_INT;
+	printk("IR remote keyboard: NEC 0x%04x, capture %lu kHz (irq %d)\n", IR_CUSTOMER,
+	       ticks_per_ms, IR_IRQ);
+}
diff --git a/linux-2.0.x/arch/st20/kernel/irq.c b/linux-2.0.x/arch/st20/kernel/irq.c
new file mode 100644
index 000000000..808941bc1
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/irq.c
@@ -0,0 +1,256 @@
+/*
+ * arch/st20/kernel/irq.c - device interrupts for uClinux/ST20 (STi5512 INC + INL)
+ *
+ * Linux IRQ numbers are the STi5512 interrupt sources (datasheet Table 50: ASC3 = 7,
+ * PWM/capture = 11, ...).  Each requested source gets an INC level of its own through the
+ * interrupt level controller (INL, one word per source at 0x20011000); the INC (0x20000000)
+ * starts st20_irq_entryN (entry.ast) as a high-priority interrupt handler on level N's
+ * workspace.  st20_irq_hp then
+ *   - runs the source's fast top half if it has one (st20_request_fast_irq: e.g. ASC receive
+ *     into a ring, IR edge timestamps), which returns nonzero when Linux work is needed;
+ *   - otherwise masks the level (it is level-triggered) until the Linux handler has run;
+ * marks the IRQ pending and redirects the low-priority kernel to st20_preempt like the
+ * timer tick does (time.c).  All request_irq() handlers run there, at low priority, in
+ * st20_do_irqs, which unmasks masked levels afterwards.
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/kernel_stat.h>
+#include <linux/interrupt.h>
+#include <asm/system.h>
+#include <asm/irq.h>
+#include <asm/ptrace.h>
+
+#define ST20_NR_IRQS	32
+#define ST20_NR_LEVELS	8
+
+/* INC registers */
+#define INC_BASE		0x20000000UL
+#define INC(o)			(*(volatile unsigned long *) (INC_BASE + (o)))
+#define INC_HANDLER(l)		INC(0x00 + 4 * (l))
+#define INC_TRIGGER(l)		INC(0x40 + 4 * (l))
+#define INC_MASK_SET		INC(0xc4)
+#define INC_MASK_CLEAR		INC(0xc8)
+#define INC_PENDING_CLEAR	INC(0x88)
+#define INC_GLOBAL_ENABLE	0x10000
+#define INC_TRIGGER_HIGH	1
+/* INL: interrupt source -> level */
+#define INL(source)		(*(volatile unsigned long *) (0x20011000UL + 4 * (source)))
+
+struct st20_irq {
+	void (*handler)(int, void *, struct pt_regs *);
+	int (*fast)(void);	/* high-priority top half, or 0 */
+	unsigned long flags;
+	void *dev_id;
+	const char *devname;
+	int level;		/* INC level, 0 = none */
+};
+
+static struct st20_irq irq_list[ST20_NR_IRQS];
+static int level_irq[ST20_NR_LEVELS];		/* INC level -> IRQ, -1 = free */
+static unsigned long level_ws[ST20_NR_LEVELS][256];	/* handler workspaces */
+volatile unsigned long st20_irq_pending;	/* IRQ bits waiting for st20_do_irqs */
+static volatile unsigned long irq_masked;	/* IRQ bits masked by st20_irq_hp */
+
+/* levels the original DSR9500 firmware used; others are taken from the top */
+static int preferred_level(unsigned int irq)
+{
+	switch (irq) {
+	case 7:  return 1;	/* ASC3 */
+	case 11: return 6;	/* PWM / IR capture */
+	default: return 0;
+	}
+}
+
+extern void st20_irq_entry0(void), st20_irq_entry1(void), st20_irq_entry2(void);
+extern void st20_irq_entry3(void), st20_irq_entry4(void), st20_irq_entry5(void);
+extern void st20_irq_entry6(void), st20_irq_entry7(void);
+static void (*const level_entry[ST20_NR_LEVELS])(void) = {
+	st20_irq_entry0, st20_irq_entry1, st20_irq_entry2, st20_irq_entry3,
+	st20_irq_entry4, st20_irq_entry5, st20_irq_entry6, st20_irq_entry7,
+};
+
+extern void st20_redirect_lp(void);
+
+/* high priority, from st20_irq_entryN */
+void st20_irq_hp(int level)
+{
+	int irq = level_irq[level];
+	struct st20_irq *d;
+
+	if (irq < 0) {				/* nobody: keep it quiet */
+		INC_MASK_CLEAR = 1UL << level;
+		return;
+	}
+	d = &irq_list[irq];
+	if (d->fast) {
+		if (!d->fast())
+			return;
+	} else {
+		INC_MASK_CLEAR = 1UL << level;	/* until the Linux handler has run */
+		irq_masked |= 1UL << irq;
+	}
+	st20_irq_pending |= 1UL << irq;
+	st20_redirect_lp();
+}
+
+void init_IRQ(void)
+{
+	int l;
+
+	for (l = 0; l < ST20_NR_LEVELS; l++) {
+		level_irq[l] = -1;
+		INC_HANDLER(l) = 0;
+		INC_TRIGGER(l) = INC_TRIGGER_HIGH;
+	}
+	INC_MASK_CLEAR = 0xff;
+	INC_PENDING_CLEAR = 0xff;
+	INC_MASK_SET = INC_GLOBAL_ENABLE;
+}
+
+static int claim_level(unsigned int irq)
+{
+	int l = preferred_level(irq);
+
+	if (l && level_irq[l] < 0)
+		return l;
+	for (l = ST20_NR_LEVELS - 1; l > 0; l--)
+		if (level_irq[l] < 0)
+			return l;
+	return -1;
+}
+
+static int st20_setup_irq(unsigned int irq, void (*handler)(int, void *, struct pt_regs *),
+			  int (*fast)(void), unsigned long flags, const char *devname,
+			  void *dev_id)
+{
+	struct st20_irq *d;
+	unsigned long *top, f;
+	int l;
+
+	if (irq >= ST20_NR_IRQS)
+		return -EINVAL;
+	d = &irq_list[irq];
+	if (d->handler || d->fast)
+		return -EBUSY;
+	l = claim_level(irq);
+	if (l < 0)
+		return -EBUSY;
+	save_flags(f);
+	cli();
+	d->handler = handler;
+	d->fast = fast;
+	d->flags = flags;
+	d->dev_id = dev_id;
+	d->devname = devname;
+	d->level = l;
+	level_irq[l] = irq;
+	/* handler descriptor: workspace top; top[-1] = Iptr, top[-2] = status */
+	top = &level_ws[l][256];
+	top[-1] = (unsigned long) level_entry[l];
+	top[-2] = 0;
+	INC_HANDLER(l) = (unsigned long) top;
+	INL(irq) = l;
+	INC_PENDING_CLEAR = 1UL << l;
+	INC_MASK_SET = 1UL << l;
+	restore_flags(f);
+	return 0;
+}
+
+int request_irq(unsigned int irq, void (*handler)(int, void *, struct pt_regs *),
+		unsigned long flags, const char *devname, void *dev_id)
+{
+	return st20_setup_irq(irq, handler, 0, flags, devname, dev_id);
+}
+
+/* a high-priority top half plus (optionally) a Linux handler for the work it queues */
+int st20_request_fast_irq(unsigned int irq, int (*fast)(void),
+			  void (*handler)(int, void *, struct pt_regs *), const char *devname)
+{
+	return st20_setup_irq(irq, handler, fast, 0, devname, 0);
+}
+
+void free_irq(unsigned int irq, void *dev_id)
+{
+	struct st20_irq *d;
+	unsigned long f;
+
+	if (irq >= ST20_NR_IRQS)
+		return;
+	d = &irq_list[irq];
+	if (!d->level || d->dev_id != dev_id)
+		return;
+	save_flags(f);
+	cli();
+	INC_MASK_CLEAR = 1UL << d->level;
+	INC_HANDLER(d->level) = 0;
+	level_irq[d->level] = -1;
+	d->handler = 0;
+	d->fast = 0;
+	d->level = 0;
+	restore_flags(f);
+}
+
+unsigned long probe_irq_on(void)
+{
+	return 0;
+}
+
+int probe_irq_off(unsigned long irqs)
+{
+	return 0;
+}
+
+void enable_irq(unsigned int irq)
+{
+	if (irq < ST20_NR_IRQS && irq_list[irq].level)
+		INC_MASK_SET = 1UL << irq_list[irq].level;
+}
+
+void disable_irq(unsigned int irq)
+{
+	if (irq < ST20_NR_IRQS && irq_list[irq].level)
+		INC_MASK_CLEAR = 1UL << irq_list[irq].level;
+}
+
+/* runs the Linux handlers of pending interrupts, at low priority (time.c) */
+void st20_do_irqs(struct pt_regs *regs)
+{
+	unsigned long flags, pending, masked;
+	int irq;
+
+	save_flags(flags);
+	cli();
+	pending = st20_irq_pending;
+	st20_irq_pending = 0;
+	restore_flags(flags);
+	for (irq = 0; pending; irq++, pending >>= 1) {
+		struct st20_irq *d = &irq_list[irq];
+
+		if (!(pending & 1))
+			continue;
+		kstat.interrupts[irq]++;
+		if (d->handler)
+			d->handler(irq, d->dev_id, regs);
+		save_flags(flags);
+		cli();
+		masked = irq_masked & (1UL << irq);
+		irq_masked &= ~(1UL << irq);
+		restore_flags(flags);
+		if (masked && d->level)
+			INC_MASK_SET = 1UL << d->level;
+	}
+}
+
+int get_irq_list(char *buf)
+{
+	int i, len = 0;
+
+	for (i = 0; i < ST20_NR_IRQS; i++)
+		if (irq_list[i].handler || irq_list[i].fast)
+			len += sprintf(buf + len, "%2d: %10u  level %d  %s\n", i, kstat.interrupts[i],
+				       irq_list[i].level, irq_list[i].devname);
+	return len;
+}
diff --git a/linux-2.0.x/arch/st20/kernel/osd.c b/linux-2.0.x/arch/st20/kernel/osd.c
new file mode 100644
index 000000000..5f3811cf5
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/osd.c
@@ -0,0 +1,337 @@
+/*
+ * arch/st20/kernel/osd.c - text console on the TV: STi5512 OSD, 80x30 characters of 8x16
+ *
+ * Mirrors what is written to the console (printk and /dev/ttyS0) onto the TV picture; the
+ * IR remote keyboard and the front panel give input, so the box can be used without a
+ * serial cable.  A small VT100 subset: cursor movement (ESC [ n A/B/C/D, ESC [ r;c H),
+ * ESC [ J / 2J, ESC [ K; colours (ESC [ ... m) are accepted and ignored.
+ *
+ * OSD (STi5512 datasheet section 21.5; block format as st20emu renders it, which the
+ * DSR9500 application's menus validate): each field (top/bottom) has its own list of
+ * blocks in SDRAM, from OSD_TOP/OSD_BOT (video registers 0x2a/0x2b, written high byte
+ * first, in units of 256 bytes from 0xc0000000).  A block is an 8-byte big-endian header
+ * (mode, first/last field line, mix weight, left/right pixel, link), a palette and the
+ * pixels.  Here: one 2-bit-per-pixel 640x240 block per field (the even and the odd pixel
+ * lines of the 640x480 window), then a terminating block with first line 0x1ff (as the
+ * DSR9500 loader's osd_init ends its list).
+ *
+ * Bring-up on the real board follows the DSR9500 loader (Decompilation/DSR9500 src/osd.c:
+ * av_init = dev_init + dev_regs, then OSD_CFG.ENA).
+ */
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <asm/system.h>
+#include <asm/font8x16.h>
+
+#define VID(a)		(*(volatile unsigned char *) (a))	/* video registers at 0 */
+#define DENC(a)		VID(0x1800 + (a))
+#define OSD_TOP		0x2a
+#define OSD_BOT		0x2b
+#define OSD_CFG		0x91
+#define OSD_CFG_ENA	0x04
+#define SDRAM		0xc0000000UL
+
+#define COLS		80
+#define ROWS		30
+#define WIDTH		(COLS * 8)		/* 640 */
+#define FIELD_LINES	(ROWS * 8)		/* 240 lines per field */
+#define PITCH		(WIDTH / 4)		/* 2 bpp: 160 bytes per line */
+#define TOP_LINE	48			/* first field line */
+#define LEFT		158			/* centred in the 720-pixel picture */
+#define BITMAP		(PITCH * FIELD_LINES)	/* 38400 */
+#define TERM_OFF	(((16 + BITMAP) + 127) & ~127)	/* terminator, 128-aligned */
+#define FIELD_SIZE	(((TERM_OFF + 8) + 255) & ~255)
+
+static unsigned char osd_mem[2 * FIELD_SIZE + 256];
+static unsigned char *field_list[2];		/* header of each field's block */
+static unsigned char *bitmap[2];
+static int osd_ready;
+static int cx, cy;				/* cursor */
+static int esc_state, esc_args[4], esc_nargs;
+
+/* 2 bpp expansion of a font nibble: set pixel = colour 3, clear = colour 0 */
+static const unsigned char expand[16] = {
+	0x00, 0x03, 0x0c, 0x0f, 0x30, 0x33, 0x3c, 0x3f,
+	0xc0, 0xc3, 0xcc, 0xcf, 0xf0, 0xf3, 0xfc, 0xff,
+};
+
+static void put_be32(unsigned char *p, unsigned long v)
+{
+	p[0] = v >> 24;
+	p[1] = v >> 16;
+	p[2] = v >> 8;
+	p[3] = v;
+}
+
+/* block header: mode 0 (2 bpp), lines top..bottom, pixels left..right, link to SDRAM byte
+   offset link (0 = none; a multiple of 128) */
+static void put_header(unsigned char *h, int top, int bottom, int left, int right,
+		       unsigned long link)
+{
+	unsigned long n = link / 8;
+	unsigned long hi = ((unsigned long) top << 16) | (((n >> 4) & 7) << 9) | bottom;
+	unsigned long lo = (((n >> 7) & 0x3f) << 26) | ((unsigned long) left << 16) |
+			   (((n >> 13) & 0x3f) << 10) | right;
+
+	put_be32(h, hi);
+	put_be32(h + 4, lo);
+}
+
+/* palette entry: 6-bit luma, 4-bit Cb/Cr, opaque */
+static void put_colour(unsigned char *p, int y6, int cb, int cr)
+{
+	p[0] = y6 << 2;
+	p[1] = (cb << 4) | cr;
+}
+
+static void spin(int n)
+{
+	volatile int i;
+
+	for (i = 0; i < n * 50; i++)
+		;
+}
+
+static void wr16(unsigned long a, unsigned int v)
+{
+	VID(a) = v >> 8;
+	VID(a + 1) = v;
+}
+
+/* the DSR9500 loader's AV decoder / display / DENC set-up (dev_init, dev_reset, dev_regs) */
+static void av_init(void)
+{
+	unsigned char ctrl = 0xc1;
+
+	VID(0x5001) = 0x10;
+	(void) VID(0x3d);
+	VID(0x3c) = 0;
+	wr16(0x60, 0);
+	VID(3) = 0;
+	wr16(0x14, 0);
+	wr16(0x18, 0xfff);
+	wr16(0x1a, 0xfff);
+	VID(0x54) = 7;
+	VID(0x55) = 0xc;
+	VID(0x28) = 0x2d;
+	wr16(0x74, ((VID(0x74) << 8) | VID(0x75)) | 0x800);
+	VID(OSD_CFG) = 0;
+	wr16(0x70, 0x70);
+	wr16(0x72, 0x340);
+	wr16(0x6e, 0x16);
+	wr16(0x46, 0x136);
+	VID(2) = ctrl;
+	/* dev_reset */
+	VID(3) = 4;
+	VID(0x39) = 1;
+	spin(1);
+	VID(0x39) = 0;
+	VID(2) = ctrl | 4;
+	spin(1);
+	VID(2) = ctrl;
+	(void) VID(0x3b);
+	VID(0x40) = 0;
+	VID(0x41) = 0;
+	/* dev_regs: DENC configuration */
+	DENC(0) = 0x30;
+	DENC(1) = 0x60;
+	DENC(2) = 0x22;
+	DENC(3) = 0x42;
+	DENC(4) = 0x10;
+	DENC(5) = 0x61;
+	DENC(7) = 0;
+	DENC(8) = 0x20;
+	DENC(6) = 0x80;
+}
+
+static unsigned char *line(int field, int l)
+{
+	return bitmap[field] + l * PITCH;
+}
+
+static void draw_char(int col, int row, int c)
+{
+	const unsigned char *g = st20_font8x16 + (c & 0xff) * 16;
+	int y;
+
+	for (y = 0; y < 16; y++) {
+		unsigned char *p = line(y & 1, row * 8 + (y >> 1)) + col * 2;
+
+		p[0] = expand[g[y] >> 4];
+		p[1] = expand[g[y] & 15];
+	}
+}
+
+static void invert_cell(int col, int row)
+{
+	int y;
+
+	for (y = 0; y < 16; y++) {
+		unsigned char *p = line(y & 1, row * 8 + (y >> 1)) + col * 2;
+
+		p[0] ^= 0xff;
+		p[1] ^= 0xff;
+	}
+}
+
+static void clear_lines(int row0, int rows)
+{
+	int f;
+
+	for (f = 0; f < 2; f++)
+		memset(line(f, row0 * 8), 0, rows * 8 * PITCH);
+}
+
+static void clear_eol(int col, int row)
+{
+	int f, l;
+
+	for (f = 0; f < 2; f++)
+		for (l = 0; l < 8; l++)
+			memset(line(f, row * 8 + l) + col * 2, 0, (COLS - col) * 2);
+}
+
+static void scroll(void)
+{
+	int f;
+
+	for (f = 0; f < 2; f++)
+		memmove(line(f, 0), line(f, 8), (FIELD_LINES - 8) * PITCH);
+	clear_lines(ROWS - 1, 1);
+}
+
+static void newline(void)
+{
+	cx = 0;
+	if (++cy >= ROWS) {
+		scroll();
+		cy = ROWS - 1;
+	}
+}
+
+static int arg(int i, int def)
+{
+	return i < esc_nargs && esc_args[i] ? esc_args[i] : def;
+}
+
+static void csi(int c)
+{
+	switch (c) {
+	case 'A': cy -= arg(0, 1); break;
+	case 'B': cy += arg(0, 1); break;
+	case 'C': cx += arg(0, 1); break;
+	case 'D': cx -= arg(0, 1); break;
+	case 'H': case 'f': cy = arg(0, 1) - 1; cx = arg(1, 1) - 1; break;
+	case 'J':
+		if (arg(0, 0) == 2) {
+			clear_lines(0, ROWS);
+			cx = cy = 0;
+		} else {
+			clear_eol(cx, cy);
+			if (cy + 1 < ROWS)
+				clear_lines(cy + 1, ROWS - cy - 1);
+		}
+		break;
+	case 'K': clear_eol(cx, cy); break;
+	default: break;			/* m (colours) and others: ignored */
+	}
+	if (cx < 0) cx = 0;
+	if (cx >= COLS) cx = COLS - 1;
+	if (cy < 0) cy = 0;
+	if (cy >= ROWS) cy = ROWS - 1;
+}
+
+static void put(int c)
+{
+	if (esc_state == 1) {
+		if (c == '[') {
+			esc_state = 2;
+			esc_nargs = 0;
+			esc_args[0] = 0;
+			return;
+		}
+		esc_state = 0;
+		return;
+	}
+	if (esc_state == 2) {
+		if (c >= '0' && c <= '9') {
+			if (!esc_nargs)
+				esc_nargs = 1;
+			esc_args[esc_nargs - 1] = esc_args[esc_nargs - 1] * 10 + c - '0';
+			return;
+		}
+		if (c == ';') {
+			if (esc_nargs < 4)
+				esc_args[esc_nargs++] = 0;
+			if (esc_nargs == 1)
+				esc_args[esc_nargs++] = 0;
+			return;
+		}
+		esc_state = 0;
+		csi(c);
+		return;
+	}
+	switch (c) {
+	case 033: esc_state = 1; return;
+	case '\r': cx = 0; return;
+	case '\n': newline(); return;
+	case '\b': if (cx > 0) cx--; return;
+	case '\t': do put(' '); while (cx & 7); return;
+	case 7: return;
+	}
+	if (c < 0x20)
+		return;
+	if (cx >= COLS)
+		newline();
+	draw_char(cx, cy, c);
+	cx++;
+}
+
+void st20_osd_write(const char *s, int n)
+{
+	unsigned long flags;
+	int cur;
+
+	if (!osd_ready)
+		return;
+	save_flags(flags);
+	cli();
+	cur = cx < COLS;
+	if (cur)
+		invert_cell(cx, cy);		/* remove the cursor */
+	while (n-- > 0)
+		put((unsigned char) *s++);
+	if (cx < COLS)
+		invert_cell(cx, cy);		/* draw it */
+	restore_flags(flags);
+}
+
+void st20_osd_init(void)
+{
+	unsigned long base = ((unsigned long) osd_mem + 255) & ~255UL;
+	int f;
+
+	av_init();
+	for (f = 0; f < 2; f++) {
+		unsigned char *list = (unsigned char *) base + f * FIELD_SIZE;
+		unsigned long off = (unsigned long) list - SDRAM;
+
+		field_list[f] = list;
+		bitmap[f] = list + 16;
+		put_header(list, TOP_LINE, TOP_LINE + FIELD_LINES - 1, LEFT, LEFT + WIDTH - 1,
+			   off + TERM_OFF);
+		put_colour(list + 8, 4, 8, 8);		/* 0: black */
+		put_colour(list + 10, 0x10, 8, 8);	/* 1: grey */
+		put_colour(list + 12, 0x22, 3, 10);	/* 2: colour of the loader's screens */
+		put_colour(list + 14, 0x3a, 8, 8);	/* 3: white */
+		memset(bitmap[f], 0, BITMAP);
+		put_header(list + TERM_OFF, 0x1ff, 0x1ff, 0, 0, off + TERM_OFF);
+		VID(f ? OSD_BOT : OSD_TOP) = (off >> 8) >> 8;
+		VID(f ? OSD_BOT : OSD_TOP) = off >> 8;
+	}
+	VID(OSD_CFG) |= OSD_CFG_ENA;
+	cx = cy = 0;
+	osd_ready = 1;
+	st20_osd_write("uClinux/ST20 on the Samsung DSR9500 - TV console\r\n", 51);
+	printk("TV console: OSD %dx%d text, 8x16 font\n", COLS, ROWS);
+}
diff --git a/linux-2.0.x/arch/st20/kernel/panel.c b/linux-2.0.x/arch/st20/kernel/panel.c
new file mode 100644
index 000000000..c67492454
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/panel.c
@@ -0,0 +1,202 @@
+/*
+ * arch/st20/kernel/panel.c - DSR9500 front panel: 4-digit LED display and keys
+ *
+ * Hardware (Decompilation/DSR9500 src/a_7fe8f738.c, st20emu src/board/DSR9500.cpp): a
+ * 16-bit shift register, data PIO4 bit 3, clock PIO4 bit 4, shifted MSB first and latched
+ * by pulsing PIO1 bit 7.  Bits 12-15 select a digit, bits 0-7 are its active-low segments.
+ * The same outputs drive the key matrix columns: with one column bit low and no digit
+ * selected, a pressed key pulls the return line PIO4 bit 2 low.  Keys: 0x04 up, 0x08 down,
+ * 0x80 power.
+ *
+ * The display is multiplexed by the high-priority tick (1 kHz: one digit per tick), which
+ * also scans the keys every 10 ms and queues changes; st20_panel_lp (low priority) types
+ * them into the console: up/down = cursor up/down, power = Enter.
+ * /dev/panel (char major 60): write up to four characters to show them, read them back.
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/proc_fs.h>
+#include <linux/major.h>
+#include <asm/system.h>
+#include <asm/segment.h>
+#include <asm/st20asc.h>
+
+#define PANEL_DATA	0x08	/* PIO4 */
+#define PANEL_CLOCK	0x10	/* PIO4 */
+#define PANEL_RETURN	0x04	/* PIO4, input */
+#define PANEL_LATCH	0x80	/* PIO1 */
+#define PANEL_MAJOR	60	/* char device /dev/panel (local/experimental major) */
+
+/* ASCII 0x20-0x5f -> segments (active low), the DSR9500 firmware's table */
+static const unsigned char segments[64] = {
+	0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xbf, 0x7f, 0xff,
+	0xc0, 0xf9, 0xa4, 0xb0, 0x99, 0x92, 0x82, 0xf8, 0x80, 0x90, 0xff, 0xff, 0xff, 0xb7, 0xff, 0xff,
+	0xff, 0x88, 0x83, 0xc6, 0xa1, 0x86, 0x8e, 0xc2, 0x89, 0xf9, 0xe1, 0x8a, 0xc7, 0xc8, 0xab, 0xc0,
+	0x8c, 0x98, 0xaf, 0x92, 0x87, 0xc1, 0xe3, 0x81, 0x89, 0x91, 0xa4, 0xc6, 0xff, 0xf0, 0xff, 0xf7,
+};
+
+static volatile unsigned char panel_seg[4] = { 0xff, 0xff, 0xff, 0xff };
+static char panel_text[5] = "    ";
+static int digit, scan_div;
+static unsigned char keys_now, keys_seen;	/* HP: debounced state */
+static volatile unsigned char key_events[16];	/* HP -> LP: newly pressed key bits */
+static volatile unsigned int ev_head, ev_tail;
+static int panel_ready;
+
+static void shift_out(unsigned int v)
+{
+	int i;
+
+	for (i = 0; i < 16; i++) {
+		if (v & 0x8000)
+			PIO4(PIO_SET_OUT) = PANEL_DATA;
+		else
+			PIO4(PIO_CLR_OUT) = PANEL_DATA;
+		PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+		PIO4(PIO_CLR_OUT) = PANEL_CLOCK;
+		PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+		v <<= 1;
+	}
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+	PIO1(PIO_CLR_OUT) = PANEL_LATCH;
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+}
+
+static unsigned char scan_keys(void)
+{
+	static const unsigned char columns[3] = { 0x04, 0x08, 0x80 };
+	unsigned char pressed = 0;
+	int i;
+
+	for (i = 0; i < 3; i++) {
+		shift_out((~columns[i]) & 0xff);		/* no digit selected */
+		if (!(PIO4(PIO_IN) & PANEL_RETURN))
+			pressed |= columns[i];
+	}
+	return pressed;
+}
+
+/* high priority, every 1 ms from the tick; returns 1 if a key event was queued */
+int st20_panel_hp(void)
+{
+	int event = 0;
+
+	if (!panel_ready)
+		return 0;
+	if (++scan_div >= 10) {
+		unsigned char k;
+
+		scan_div = 0;
+		k = scan_keys();
+		if (k == keys_now && k != keys_seen) {	/* stable for two scans */
+			unsigned char down = k & ~keys_seen;
+			unsigned int next = (ev_head + 1) % sizeof(key_events);
+
+			keys_seen = k;
+			if (down && next != ev_tail) {
+				key_events[ev_head] = down;
+				ev_head = next;
+				event = 1;
+			}
+		}
+		keys_now = k;
+	}
+	digit = (digit + 1) & 3;
+	shift_out((0x1000 << digit) | panel_seg[digit]);
+	return event;
+}
+
+/* low priority (time.c): panel keys -> console */
+void st20_panel_lp(void)
+{
+	while (ev_tail != ev_head) {
+		unsigned char k = key_events[ev_tail];
+
+		ev_tail = (ev_tail + 1) % sizeof(key_events);
+		if (k & 0x04)
+			st20_tty_input("\033[A", 3);
+		if (k & 0x08)
+			st20_tty_input("\033[B", 3);
+		if (k & 0x80)
+			st20_tty_input("\r", 1);
+	}
+}
+
+void st20_panel_set(const char *s, int n)
+{
+	int i;
+
+	for (i = 0; i < 4; i++) {
+		int c = i < n ? s[i] : ' ';
+
+		if (c >= 'a' && c <= 'z')
+			c -= 'a' - 'A';
+		if (c < 0x20 || c > 0x5f)
+			c = ' ';
+		panel_text[i] = c;
+		panel_seg[i] = segments[c - 0x20];
+	}
+}
+
+static int panel_write(struct inode *inode, struct file *file, const char *buf, int count)
+{
+	char tmp[4];
+	int i, n = 0;
+
+	for (i = 0; i < count && n < 4; i++) {
+		char c = get_user(buf + i);
+
+		if (c == '\n')
+			break;
+		tmp[n++] = c;
+	}
+	st20_panel_set(tmp, n);
+	return count;
+}
+
+static int panel_read(struct inode *inode, struct file *file, char *buf, int count)
+{
+	char tmp[6];
+	int n, i;
+
+	if (file->f_pos)
+		return 0;
+	memcpy(tmp, panel_text, 4);
+	tmp[4] = '\n';
+	n = count < 5 ? count : 5;
+	for (i = 0; i < n; i++)
+		put_user(tmp[i], buf + i);
+	file->f_pos += n;
+	return n;
+}
+
+static struct file_operations panel_fops = {
+	NULL,		/* lseek */
+	panel_read,
+	panel_write,
+};
+
+void st20_panel_init(void)
+{
+	/* PIO1 bit 7 and PIO4 bits 3, 4: outputs; PIO4 bit 2: input (as the firmware) */
+	PIO1(PIO_CLR_PC0) = PANEL_LATCH;
+	PIO1(PIO_SET_PC1) = PANEL_LATCH;
+	PIO1(PIO_CLR_PC2) = PANEL_LATCH;
+	PIO4(PIO_CLR_PC0) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_SET_PC1) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_CLR_PC2) = PANEL_DATA | PANEL_CLOCK;
+	PIO4(PIO_SET_PC0) = PANEL_RETURN;
+	PIO4(PIO_CLR_PC1) = PANEL_RETURN;
+	PIO4(PIO_SET_PC2) = PANEL_RETURN;
+	PIO4(PIO_SET_OUT) = PANEL_CLOCK;
+	PIO1(PIO_SET_OUT) = PANEL_LATCH;
+	st20_panel_set("boot", 4);
+	if (register_chrdev(PANEL_MAJOR, "panel", &panel_fops))
+		printk("panel: cannot register major %d\n", PANEL_MAJOR);
+	panel_ready = 1;
+	printk("Front panel: 4-digit display (/dev/panel, major %d), keys up/down/power\n",
+	       PANEL_MAJOR);
+}
diff --git a/linux-2.0.x/arch/st20/kernel/process.c b/linux-2.0.x/arch/st20/kernel/process.c
new file mode 100644
index 000000000..5b41bd347
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/process.c
@@ -0,0 +1,219 @@
+/*
+ * arch/st20/kernel/process.c - task creation, exec, idle for uClinux/ST20
+ *
+ * A task switched out by st20_resume() has tss.ksp = its Wptr, whose word 0 is the Iptr
+ * to continue at.  New tasks get a hand-made frame there (copy_thread, kernel_thread).
+ */
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/unistd.h>
+#include <linux/ptrace.h>
+#include <linux/malloc.h>
+#include <linux/user.h>
+#include <linux/a.out.h>
+#include <linux/string.h>
+
+#include <asm/segment.h>
+#include <asm/system.h>
+#include <asm/io.h>
+
+extern void st20_ret_from_fork(void);
+extern void st20_kthread_start(void);
+extern void st20_return_to_user(unsigned long *uw, long result);
+
+/* top of the current task's kernel stack, used by st20_syscall (entry.s) */
+unsigned long st20_kstack;
+
+asmlinkage int sys_idle(void)
+{
+	if (current->pid != 0)
+		return -EPERM;
+
+	/* endless idle loop with no priority at all */
+	current->counter = -100;
+	for (;;)
+		schedule();
+}
+
+void hard_reset_now(void)
+{
+	st20_reboot();
+}
+
+void show_regs(struct pt_regs * regs)
+{
+	printk("\nIptr: %08lx Wptr: %08lx status: %08lx nr: %ld\n",
+	       regs->iptr, regs->wptr, regs->status, regs->orig_nr);
+}
+
+/* the vfork child's stack copy is not needed after exec or exit */
+static void free_vfork_stack(void)
+{
+	if (current->tss.vfork_stack) {
+		kfree((void *) current->tss.vfork_stack);
+		current->tss.vfork_stack = 0;
+	}
+}
+
+void exit_thread(void)
+{
+	free_vfork_stack();
+}
+
+void flush_thread(void)
+{
+	free_vfork_stack();
+	set_fs(USER_DS);
+}
+
+/*
+ * vfork (CLONE_WAIT): the child gets a copy of the parent's user stack from the calling
+ * frame up to the end of the environment strings, with VFORK_HEADROOM below for its own
+ * calls.  gcc-t800 shares workspace slots between locals that are dead on the child's path
+ * (sash's runcmd lost `bg'), so a child running in the parent's frames corrupts it; on the
+ * copy it cannot.  Pointers into the parent's stack still reach the parent's (unchanged)
+ * data, which is what vfork-then-exec code expects.
+ */
+#define VFORK_HEADROOM	8192
+#define VFORK_MAX	(64 * 1024)
+
+static void copy_vfork_stack(struct task_struct *p, struct pt_regs *childregs)
+{
+	unsigned long uw = childregs->wptr, top = current->mm->env_end;
+	char *buf;
+
+	if (!(childregs->status & PS_USER) || top <= uw || top - uw > VFORK_MAX)
+		return;
+	buf = kmalloc(VFORK_HEADROOM + (top - uw), GFP_KERNEL);
+	if (!buf)
+		return;		/* fall back to sharing the stack */
+	memcpy(buf + VFORK_HEADROOM, (void *) uw, top - uw);
+	childregs->wptr = (unsigned long) buf + VFORK_HEADROOM;
+	p->tss.vfork_stack = (unsigned long) buf;
+}
+
+void release_thread(struct task_struct *dead_task)
+{
+}
+
+/* builds the frame st20_resume returns through: w[0] = Iptr, w[5].. = words 1.. after ret */
+static unsigned long *new_frame(struct task_struct *p, void (*entry)(void))
+{
+	unsigned long *w = (unsigned long *) (p->kernel_stack_page + PAGE_SIZE - 64);
+
+	w[0] = (unsigned long) entry;
+	p->tss.ksp = (unsigned long) w;
+	return w;
+}
+
+void copy_thread(int nr, unsigned long clone_flags, unsigned long usp,
+		 struct task_struct * p, struct pt_regs * regs)
+{
+	struct pt_regs * childregs;
+	unsigned long *w;
+
+	childregs = (struct pt_regs *) (p->kernel_stack_page + PAGE_SIZE - 64 - 16
+					- sizeof(struct pt_regs));
+	*childregs = *regs;
+	childregs->result = 0;
+	if (usp && usp != regs->wptr)
+		childregs->wptr = usp;
+	p->tss.vfork_stack = 0;
+	if (clone_flags & CLONE_WAIT)
+		copy_vfork_stack(p, childregs);
+	w = new_frame(p, st20_ret_from_fork);
+	w[5] = (unsigned long) childregs;
+	p->tss.usp = childregs->wptr;
+	p->tss.fs = current->tss.fs;
+	p->tss.regs = childregs;
+}
+
+/* binfmt_flat: the new program starts with Wptr = usp at pc (via tss.resume, syscalls.c) */
+void st20_start_thread(struct pt_regs *regs, unsigned long pc, unsigned long usp)
+{
+	regs->iptr = pc;
+	regs->wptr = usp;
+	regs->status |= PS_USER;
+	current->tss.resume[0] = usp;
+	current->tss.resume[1] = pc;
+	current->tss.resume[2] = current->tss.resume[3] = current->tss.resume[4] = 0;
+	current->tss.resume_valid = 1;
+}
+
+/* child side of fork/clone (from entry.s) */
+void st20_ret_from_fork_c(struct pt_regs *regs)
+{
+	((unsigned long *) regs->wptr)[0] = regs->iptr;
+	st20_return_to_user((unsigned long *) regs->wptr, 0);
+}
+
+/* kernel_thread child (from entry.s) */
+void st20_kthread_c(int (*fn)(void *), void *arg)
+{
+	sti();
+	sys_exit(fn(arg));
+}
+
+pid_t kernel_thread(int (*fn)(void *), void * arg, unsigned long flags)
+{
+	struct pt_regs regs;
+	int pid;
+
+	memset(&regs, 0, sizeof(regs));
+	regs.orig_nr = -1;
+	pid = do_fork(flags | CLONE_VM, 0, &regs);
+	if (pid > 0) {
+		struct task_struct *p;
+		for_each_task(p)
+			if (p->pid == pid) {
+				unsigned long *w = new_frame(p, st20_kthread_start);
+				w[5] = (unsigned long) fn;
+				w[6] = (unsigned long) arg;
+				break;
+			}
+	}
+	return pid;
+}
+
+/* fill in the user structure for a core dump */
+void dump_thread(struct pt_regs * regs, struct user * dump)
+{
+	memset(dump, 0, sizeof(*dump));
+	dump->magic = CMAGIC;
+	dump->start_code = 0;
+	dump->start_stack = regs->wptr & ~(PAGE_SIZE - 1);
+	dump->u_tsize = ((unsigned long) current->mm->end_code) >> PAGE_SHIFT;
+	dump->u_dsize = ((unsigned long) (current->mm->brk + (PAGE_SIZE-1))) >> PAGE_SHIFT;
+	dump->u_dsize -= dump->u_tsize;
+	dump->u_ssize = 0;
+	dump->u_ar0 = (struct pt_regs *)(((int)(&dump->regs)) -((int)(dump)));
+	dump->regs = *regs;
+}
+
+/* system calls taking pt_regs: the dispatcher passes current->tss.regs */
+asmlinkage int sys_fork(void)
+{
+	/* no MMU: fork() behaves like vfork(); as on m68knommu/h8300, no CLONE_VM, so
+	   copy_mm gives the child its own mm and vforkwoken = 0 (exec/exit wake us) */
+	return do_fork(CLONE_WAIT | SIGCHLD, 0, current->tss.regs);
+}
+
+asmlinkage int sys_clone(unsigned long clone_flags, unsigned long newsp)
+{
+	return do_fork(clone_flags, newsp, current->tss.regs);
+}
+
+asmlinkage int sys_execve(char *name, char **argv, char **envp)
+{
+	int error;
+	char * filename;
+
+	error = getname(name, &filename);
+	if (error)
+		return error;
+	error = do_execve(filename, argv, envp, current->tss.regs);
+	putname(filename);
+	return error;
+}
diff --git a/linux-2.0.x/arch/st20/kernel/serial.c b/linux-2.0.x/arch/st20/kernel/serial.c
new file mode 100644
index 000000000..ed9872db1
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/serial.c
@@ -0,0 +1,211 @@
+/*
+ * arch/st20/kernel/serial.c - /dev/ttyS0: the RS-232 terminal on the board's ASC
+ * (DSR9500: ASC3, interrupt 7, set up by console.c like the original loader)
+ *
+ * Receive is interrupt driven: the high-priority top half (st20_asc_fast) empties the ASC
+ * into a ring like the original firmware's asc_isr, and st20_asc_rx moves the ring into the
+ * tty at low priority.  Transmit is polled.  set_termios programs baud rate, character
+ * size, parity and stop bits, so `stty 9600` etc. work.  st20_tty_input lets other input
+ * devices (IR remote keyboard, front panel) type into the same terminal.
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/tty.h>
+#include <linux/tty_flip.h>
+#include <linux/serial.h>
+#include <linux/major.h>
+#include <linux/string.h>
+#include <linux/fcntl.h>
+#include <linux/mm.h>
+#include <linux/interrupt.h>
+#include <asm/system.h>
+#include <asm/segment.h>
+#include <asm/board.h>
+#include <asm/st20asc.h>
+
+#define SERIAL_TYPE_NORMAL	1	/* as in the 2.0 serial drivers */
+#define ASC_IRQ			7	/* ASC3 */
+#define RX_RING			1024
+
+extern int st20_request_fast_irq(unsigned int irq, int (*fast)(void),
+				 void (*handler)(int, void *, struct pt_regs *), const char *name);
+
+static struct tty_driver st20_serial_driver;
+static int st20_serial_refcount;
+static struct tty_struct *st20_serial_table[1];
+static struct termios *st20_serial_termios[1];
+static struct termios *st20_serial_termios_locked[1];
+static struct tty_struct *st20_tty;	/* the open tty, or 0 */
+
+static unsigned char rx_ring[RX_RING];
+static volatile unsigned int rx_head, rx_tail;	/* head: HP writer, tail: LP reader */
+static unsigned long rx_overruns;
+
+/* high priority: empty the receiver (the interrupt is level-triggered on RxBufFull) */
+static int st20_asc_fast(void)
+{
+	int got = 0;
+
+	while (ASC(ASC_STATUS) & ASC_STATUS_RXFULL) {
+		unsigned char c = ASC(ASC_RXBUF);
+		unsigned int next = (rx_head + 1) % RX_RING;
+
+		if (next != rx_tail) {
+			rx_ring[rx_head] = c;
+			rx_head = next;
+		} else
+			rx_overruns++;
+		got = 1;
+	}
+	return got;
+}
+
+static void push_chars(const unsigned char *s, int n)
+{
+	struct tty_struct *tty = st20_tty;
+
+	if (!tty)
+		return;
+	while (n-- > 0 && tty->flip.count < TTY_FLIPBUF_SIZE)
+		tty_insert_flip_char(tty, *s++, 0);
+	queue_task_irq_off(&tty->flip.tqueue, &tq_timer);
+}
+
+/* low priority: ring -> tty */
+static void st20_asc_rx(int irq, void *dev_id, struct pt_regs *regs)
+{
+	while (rx_tail != rx_head) {
+		unsigned char c = rx_ring[rx_tail];
+
+		rx_tail = (rx_tail + 1) % RX_RING;
+		push_chars(&c, 1);
+	}
+}
+
+void st20_tty_input(const char *s, int n)
+{
+	push_chars((const unsigned char *) s, n);
+}
+
+static int st20_open(struct tty_struct *tty, struct file *filp)
+{
+	if (MINOR(tty->device) - tty->driver.minor_start != 0)
+		return -ENODEV;
+	st20_tty = tty;
+	return 0;
+}
+
+static void st20_close(struct tty_struct *tty, struct file *filp)
+{
+	if (tty->count <= 1)
+		st20_tty = 0;
+}
+
+extern void st20_osd_write(const char *s, int n);
+
+static int st20_write(struct tty_struct *tty, int from_user, const unsigned char *buf,
+		      int count)
+{
+	char chunk[64];
+	int i, n, done = 0;
+
+	while (done < count) {
+		n = count - done > (int) sizeof(chunk) ? (int) sizeof(chunk) : count - done;
+		for (i = 0; i < n; i++)
+			chunk[i] = from_user ? get_user(buf + done + i) : buf[done + i];
+		for (i = 0; i < n; i++)
+			st20_asc_putc(chunk[i]);
+		st20_osd_write(chunk, n);
+		done += n;
+	}
+	return count;
+}
+
+static void st20_put_char(struct tty_struct *tty, unsigned char ch)
+{
+	st20_asc_putc(ch);
+	st20_osd_write((char *) &ch, 1);
+}
+
+static int st20_write_room(struct tty_struct *tty)
+{
+	return 512;
+}
+
+static int st20_chars_in_buffer(struct tty_struct *tty)
+{
+	return 0;
+}
+
+static const unsigned long baud_table[] = {
+	0, 50, 75, 110, 134, 150, 200, 300, 600, 1200, 1800, 2400, 4800, 9600, 19200, 38400,
+	57600, 115200, 230400, 460800
+};
+
+static void st20_set_termios(struct tty_struct *tty, struct termios *old)
+{
+	unsigned int cflag = tty->termios->c_cflag;
+	unsigned long baud, ctrl;
+	int i = cflag & CBAUD;
+
+	if (i & CBAUDEX) {
+		i &= ~CBAUDEX;
+		i += 15;
+	}
+	baud = i < (int) (sizeof(baud_table) / sizeof(baud_table[0])) ? baud_table[i] : 115200;
+	if (!baud)
+		baud = 115200;
+	if (cflag & PARENB)
+		ctrl = (cflag & CSIZE) == CS7 ? ASC_CTRL_MODE_7P : ASC_CTRL_MODE_8P;
+	else
+		ctrl = ASC_CTRL_MODE_8;
+	if (cflag & PARODD)
+		ctrl |= ASC_CTRL_ODD;
+	ctrl |= (cflag & CSTOPB) ? ASC_CTRL_STOP_2 : ASC_CTRL_STOP_1;
+	ctrl |= ASC_CTRL_RUN | ((cflag & CREAD) ? ASC_CTRL_RXEN : 0);
+	st20_asc_set_line(baud, ctrl);
+}
+
+int st20_serial_init(void)
+{
+	memset(&st20_serial_driver, 0, sizeof(struct tty_driver));
+	st20_serial_driver.magic = TTY_DRIVER_MAGIC;
+	st20_serial_driver.name = "ttyS";
+	st20_serial_driver.major = TTY_MAJOR;
+	st20_serial_driver.minor_start = 64;
+	st20_serial_driver.num = 1;
+	st20_serial_driver.type = TTY_DRIVER_TYPE_SERIAL;
+	st20_serial_driver.subtype = SERIAL_TYPE_NORMAL;
+	st20_serial_driver.init_termios = tty_std_termios;
+	st20_serial_driver.init_termios.c_cflag = B115200 | CS8 | CREAD | HUPCL | CLOCAL;
+	st20_serial_driver.flags = TTY_DRIVER_REAL_RAW;
+	st20_serial_driver.refcount = &st20_serial_refcount;
+	st20_serial_driver.table = st20_serial_table;
+	st20_serial_driver.termios = st20_serial_termios;
+	st20_serial_driver.termios_locked = st20_serial_termios_locked;
+	st20_serial_driver.open = st20_open;
+	st20_serial_driver.close = st20_close;
+	st20_serial_driver.write = st20_write;
+	st20_serial_driver.put_char = st20_put_char;
+	st20_serial_driver.write_room = st20_write_room;
+	st20_serial_driver.chars_in_buffer = st20_chars_in_buffer;
+	st20_serial_driver.set_termios = st20_set_termios;
+
+	if (tty_register_driver(&st20_serial_driver))
+		panic("Couldn't register ST20 serial driver\n");
+	if (st20_request_fast_irq(ASC_IRQ, st20_asc_fast, st20_asc_rx, "ttyS0"))
+		printk("ttyS0: cannot get interrupt %d\n", ASC_IRQ);
+	ASC(ASC_INTEN) = ASC_INTEN_RXFULL;
+	printk("ttyS0 at ASC %08lx (irq %d), %lu Hz clock, 115200 8N1\n", ST20_CONSOLE_ASC,
+	       ASC_IRQ, st20_asc_clock);
+	{
+		extern void st20_panel_init(void), st20_ir_init(void), st20_osd_init(void);
+
+		st20_osd_init();	/* TV console output */
+		st20_panel_init();	/* the other console input devices */
+		st20_ir_init();
+	}
+	return 0;
+}
diff --git a/linux-2.0.x/arch/st20/kernel/setup.c b/linux-2.0.x/arch/st20/kernel/setup.c
new file mode 100644
index 000000000..a9f99b46e
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/setup.c
@@ -0,0 +1,67 @@
+/*
+ * arch/st20/kernel/setup.c - uClinux/ST20 machine setup (board: asm/board.h)
+ */
+#include <linux/config.h>
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/string.h>
+#include <linux/major.h>
+#include <linux/fs.h>
+#include <linux/unistd.h>
+
+#include <asm/system.h>
+#include <asm/setup.h>
+#include <asm/irq.h>
+#include <asm/board.h>
+
+extern char _stext, _etext, _edata, _end;
+extern long st20_syscall();
+extern void st20_console_init(void);
+extern unsigned long st20_kstack;
+extern unsigned long loops_per_sec;
+
+static char command_line[256] = "";
+char saved_command_line[256];
+
+void setup_arch(char **cmdline_p,
+		unsigned long * memory_start_p, unsigned long * memory_end_p)
+{
+	st20_console_init();
+	printk("uClinux/ST20 on " ST20_BOARD_NAME ", gcc-2.7.2-t800 + ttools\n");
+	printk("KERNEL -> TEXT=%08lx-%08lx DATA=%08lx-%08lx BSS=%08lx-%08lx\n",
+	       (unsigned long) &_stext, (unsigned long) &_etext,
+	       (unsigned long) &_etext, (unsigned long) &_edata,
+	       (unsigned long) &_edata, (unsigned long) &_end);
+
+	{ extern void st20_icache_enable(void); st20_icache_enable(); }
+
+	/* user programs call the kernel through this word */
+	*(unsigned long *) ST20_SYSCALL_VECTOR = (unsigned long) st20_syscall;
+	st20_kstack = init_task.kernel_stack_page + PAGE_SIZE;
+
+	init_task.mm->start_code = (unsigned long) &_stext;
+	init_task.mm->end_code = (unsigned long) &_etext;
+	init_task.mm->end_data = (unsigned long) &_edata;
+	init_task.mm->brk = (unsigned long) &_end;
+
+	ROOT_DEV = MKDEV(BLKMEM_MAJOR, 0);
+
+	strcpy(saved_command_line, command_line);
+	*cmdline_p = command_line;
+	*memory_start_p = PAGE_ALIGN((unsigned long) &_end);
+	*memory_end_p = ST20_RAM_END;
+}
+
+int get_cpuinfo(char * buffer)
+{
+	return sprintf(buffer, "CPU:\t\tST20-C2 (STi5512)\nBogoMips:\t%lu.%02lu\n",
+		       loops_per_sec / 500000, (loops_per_sec / 5000) % 100);
+}
+
+void st20_reboot(void)
+{
+	cli();
+	for (;;)
+		;
+}
diff --git a/linux-2.0.x/arch/st20/kernel/signal.c b/linux-2.0.x/arch/st20/kernel/signal.c
new file mode 100644
index 000000000..a176ae6d9
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/signal.c
@@ -0,0 +1,150 @@
+/*
+ * arch/st20/kernel/signal.c - signal delivery for uClinux/ST20
+ *
+ * The user state at a delivery point is five words: Wptr, Iptr, Areg, Breg, Creg (exact:
+ * continuing there with `restart` resumes the program as if nothing happened).  For a user
+ * handler, st20_handle_signals pushes a context (old mask + that state) below the Wptr --
+ * on ST20 the workspace below Wptr is always free -- and makes the program continue in the
+ * handler as if called from st20_sigtramp (entry.ast, kernel text run in user mode), which
+ * calls sigreturn when the handler returns.  Delivery points: the end of every system call
+ * (syscalls.c) and the end of a preemption that interrupted user code (time.c), so a busy
+ * program still gets SIGINT.
+ */
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/kernel.h>
+#include <linux/signal.h>
+#include <linux/errno.h>
+#include <linux/wait.h>
+#include <linux/ptrace.h>
+#include <linux/unistd.h>
+#include <asm/segment.h>
+
+#define _S(nr) (1<<((nr)-1))
+#define _BLOCKABLE (~(_S(SIGKILL) | _S(SIGSTOP)))
+
+struct st20_sigctx {
+	unsigned long mask;
+	unsigned long state[5];		/* Wptr, Iptr, Areg, Breg, Creg */
+};
+
+extern void st20_sigtramp(void);
+asmlinkage int sys_waitpid(pid_t pid, unsigned long *stat_addr, int options);
+
+asmlinkage int sys_sigsuspend(int restart, unsigned long oldmask, unsigned long set)
+{
+	unsigned long mask = current->blocked;
+
+	current->blocked = set & _BLOCKABLE;
+	for (;;) {
+		current->state = TASK_INTERRUPTIBLE;
+		schedule();
+		if (current->signal & ~current->blocked)
+			break;
+	}
+	/* deliver with the new mask; the handler's context restores the old one */
+	current->tss.saved_mask = mask;
+	current->tss.saved_mask_valid = 1;
+	return -EINTR;
+}
+
+asmlinkage int sys_sigreturn(unsigned long __unused)
+{
+	struct pt_regs *regs = current->tss.regs;
+	struct st20_sigctx *ctx;
+	int i;
+
+	if (!regs)
+		return -EINVAL;
+	/* st20_sigtramp entered the kernel with its frame 4 words below the context */
+	ctx = (struct st20_sigctx *) (regs->wptr + 16);
+	if (verify_area(VERIFY_READ, ctx, sizeof(*ctx)))
+		do_exit(SIGSEGV);
+	current->blocked = ctx->mask & _BLOCKABLE;
+	for (i = 0; i < 5; i++)
+		current->tss.resume[i] = ctx->state[i];
+	current->tss.resume_valid = 1;
+	return ctx->state[2];
+}
+
+/* make the user state u[5] continue in the handler of signr */
+static void setup_frame(struct sigaction *sa, int signr, unsigned long *u, unsigned long oldmask)
+{
+	struct st20_sigctx *ctx;
+	unsigned long *frame;
+	int i;
+
+	ctx = (struct st20_sigctx *) ((u[0] - sizeof(*ctx)) & ~3UL);
+	frame = (unsigned long *) ctx - 4;
+	if (verify_area(VERIFY_WRITE, frame, sizeof(*ctx) + 16))
+		do_exit(SIGSEGV);
+	ctx->mask = oldmask;
+	for (i = 0; i < 5; i++)
+		ctx->state[i] = u[i];
+	frame[0] = (unsigned long) st20_sigtramp;	/* return address */
+	frame[1] = signr;				/* argument */
+	u[0] = (unsigned long) frame;
+	u[1] = (unsigned long) sa->sa_handler;
+	u[2] = signr;
+	u[3] = u[4] = 0;
+}
+
+/*
+ * Handles the pending signals of the current (user) task at a delivery point; u is its user
+ * state.  Returns 1 if u now runs a handler.
+ */
+int st20_handle_signals(unsigned long *u)
+{
+	unsigned long mask = ~current->blocked;
+	unsigned long oldmask = current->tss.saved_mask_valid ? current->tss.saved_mask
+							       : current->blocked;
+	unsigned long signr;
+	struct sigaction *sa;
+
+	while ((signr = current->signal & mask)) {
+		signr = ffz(~signr);
+		clear_bit(signr, &current->signal);
+		sa = current->sig->action + signr;
+		signr++;
+		if (sa->sa_handler == SIG_IGN) {
+			if (signr != SIGCHLD)
+				continue;
+			while (sys_waitpid(-1, NULL, WNOHANG) > 0)
+				;
+			continue;
+		}
+		if (sa->sa_handler == SIG_DFL) {
+			if (current->pid == 1)
+				continue;
+			switch (signr) {
+			case SIGCONT: case SIGCHLD: case SIGWINCH:
+				continue;
+			case SIGSTOP: case SIGTSTP: case SIGTTIN: case SIGTTOU:
+				current->state = TASK_STOPPED;
+				current->exit_code = signr;
+				if (!(current->p_pptr->sig->action[SIGCHLD-1].sa_flags &
+				      SA_NOCLDSTOP))
+					notify_parent(current, SIGCHLD);
+				schedule();
+				continue;
+			default:
+				current->signal |= _S(signr & 0x7f);
+				current->flags |= PF_SIGNALED;
+				do_exit(signr);
+			}
+		}
+		/* user handler */
+		setup_frame(sa, signr, u, oldmask);
+		if (sa->sa_flags & SA_ONESHOT)
+			sa->sa_handler = SIG_DFL;
+		if (!(sa->sa_flags & SA_NOMASK))
+			current->blocked |= (sa->sa_mask | _S(signr)) & _BLOCKABLE;
+		current->tss.saved_mask_valid = 0;
+		return 1;
+	}
+	if (current->tss.saved_mask_valid) {
+		current->blocked = current->tss.saved_mask;
+		current->tss.saved_mask_valid = 0;
+	}
+	return 0;
+}
diff --git a/linux-2.0.x/arch/st20/kernel/sys_st20.c b/linux-2.0.x/arch/st20/kernel/sys_st20.c
new file mode 100644
index 000000000..3776cdf70
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/sys_st20.c
@@ -0,0 +1,97 @@
+/*
+ * arch/st20/kernel/sys_st20.c - architecture specific system calls
+ */
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/sem.h>
+#include <linux/msg.h>
+#include <linux/shm.h>
+#include <linux/stat.h>
+#include <linux/mman.h>
+#include <linux/fs.h>
+#include <linux/time.h>
+#include <asm/segment.h>
+
+asmlinkage int sys_pipe(unsigned long * fildes)
+{
+	int fd[2];
+	int error;
+
+	error = verify_area(VERIFY_WRITE, fildes, 8);
+	if (error)
+		return error;
+	error = do_pipe(fd);
+	if (error)
+		return error;
+	put_user(fd[0], 0 + fildes);
+	put_user(fd[1], 1 + fildes);
+	return 0;
+}
+
+struct mmap_arg_struct {
+	unsigned long addr, len, prot, flags, fd, offset;
+};
+
+asmlinkage int old_mmap(struct mmap_arg_struct *arg)
+{
+	int error;
+	struct file * file = NULL;
+	struct mmap_arg_struct a;
+
+	error = verify_area(VERIFY_READ, arg, sizeof(*arg));
+	if (error)
+		return error;
+	memcpy_fromfs(&a, arg, sizeof(a));
+	if (!(a.flags & MAP_ANONYMOUS)) {
+		if (a.fd >= NR_OPEN || !(file = current->files->fd[a.fd]))
+			return -EBADF;
+	}
+	a.flags &= ~(MAP_EXECUTABLE | MAP_DENYWRITE);
+	return do_mmap(file, a.addr, a.len, a.prot, a.flags, a.offset);
+}
+
+asmlinkage int sys_ipc(void)
+{
+	return -ENOSYS;
+}
+
+asmlinkage int sys_cacheflush(void)
+{
+	return 0;
+}
+
+asmlinkage int sys_ioperm(void)
+{
+	return -ENOSYS;
+}
+
+asmlinkage int sys_ptrace(void)
+{
+	return -ENOSYS;
+}
+
+asmlinkage int sys_select(int n, fd_set *inp, fd_set *outp, fd_set *exp, struct timeval *tvp);
+
+struct sel_arg_struct {
+	unsigned long n;
+	fd_set *inp, *outp, *exp;
+	struct timeval *tvp;
+};
+
+asmlinkage int old_select(struct sel_arg_struct *arg)
+{
+	struct sel_arg_struct a;
+	int error;
+
+	error = verify_area(VERIFY_READ, arg, sizeof(*arg));
+	if (error)
+		return error;
+	memcpy_fromfs(&a, arg, sizeof(a));
+	return sys_select(a.n, a.inp, a.outp, a.exp, a.tvp);
+}
+
+/* no modules: nothing to export */
+void arch_syms_export(void)
+{
+}
diff --git a/linux-2.0.x/arch/st20/kernel/syscalls.c b/linux-2.0.x/arch/st20/kernel/syscalls.c
new file mode 100644
index 000000000..d0b037872
--- /dev/null
+++ b/linux-2.0.x/arch/st20/kernel/syscalls.c
@@ -0,0 +1,133 @@
+/*
+ * arch/st20/kernel/syscalls.c - system call table and dispatcher (generated list, same
+ * numbering as include/asm-st20/unistd.h)
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/errno.h>
+#include <linux/ptrace.h>
+#include <asm/system.h>
+
+/* #define ST20_TRACE_SYSCALLS */	/* printk fork/exec/exit/wait4 calls */
+
+typedef long (*syscall_t)(long, long, long, long, long);
+extern const syscall_t st20_sys_call_table[];
+extern const unsigned long st20_nr_syscalls;
+
+
+extern void st20_return_to_user(unsigned long *uw, long result);
+extern void st20_restart(unsigned long *record);
+extern int st20_handle_signals(unsigned long *u);
+
+static long dispatch(struct pt_regs *regs)
+{
+	unsigned long nr = regs->orig_nr;
+
+	if (nr >= st20_nr_syscalls)
+		return -ENOSYS;
+	return st20_sys_call_table[nr](regs->arg[0], regs->arg[1], regs->arg[2],
+				       regs->arg[3], regs->arg[4]);
+}
+
+#define ST20_STATUS_VALID	0x80000000UL
+#define ST20_TRAP_REASON	0x00003fffUL
+
+/*
+ * Continues user code exactly at u = { Wptr, Iptr, Areg, Breg, Creg } (exec, sigreturn,
+ * signal handlers): a state record with the current enables/status (stshadow of our own
+ * priority) and `restart`.  Never returns.
+ */
+void st20_resume_user(unsigned long *u)
+{
+	unsigned long rec[7];
+	int i;
+
+	sti();
+	__asm__ __volatile__ ("stshadow" : : "cP" (rec), "bP" (1), "aP" (7) : "memory");
+	rec[1] = (rec[1] | ST20_STATUS_VALID) & ~ST20_TRAP_REASON;
+	for (i = 0; i < 5; i++)
+		rec[2 + i] = u[i];
+	st20_restart(rec);
+}
+
+/*
+ * Called from st20_syscall (entry.s) on the task's kernel stack.  uw is the caller's
+ * workspace: uw[0] = return Iptr, uw[1..6] = nr, a..e.  A plain return goes back through
+ * entry.s (`ret` on uw with Areg = result); exec, sigreturn and signal handlers continue
+ * through st20_resume_user.
+ */
+long st20_syscall_c(unsigned long *uw)
+{
+	struct pt_regs regs;
+	struct pt_regs *saved = current->tss.regs;
+	unsigned long u[5];
+	int i, exact = 0;
+	long res;
+
+	regs.orig_nr = uw[1];
+	for (i = 0; i < 5; i++)
+		regs.arg[i] = uw[2 + i];
+	regs.wptr = (unsigned long) uw;
+	regs.iptr = uw[0];
+	regs.status = PS_USER;
+	current->tss.regs = &regs;
+	current->tss.usp = (unsigned long) uw;
+	current->tss.resume_valid = 0;
+#ifdef ST20_TRACE_SYSCALLS
+	if (regs.orig_nr == 2 || regs.orig_nr == 11 || regs.orig_nr == 1 || regs.orig_nr == 114)
+		printk("[pid %d sys %ld(%lx,%lx,%lx) uw=%p ret=%lx]\n", current->pid, regs.orig_nr,
+		       regs.arg[0], regs.arg[1], regs.arg[2], uw, uw[0]);
+#endif
+	res = dispatch(&regs);
+	if (res == -ERESTARTSYS || res == -ERESTARTNOINTR || res == -ERESTARTNOHAND)
+		res = -EINTR;		/* no system call restarting yet */
+	current->tss.regs = saved;
+
+	if (current->tss.resume_valid) {	/* exec or sigreturn */
+		for (i = 0; i < 5; i++)
+			u[i] = current->tss.resume[i];
+		current->tss.resume_valid = 0;
+		exact = 1;
+	} else {
+		/* as `ret` would continue: Iptr = uw[0], Wptr = uw + 4 words, Areg = result
+		   (vfork: the child ran on this stack, so uw[0] comes from pt_regs) */
+		uw[0] = regs.iptr;
+		u[0] = (unsigned long) (uw + 4);
+		u[1] = regs.iptr;
+		u[2] = res;
+		u[3] = u[4] = 0;
+	}
+	if (need_resched)		/* return to user mode: the place to reschedule */
+		schedule();
+	if (((current->signal & ~current->blocked) || current->tss.saved_mask_valid) &&
+	    st20_handle_signals(u))
+		exact = 1;
+	if (exact)
+		st20_resume_user(u);
+	return res;
+}
+
+/* the kernel's own _syscallN calls (init/main.c): same table, no stack switch */
+long st20_kernel_syscall(long nr, long a, long b, long c, long d, long e)
+{
+	struct pt_regs regs;
+	struct pt_regs *saved = current->tss.regs;
+	unsigned long here;
+	long res;
+
+	regs.orig_nr = nr;
+	regs.arg[0] = a; regs.arg[1] = b; regs.arg[2] = c; regs.arg[3] = d; regs.arg[4] = e;
+	regs.wptr = (unsigned long) &here;
+	regs.iptr = 0;
+	regs.status = 0;
+	current->tss.regs = &regs;
+	current->tss.resume_valid = 0;
+	res = dispatch(&regs);
+	current->tss.regs = saved;
+	if (current->tss.resume_valid) {
+		/* a kernel thread exec'ed a user program (init): enter it */
+		current->tss.resume_valid = 0;
+		st20_resume_user(current->tss.resume);
+	}
+	return res;
+}
