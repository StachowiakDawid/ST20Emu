+#ifdef __transputer__
+/* uClinux/ST20: sys_sigsuspend(restart, oldmask, set) through the kernel entry */
+int
+sigsuspend (const sigset_t *sigmask)
+{
+	typedef long (*st20_syscall_t)(long, long, long, long, long, long);
+	long res = (*(st20_syscall_t *) 0xc0000000)(SYS_sigsuspend, 0, 0,
+						      (long) *sigmask, 0, 0);
+	if (res >= 0)
+		return res;
+	errno = -res;
+	return -1;
+}
