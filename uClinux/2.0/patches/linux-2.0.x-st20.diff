diff --git a/lib/libc/sysdeps/st20/sysdep.h b/lib/libc/sysdeps/st20/sysdep.h
new file mode 100644
index 000000000..a7d45c088
--- /dev/null
+++ b/lib/libc/sysdeps/st20/sysdep.h
@@ -0,0 +1,26 @@
+/* sysdeps/st20/sysdep.h - uC-libc system call stubs for uClinux/ST20
+ *
+ * The sysdeps *.S stubs (SYSCALL_RET(name, nargs) ...) are compiled as C on ST20 (see
+ * sysdeps/Makefile): each becomes a C function that calls the kernel entry stored at
+ * 0xc0000000 with the call number and five argument words.  The gcc-t800 callee reads
+ * arguments from its frame, so fewer real arguments are harmless.
+ */
+#include <errno.h>
+#include <sys/syscall.h>
+
+typedef long (*__st20_syscall_t)(long, long, long, long, long, long);
+
+#define __ST20_SYSCALL(func, nr)						\
+long func(long a, long b, long c, long d, long e)				\
+{										\
+	long r = (*(__st20_syscall_t *) 0xc0000000)((nr), a, b, c, d, e);	\
+	if ((unsigned long) r >= (unsigned long) -125) {			\
+		errno = -r;							\
+		r = -1;								\
+	}									\
+	return r;								\
+}
+
+#define SYSCALL_RET(name, args)		__ST20_SYSCALL(name, SYS_##name)
+#define SYSCALL_RET_X(func, name, args)	__ST20_SYSCALL(func, SYS_##name)
+#define SYSCALL_WEAK_ALIAS(alias, name)
diff --git a/lib/libc/sysdeps/st20/vfork.ast b/lib/libc/sysdeps/st20/vfork.ast
new file mode 100644
index 000000000..1ca219381
--- /dev/null
+++ b/lib/libc/sysdeps/st20/vfork.ast
@@ -0,0 +1,20 @@
+// sysdeps/st20/vfork.ast - vfork() and fork() for uClinux/ST20 (no MMU: fork = vfork)
+//
+// The child runs on the parent's stack until it execs or exits, so a C stub's frame would be
+// overwritten before the parent returns.  This stub has no frame of its own: it stores the
+// call number in its argument slot and jumps (gcall) into the kernel entry, which takes this
+// Wptr as the caller's frame and returns straight to vfork's caller; the kernel restores the
+// return Iptr in that frame from pt_regs (arch/st20/kernel/syscalls.c).
+.text
+// one global label per fragment: lit drops fragments nobody needs, so an alias label
+// right after another would leave the first one empty; aliases are assignments
+.globl _vfork;
+_vfork:
+	ldc 2		// __NR_fork, which is vfork on uClinux/ST20 (CLONE_WAIT)
+	stl 1
+	ldc -1073741824	// 0xc0000000: the kernel entry pointer
+	ldnl 0
+	gcall
+
+.globl _fork;
+_fork = _vfork
