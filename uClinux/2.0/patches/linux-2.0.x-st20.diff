 sigsuspend (const sigset_t *sigmask)
 {
@@ -47,5 +61,6 @@ sigsuspend (const sigset_t *sigmask)
 	errno = -res;
 	return -1;
 }
+#endif /* __transputer__ */
 
 #endif /* PTHREAD_KERNEL */
