diff --git a/linux-2.0.x/fs/binfmt_script.c b/linux-2.0.x/fs/binfmt_script.c
index c1cfc661c..e88b6b06a 100644
--- a/linux-2.0.x/fs/binfmt_script.c
+++ b/linux-2.0.x/fs/binfmt_script.c
@@ -99,11 +99,26 @@ static int do_load_script(struct linux_binprm *bprm,struct pt_regs *regs)
 		char ** oldargv = bprm->argv;
 		int oldargc = bprm->argc;
 		int i;
+		char *names;
 		
+		/* i_name and i_arg point into bprm->buf, which prepare_binprm() below
+		   overwrites with the interpreter's header: keep copies */
+		names = kmalloc(strlen(interp) + 1 + (i_arg ? strlen(i_arg) + 1 : 0),
+				GFP_KERNEL);
+		if (!names)
+			return -ENOMEM;
+		strcpy(names, interp);		/* full path; i_name is its basename */
+		i_name = names + (i_name - interp);
+		interp = names;
+		if (i_arg) {
+			strcpy(names + strlen(names) + 1, i_arg);
+			i_arg = names + strlen(names) + 1;
+		}
 		bprm->argc = oldargc + (i_arg ? 2 : 1);
 		bprm->argv = kmalloc(sizeof(char*) * bprm->argc, GFP_KERNEL);
 		
 		if (!bprm->argv) {
+			kfree(names);
 			bprm->argc = oldargc;
 			bprm->argv = oldargv;
 			return -E2BIG;
@@ -134,6 +149,7 @@ static int do_load_script(struct linux_binprm *bprm,struct pt_regs *regs)
 		}
 		
 		kfree(bprm->argv);
+		kfree(names);
 		bprm->argv = oldargv;
 		bprm->argc = oldargc;
 
