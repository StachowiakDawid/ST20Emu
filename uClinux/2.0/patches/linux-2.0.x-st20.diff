+extern long mach_max_dma_address;
+extern void (*mach_debug_init)(void);
+extern void (*mach_video_setup)(char *, int *);
+extern void (*mach_floppy_setup)(char *, int *);
+extern void (*mach_floppy_eject)(void);
+
+#endif /* _M68K_MACHDEP_H */
