diff --git a/user/busybox/hexdump.c b/user/busybox/hexdump.c
new file mode 100644
index 000000000..f2a1326ff
--- /dev/null
+++ b/user/busybox/hexdump.c
@@ -0,0 +1,105 @@
+/* vi: set sw=4 ts=4: */
+/*
+ * Mini hexdump implementation for busybox (uClinux ST20 port).
+ * Canonical "hexdump -C" style output: offset, 16 hex bytes, ASCII.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <getopt.h>
+#include "busybox.h"
+
+static long skip_bytes;
+static long max_bytes = -1;
+
+static int hexdump_file(FILE *fp, long *offset)
+{
+	unsigned char buf[16], prev[16];
+	int n, i, same = 0, have_prev = 0;
+
+	while (max_bytes != 0) {
+		int want = 16;
+		if (max_bytes > 0 && max_bytes < want)
+			want = max_bytes;
+		n = fread(buf, 1, want, fp);
+		if (n <= 0)
+			break;
+		if (max_bytes > 0)
+			max_bytes -= n;
+		if (have_prev && n == 16 && memcmp(buf, prev, 16) == 0) {
+			if (!same)
+				puts("*");
+			same = 1;
+			*offset += n;
+			continue;
+		}
+		same = 0;
+		printf("%08lx ", *offset);
+		for (i = 0; i < 16; i++) {
+			if (i == 8)
+				putchar(' ');
+			if (i < n)
+				printf(" %02x", buf[i]);
+			else
+				fputs("   ", stdout);
+		}
+		fputs("  |", stdout);
+		for (i = 0; i < n; i++)
+			putchar(buf[i] >= 0x20 && buf[i] < 0x7f ? buf[i] : '.');
+		puts("|");
+		memcpy(prev, buf, 16);
+		have_prev = (n == 16);
+		*offset += n;
+	}
+	return ferror(fp) ? EXIT_FAILURE : EXIT_SUCCESS;
+}
+
+extern int hexdump_main(int argc, char **argv)
+{
+	int opt, status = EXIT_SUCCESS;
+	long offset;
+	FILE *fp;
+
+	while ((opt = getopt(argc, argv, "Cs:n:")) > 0) {
+		switch (opt) {
+		case 'C':
+			break;
+		case 's':
+			skip_bytes = strtol(optarg, NULL, 0);
+			break;
+		case 'n':
+			max_bytes = strtol(optarg, NULL, 0);
+			break;
+		default:
+			show_usage();
+		}
+	}
+
+	offset = skip_bytes;
+	if (optind >= argc) {
+		while (skip_bytes > 0 && getchar() != EOF)
+			skip_bytes--;
+		status = hexdump_file(stdin, &offset);
+	} else {
+		for (; optind < argc; optind++) {
+			if ((fp = wfopen(argv[optind], "r")) == NULL) {
+				status = EXIT_FAILURE;
+				continue;
+			}
+			if (skip_bytes)
+				fseek(fp, skip_bytes, SEEK_SET);
+			if (hexdump_file(fp, &offset) != EXIT_SUCCESS)
+				status = EXIT_FAILURE;
+			fclose(fp);
+		}
+	}
+	printf("%08lx\n", offset);
+	return status;
+}
