diff --git a/lib/libc/regex/Makefile b/lib/libc/regex/Makefile
new file mode 100644
index 000000000..20f60dbfc
--- /dev/null
+++ b/lib/libc/regex/Makefile
@@ -0,0 +1,15 @@
+# POSIX regex (regcomp/regexec/regerror/regfree), used instead of the V8 regexp
+# library on MACHINE=st20 (the two share the names regcomp/regexec/regerror).
+LIBC=../libc.a
+OBJ=regex.o
+
+all: $(LIBC)
+
+$(LIBC): $(LIBC)($(OBJ))
+
+$(LIBC)(regex.o): regex.c ../include/regex.h
+	$(CC) $(CFLAGS) $< -c -o $*.o
+	$(AR) $(ARFLAGS) $@ $*.o
+
+clean:
+	rm -f *.o
diff --git a/lib/libc/regex/regex.c b/lib/libc/regex/regex.c
new file mode 100644
index 000000000..4db1e10ba
--- /dev/null
+++ b/lib/libc/regex/regex.c
@@ -0,0 +1,757 @@
+/*
+ * POSIX regcomp/regexec/regerror/regfree for uC-libc (uClinux ST20 port).
+ *
+ * A small backtracking matcher.  Supported: BRE and ERE (REG_EXTENDED), '.',
+ * bracket expressions with ranges and [:class:], anchors, '*', '+', '?',
+ * intervals {m,n} (BRE \{m,n\}), groups, alternation (ERE '|', BRE '\|'),
+ * back references \1..\9, GNU \< \> \b \B \w \W, REG_ICASE, REG_NEWLINE,
+ * REG_NOSUB, REG_NOTBOL, REG_NOTEOL.  BRE also accepts the GNU \+ and \?.
+ * Matches are leftmost; among those the first alternative and the greedy
+ * repetition win (Perl-like), not the POSIX leftmost-longest rule.
+ *
+ * Copyright (C) 2026, released under the GNU LGPL like the rest of uC-libc.
+ */
+
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <regex.h>
+
+enum {
+	N_CHAR, N_ANY, N_SET, N_BOL, N_EOL, N_GROUP, N_SEQ, N_BREF,
+	N_WBEG, N_WEND, N_WORDB, N_NWORDB
+};
+
+#define DUP_MAX 255
+
+struct node {
+	struct node *next;	/* next element of the sequence */
+	struct node *alt;	/* N_GROUP: first N_SEQ; N_SEQ: first element */
+	struct node *nalt;	/* N_SEQ: next alternative */
+	struct node *all;	/* list of every node, for regfree */
+	unsigned char *set;	/* N_SET: 256-bit map */
+	short min, max;		/* repetition, max < 0 = unbounded */
+	unsigned char type;
+	int c;			/* N_CHAR: char; N_GROUP: index (-1 = none); N_BREF: index */
+};
+
+struct prog {
+	struct node *root;
+	struct node *all;
+	int cflags;
+	int bol_only;		/* pattern starts with '^' (no REG_NEWLINE) */
+};
+
+struct pstate {
+	const unsigned char *p;
+	int ere, icase, nl;
+	int err;
+	int ngroups;
+	struct node *all;
+};
+
+static struct node *new_node(struct pstate *ps, int type)
+{
+	struct node *n = calloc(1, sizeof(*n));
+
+	if (!n) {
+		ps->err = REG_ESPACE;
+		return NULL;
+	}
+	n->type = type;
+	n->min = n->max = 1;
+	n->all = ps->all;
+	ps->all = n;
+	return n;
+}
+
+static void free_nodes(struct node *n)
+{
+	struct node *next;
+
+	for (; n; n = next) {
+		next = n->all;
+		free(n->set);
+		free(n);
+	}
+}
+
+static int is_word(int c)
+{
+	return c == '_' || isalnum(c);
+}
+
+#define SETBIT(s, c)	((s)[(unsigned char)(c) >> 3] |= 1 << ((c) & 7))
+#define TSTBIT(s, c)	((s)[(unsigned char)(c) >> 3] & (1 << ((c) & 7)))
+
+static void set_add(struct pstate *ps, unsigned char *set, int c)
+{
+	SETBIT(set, c);
+	if (ps->icase) {
+		SETBIT(set, tolower(c));
+		SETBIT(set, toupper(c));
+	}
+}
+
+static const char *const class_names[] = {
+	"alpha", "digit", "alnum", "upper", "lower", "space", "blank", "punct",
+	"print", "graph", "cntrl", "xdigit", NULL
+};
+
+static int in_class(int k, int c)
+{
+	switch (k) {
+	case 0: return isalpha(c);
+	case 1: return isdigit(c);
+	case 2: return isalnum(c);
+	case 3: return isupper(c);
+	case 4: return islower(c);
+	case 5: return isspace(c);
+	case 6: return c == ' ' || c == '\t';
+	case 7: return ispunct(c);
+	case 8: return isprint(c);
+	case 9: return isgraph(c);
+	case 10: return iscntrl(c);
+	case 11: return isxdigit(c);
+	}
+	return 0;
+}
+
+static struct node *word_set(struct pstate *ps, int neg)
+{
+	struct node *n = new_node(ps, N_SET);
+	int c;
+
+	if (!n)
+		return NULL;
+	if (!(n->set = calloc(32, 1))) {
+		ps->err = REG_ESPACE;
+		return NULL;
+	}
+	for (c = 1; c < 256; c++)
+		if (is_word(c) != neg)
+			SETBIT(n->set, c);
+	return n;
+}
+
+/* bracket expression; ps->p is just past '[' */
+static struct node *parse_set(struct pstate *ps)
+{
+	const unsigned char *p = ps->p;
+	struct node *n = new_node(ps, N_SET);
+	unsigned char *set;
+	int neg = 0, first = 1, lo, hi, c, k;
+
+	if (!n)
+		return NULL;
+	if (!(set = n->set = calloc(32, 1))) {
+		ps->err = REG_ESPACE;
+		return NULL;
+	}
+	if (*p == '^') {
+		neg = 1;
+		p++;
+	}
+	while (*p && (*p != ']' || first)) {
+		first = 0;
+		if (p[0] == '[' && p[1] == ':') {
+			const unsigned char *e = p + 2;
+			while (*e && !(e[0] == ':' && e[1] == ']'))
+				e++;
+			if (!*e) {
+				ps->err = REG_EBRACK;
+				return NULL;
+			}
+			for (k = 0; class_names[k]; k++)
+				if ((int) strlen(class_names[k]) == e - p - 2 &&
+				    !strncmp(class_names[k], (const char *) p + 2, e - p - 2))
+					break;
+			if (!class_names[k]) {
+				ps->err = REG_ECTYPE;
+				return NULL;
+			}
+			for (c = 1; c < 256; c++)
+				if (in_class(k, c))
+					set_add(ps, set, c);
+			p = e + 2;
+			continue;
+		}
+		if (p[0] == '[' && (p[1] == '.' || p[1] == '=') && p[2] &&
+		    p[3] == p[1] && p[4] == ']') {
+			lo = p[2];
+			p += 5;
+		} else
+			lo = *p++;
+		hi = lo;
+		if (p[0] == '-' && p[1] && p[1] != ']') {
+			p++;
+			if (p[0] == '[' && (p[1] == '.' || p[1] == '=') && p[2] &&
+			    p[3] == p[1] && p[4] == ']') {
+				hi = p[2];
+				p += 5;
+			} else
+				hi = *p++;
+			if (hi < lo) {
+				ps->err = REG_ERANGE;
+				return NULL;
+			}
+		}
+		for (c = lo; c <= hi; c++)
+			set_add(ps, set, c);
+	}
+	if (!*p) {
+		ps->err = REG_EBRACK;
+		return NULL;
+	}
+	ps->p = p + 1;
+	if (neg) {
+		for (c = 0; c < 32; c++)
+			set[c] = ~set[c];
+		if (ps->nl)
+			set['\n' >> 3] &= ~(1 << ('\n' & 7));
+	}
+	set[0] &= ~1;		/* never NUL */
+	return n;
+}
+
+static int parse_num(struct pstate *ps)
+{
+	int v = -1;
+
+	while (isdigit(*ps->p)) {
+		v = (v < 0 ? 0 : v * 10) + *ps->p++ - '0';
+		if (v > DUP_MAX)
+			return DUP_MAX + 1;
+	}
+	return v;
+}
+
+/* interval body; ps->p is just past '{' / "\{" */
+static int parse_interval(struct pstate *ps, int *min, int *max)
+{
+	int lo, hi;
+
+	lo = parse_num(ps);
+	if (lo < 0 || lo > DUP_MAX)
+		return REG_BADBR;
+	hi = lo;
+	if (*ps->p == ',') {
+		ps->p++;
+		hi = parse_num(ps);
+		if (hi > DUP_MAX)
+			return REG_BADBR;
+		if (hi >= 0 && hi < lo)
+			return REG_BADBR;
+	}
+	if (ps->ere) {
+		if (*ps->p != '}')
+			return REG_EBRACE;
+		ps->p++;
+	} else {
+		if (ps->p[0] != '\\' || ps->p[1] != '}')
+			return REG_EBRACE;
+		ps->p += 2;
+	}
+	*min = lo;
+	*max = hi;
+	return 0;
+}
+
+static struct node *parse_alts(struct pstate *ps, struct node *group, int depth);
+
+/* one sequence, up to '|' / ')' (ERE) or "\|" / "\)" (BRE) or the end */
+static struct node *parse_seq(struct pstate *ps, int depth)
+{
+	struct node *head = NULL, **tail = &head, **lastslot = NULL, *n;
+	int start = 1, c, min, max, err;
+
+	for (;;) {
+		const unsigned char *p = ps->p;
+
+		c = *p;
+		if (!c)
+			break;
+		if (ps->ere) {
+			if (c == '|' || (c == ')' && depth))
+				break;
+		} else if (c == '\\' && (p[1] == '|' || (p[1] == ')' && depth)))
+			break;
+
+		/* quantifier? */
+		min = -2;
+		if (ps->ere) {
+			if (c == '*') { min = 0; max = -1; ps->p++; }
+			else if (c == '+') { min = 1; max = -1; ps->p++; }
+			else if (c == '?') { min = 0; max = 1; ps->p++; }
+			else if (c == '{' && isdigit(p[1]) && lastslot) {
+				ps->p++;
+				if ((err = parse_interval(ps, &min, &max)) != 0) {
+					ps->err = err;
+					return NULL;
+				}
+			}
+		} else {
+			if (c == '*' && !start) { min = 0; max = -1; ps->p++; }
+			else if (c == '\\' && p[1] == '+' && lastslot) { min = 1; max = -1; ps->p += 2; }
+			else if (c == '\\' && p[1] == '?' && lastslot) { min = 0; max = 1; ps->p += 2; }
+			else if (c == '\\' && p[1] == '{' && lastslot) {
+				ps->p += 2;
+				if ((err = parse_interval(ps, &min, &max)) != 0) {
+					ps->err = err;
+					return NULL;
+				}
+			}
+		}
+		if (min != -2) {
+			if (!lastslot) {
+				if (ps->ere && c != '*') {
+					ps->err = REG_BADRPT;
+					return NULL;
+				}
+				/* a leading '*' is literal */
+				goto literal;
+			}
+			n = *lastslot;
+			if (n->type >= N_BOL && n->type != N_GROUP && n->type != N_BREF)
+				continue;	/* repeated anchor: ignore */
+			if (n->min != 1 || n->max != 1) {
+				/* already repeated: wrap in a non-capturing group */
+				struct node *g = new_node(ps, N_GROUP), *s = new_node(ps, N_SEQ);
+				if (!g || !s)
+					return NULL;
+				g->c = -1;
+				g->alt = s;
+				s->alt = n;
+				g->next = n->next;
+				n->next = NULL;
+				*lastslot = g;
+				if (tail == &n->next)
+					tail = &g->next;
+				n = g;
+			}
+			n->min = min;
+			n->max = max;
+			start = 0;
+			continue;
+		}
+
+		/* atom */
+		n = NULL;
+		if (c == '.') {
+			ps->p++;
+			n = new_node(ps, N_ANY);
+		} else if (c == '[') {
+			ps->p++;
+			n = parse_set(ps);
+		} else if (c == '^' && (ps->ere || start)) {
+			ps->p++;
+			n = new_node(ps, N_BOL);
+			if (!n)
+				return NULL;
+			*tail = n;
+			tail = &n->next;
+			lastslot = NULL;
+			continue;	/* start stays set: "^*" is a literal star */
+		} else if (c == '$' && (ps->ere || !p[1] ||
+			   (p[1] == '\\' && (p[2] == '|' || (p[2] == ')' && depth))))) {
+			ps->p++;
+			n = new_node(ps, N_EOL);
+		} else if ((ps->ere && c == '(') || (!ps->ere && c == '\\' && p[1] == '(')) {
+			ps->p += ps->ere ? 1 : 2;
+			n = new_node(ps, N_GROUP);
+			if (!n)
+				return NULL;
+			n->c = ++ps->ngroups;
+			if (!parse_alts(ps, n, depth + 1))
+				return NULL;
+			if (ps->ere ? *ps->p != ')' : (ps->p[0] != '\\' || ps->p[1] != ')')) {
+				ps->err = REG_EPAREN;
+				return NULL;
+			}
+			ps->p += ps->ere ? 1 : 2;
+		} else if (c == '\\') {
+			c = p[1];
+			ps->p += 2;
+			if (!c) {
+				ps->err = REG_EESCAPE;
+				return NULL;
+			} else if (c >= '1' && c <= '9') {
+				if (c - '0' > ps->ngroups) {
+					ps->err = REG_ESUBREG;
+					return NULL;
+				}
+				n = new_node(ps, N_BREF);
+				if (n)
+					n->c = c - '0';
+			} else if (c == '<')
+				n = new_node(ps, N_WBEG);
+			else if (c == '>')
+				n = new_node(ps, N_WEND);
+			else if (c == 'b')
+				n = new_node(ps, N_WORDB);
+			else if (c == 'B')
+				n = new_node(ps, N_NWORDB);
+			else if (c == 'w' || c == 'W')
+				n = word_set(ps, c == 'W');
+			else {
+				if (c == 'n')
+					c = '\n';
+				else if (c == 't')
+					c = '\t';
+				goto char_node;
+			}
+		} else {
+		literal:
+			ps->p = p + 1;
+		char_node:
+			n = new_node(ps, N_CHAR);
+			if (n)
+				n->c = ps->icase ? tolower(c) : c;
+		}
+		if (!n)
+			return NULL;
+		*tail = n;
+		lastslot = tail;
+		tail = &n->next;
+		start = 0;
+	}
+	ps->err = 0;
+	return head;
+}
+
+/* alternatives of GROUP; each becomes an N_SEQ in group->alt */
+static struct node *parse_alts(struct pstate *ps, struct node *group, int depth)
+{
+	struct node **tail = &group->alt, *s;
+
+	for (;;) {
+		s = new_node(ps, N_SEQ);
+		if (!s)
+			return NULL;
+		s->alt = parse_seq(ps, depth);
+		if (ps->err)
+			return NULL;
+		*tail = s;
+		tail = &s->nalt;
+		if (ps->ere && *ps->p == '|')
+			ps->p++;
+		else if (!ps->ere && ps->p[0] == '\\' && ps->p[1] == '|')
+			ps->p += 2;
+		else
+			break;
+	}
+	return group;
+}
+
+int regcomp(regex_t *preg, const char *pattern, int cflags)
+{
+	struct pstate ps;
+	struct prog *prog;
+	struct node *root, *first;
+
+	memset(&ps, 0, sizeof(ps));
+	ps.p = (const unsigned char *) pattern;
+	ps.ere = (cflags & REG_EXTENDED) != 0;
+	ps.icase = (cflags & REG_ICASE) != 0;
+	ps.nl = (cflags & REG_NEWLINE) != 0;
+	prog = malloc(sizeof(*prog));
+	if (!prog)
+		return REG_ESPACE;
+	root = new_node(&ps, N_GROUP);
+	if (root) {
+		root->c = 0;
+		if (parse_alts(&ps, root, 0) && *ps.p)
+			ps.err = ps.ere ? REG_EPAREN : REG_EPAREN;
+	}
+	if (ps.err) {
+		free_nodes(ps.all);
+		free(prog);
+		return ps.err;
+	}
+	prog->root = root;
+	prog->all = ps.all;
+	prog->cflags = cflags;
+	first = root->alt->alt;
+	prog->bol_only = !root->alt->nalt && first && first->type == N_BOL && !ps.nl;
+	preg->re_nsub = ps.ngroups;
+	preg->re_prog = prog;
+	preg->re_cflags = cflags;
+	return 0;
+}
+
+void regfree(regex_t *preg)
+{
+	struct prog *prog = preg->re_prog;
+
+	if (prog) {
+		free_nodes(prog->all);
+		free(prog);
+		preg->re_prog = NULL;
+	}
+}
+
+/* ---- matching ---- */
+
+struct mctx {
+	const unsigned char *bol;
+	int icase, nl, notbol, noteol;
+	const unsigned char **so, **eo;
+};
+
+struct cont {
+	struct node *g;			/* group whose iteration just ended */
+	int count;			/* iterations including this one */
+	const unsigned char *start;	/* where this iteration started */
+	struct cont *up;
+};
+
+static const unsigned char *m_seq(struct mctx *m, struct node *n,
+				  const unsigned char *s, struct cont *k);
+
+static int single(struct mctx *m, struct node *n, const unsigned char *s)
+{
+	int c = *s;
+
+	if (!c)
+		return 0;
+	switch (n->type) {
+	case N_CHAR:
+		return (m->icase ? tolower(c) : c) == n->c;
+	case N_ANY:
+		return !(m->nl && c == '\n');
+	default:		/* N_SET */
+		return TSTBIT(n->set, c) != 0;
+	}
+}
+
+static int at_bol(struct mctx *m, const unsigned char *s)
+{
+	if (s == m->bol)
+		return !m->notbol;
+	return m->nl && s[-1] == '\n';
+}
+
+static int at_eol(struct mctx *m, const unsigned char *s)
+{
+	if (!*s)
+		return !m->noteol;
+	return m->nl && *s == '\n';
+}
+
+static int bref_at(struct mctx *m, const unsigned char *s,
+		   const unsigned char *so, int len)
+{
+	int i;
+
+	if (!m->icase)
+		return !strncmp((const char *) s, (const char *) so, len);
+	for (i = 0; i < len; i++)
+		if (!s[i] || tolower(s[i]) != tolower(so[i]))
+			return 0;
+	return 1;
+}
+
+static const unsigned char *group_iter(struct mctx *m, struct node *g,
+				       const unsigned char *s, int count,
+				       struct cont *k)
+{
+	const unsigned char *r;
+	struct node *a;
+
+	if (g->max < 0 || count < g->max) {
+		struct cont kk;
+
+		kk.g = g;
+		kk.count = count + 1;
+		kk.start = s;
+		kk.up = k;
+		for (a = g->alt; a; a = a->nalt)
+			if ((r = m_seq(m, a->alt, s, &kk)) != NULL)
+				return r;
+	}
+	if (count >= g->min)
+		return m_seq(m, g->next, s, k);
+	return NULL;
+}
+
+static const unsigned char *m_cont(struct mctx *m, const unsigned char *s,
+				   struct cont *k)
+{
+	const unsigned char *r, *oso = NULL, *oeo = NULL;
+	struct node *g;
+	int c;
+
+	if (!k)
+		return s;
+	g = k->g;
+	if (s == k->start && k->count > g->min)
+		return NULL;	/* empty iteration: stop looping */
+	c = g->c;
+	if (c >= 0) {
+		oso = m->so[c];
+		oeo = m->eo[c];
+		m->so[c] = k->start;
+		m->eo[c] = s;
+	}
+	r = group_iter(m, g, s, k->count, k->up);
+	if (!r && c >= 0) {
+		m->so[c] = oso;
+		m->eo[c] = oeo;
+	}
+	return r;
+}
+
+static const unsigned char *m_seq(struct mctx *m, struct node *n,
+				  const unsigned char *s, struct cont *k)
+{
+	const unsigned char *r;
+	int i, len, pw, cw;
+
+	for (;;) {
+		if (!n)
+			return m_cont(m, s, k);
+		switch (n->type) {
+		case N_CHAR:
+		case N_ANY:
+		case N_SET:
+			if (n->min == 1 && n->max == 1) {
+				if (!single(m, n, s))
+					return NULL;
+				s++;
+				n = n->next;
+				continue;
+			}
+			for (i = 0; (n->max < 0 || i < n->max) && single(m, n, s + i); i++)
+				;
+			for (; i >= n->min; i--)
+				if ((r = m_seq(m, n->next, s + i, k)) != NULL)
+					return r;
+			return NULL;
+		case N_BOL:
+			if (!at_bol(m, s))
+				return NULL;
+			break;
+		case N_EOL:
+			if (!at_eol(m, s))
+				return NULL;
+			break;
+		case N_WBEG:
+		case N_WEND:
+		case N_WORDB:
+		case N_NWORDB:
+			pw = s > m->bol && is_word(s[-1]);
+			cw = *s && is_word(*s);
+			if (n->type == N_WBEG ? !(!pw && cw) :
+			    n->type == N_WEND ? !(pw && !cw) :
+			    n->type == N_WORDB ? pw == cw : pw != cw)
+				return NULL;
+			break;
+		case N_BREF:
+			if (!m->so[n->c] || !m->eo[n->c])
+				return NULL;
+			len = m->eo[n->c] - m->so[n->c];
+			if (len == 0)
+				break;
+			for (i = 0; (n->max < 0 || i < n->max) &&
+				    bref_at(m, s + i * len, m->so[n->c], len); i++)
+				;
+			for (; i >= n->min; i--)
+				if ((r = m_seq(m, n->next, s + i * len, k)) != NULL)
+					return r;
+			return NULL;
+		case N_GROUP:
+			return group_iter(m, n, s, 0, k);
+		default:
+			return NULL;
+		}
+		n = n->next;
+	}
+}
+
+int regexec(const regex_t *preg, const char *string, size_t nmatch,
+	    regmatch_t pmatch[], int eflags)
+{
+	struct prog *prog = preg->re_prog;
+	const unsigned char *sobuf[10], *eobuf[10], *s, *r;
+	struct mctx m;
+	size_t i, n = preg->re_nsub + 1;
+	int ret = REG_NOMATCH;
+
+	if (!prog)
+		return REG_BADPAT;
+	if (prog->cflags & REG_NOSUB)
+		nmatch = 0;
+	if (n <= 10) {
+		m.so = sobuf;
+		m.eo = eobuf;
+	} else {
+		m.so = malloc(2 * n * sizeof(*m.so));
+		if (!m.so)
+			return REG_ESPACE;
+		m.eo = m.so + n;
+	}
+	m.bol = (const unsigned char *) string;
+	m.icase = (prog->cflags & REG_ICASE) != 0;
+	m.nl = (prog->cflags & REG_NEWLINE) != 0;
+	m.notbol = (eflags & REG_NOTBOL) != 0;
+	m.noteol = (eflags & REG_NOTEOL) != 0;
+	for (s = m.bol;; s++) {
+		for (i = 0; i < n; i++)
+			m.so[i] = m.eo[i] = NULL;
+		if ((r = m_seq(&m, prog->root, s, NULL)) != NULL) {
+			ret = 0;
+			break;
+		}
+		if (!*s || prog->bol_only)
+			break;
+	}
+	if (ret == 0) {
+		for (i = 0; i < nmatch; i++) {
+			if (i < n && m.so[i] && m.eo[i]) {
+				pmatch[i].rm_so = m.so[i] - m.bol;
+				pmatch[i].rm_eo = m.eo[i] - m.bol;
+			} else
+				pmatch[i].rm_so = pmatch[i].rm_eo = -1;
+		}
+	}
+	if (m.so != sobuf)
+		free(m.so);
+	return ret;
+}
+
+static const char *const reg_msgs[] = {
+	"Success",
+	"No match",
+	"Invalid regular expression",
+	"Invalid collation character",
+	"Invalid character class name",
+	"Trailing backslash",
+	"Invalid back reference",
+	"Unmatched [ or [^",
+	"Unmatched ( or \\(",
+	"Unmatched \\{",
+	"Invalid content of \\{\\}",
+	"Invalid range end",
+	"Memory exhausted",
+	"Invalid preceding regular expression",
+};
+
+size_t regerror(int errcode, const regex_t *preg, char *errbuf, size_t errbuf_size)
+{
+	const char *msg;
+	size_t len;
+
+	if (errcode < 0 || errcode >= (int) (sizeof(reg_msgs) / sizeof(reg_msgs[0])))
+		msg = "Unknown error";
+	else
+		msg = reg_msgs[errcode];
+	len = strlen(msg) + 1;
+	if (errbuf && errbuf_size) {
+		if (len > errbuf_size) {
+			memcpy(errbuf, msg, errbuf_size - 1);
+			errbuf[errbuf_size - 1] = '\0';
+		} else
+			memcpy(errbuf, msg, len);
+	}
+	return len;
+}
