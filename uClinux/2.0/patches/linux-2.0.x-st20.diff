diff --git a/linux-2.0.x/arch/st20/mm/cache.c b/linux-2.0.x/arch/st20/mm/cache.c
new file mode 100644
index 000000000..b485ed886
--- /dev/null
+++ b/linux-2.0.x/arch/st20/mm/cache.c
@@ -0,0 +1,35 @@
+/*
+ * arch/st20/mm/cache.c - STi5512 instruction cache
+ *
+ * Cache controller at 0x4000 (OS20 cache/sti5512a.c): EnableICache +0x700,
+ * InvalidateICache +0x800, CacheStatus +0x900; byte registers, as STBOOT writes them
+ * (Decompilation/DSR9500 src/a_7feb1948.c).  The data cache caches only the regions set in
+ * its region registers; those stay clear, so device registers, the OSD frame store and
+ * DMA buffers need no flushing.  The STi5512 wants invalidate, wait >= 128 cycles, enable.
+ */
+#include <linux/kernel.h>
+
+#define CACHE(o)		(*(volatile unsigned char *) (0x4000UL + (o)))
+#define CAC_ENABLE_ICACHE	0x700
+#define CAC_INVALIDATE_ICACHE	0x800
+
+static void cache_wait(void)
+{
+	volatile int i;
+
+	for (i = 0; i < 64; i++)	/* > 128 cycles */
+		;
+}
+
+void st20_icache_invalidate(void)
+{
+	CACHE(CAC_INVALIDATE_ICACHE) = 1;
+	cache_wait();
+}
+
+void st20_icache_enable(void)
+{
+	st20_icache_invalidate();
+	CACHE(CAC_ENABLE_ICACHE) = 1;
+	printk("ST20 instruction cache enabled\n");
+}
diff --git a/linux-2.0.x/arch/st20/mm/init.c b/linux-2.0.x/arch/st20/mm/init.c
new file mode 100644
index 000000000..5b3fd99ad
--- /dev/null
+++ b/linux-2.0.x/arch/st20/mm/init.c
@@ -0,0 +1,98 @@
+/*
+ * arch/st20/mm/init.c - memory initialisation for uClinux/ST20
+ */
+#include <linux/config.h>
+#include <linux/signal.h>
+#include <linux/sched.h>
+#include <linux/mm.h>
+#include <linux/swap.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/types.h>
+#include <asm/segment.h>
+#include <asm/page.h>
+#include <asm/pgtable.h>
+#include <asm/system.h>
+
+extern unsigned long free_area_init(unsigned long, unsigned long);
+extern char _stext, _etext, _edata, _end;
+
+unsigned long empty_zero_page;
+
+void show_mem(void)
+{
+	unsigned long i;
+	int free = 0, total = 0, reserved = 0, shared = 0;
+
+	printk("\nMem-info:\n");
+	show_free_areas();
+	i = MAP_NR(high_memory);
+	while (i-- > 0) {
+		total++;
+		if (PageReserved(mem_map + i))
+			reserved++;
+		else if (!mem_map[i].count)
+			free++;
+		else
+			shared += mem_map[i].count - 1;
+	}
+	printk("%d pages of RAM\n%d free pages\n%d reserved pages\n%d pages shared\n",
+	       total, free, reserved, shared);
+	show_buffers();
+}
+
+unsigned long paging_init(unsigned long start_mem, unsigned long end_mem)
+{
+	empty_zero_page = start_mem;
+	start_mem += PAGE_SIZE;
+	memset((void *) empty_zero_page, 0, PAGE_SIZE);
+	set_fs(USER_DS);
+	return PAGE_ALIGN(free_area_init(start_mem, end_mem));
+}
+
+void mem_init(unsigned long start_mem, unsigned long end_mem)
+{
+	unsigned long tmp;
+	int datapages = 0;
+
+	end_mem &= PAGE_MASK;
+	high_memory = end_mem;
+	start_mem = PAGE_ALIGN(start_mem);
+	while (start_mem < high_memory) {
+		clear_bit(PG_reserved, &mem_map[MAP_NR(start_mem)].flags);
+		start_mem += PAGE_SIZE;
+	}
+	for (tmp = PAGE_OFFSET; tmp < end_mem; tmp += PAGE_SIZE) {
+		if (PageReserved(mem_map + MAP_NR(tmp))) {
+			datapages++;
+			continue;
+		}
+		mem_map[MAP_NR(tmp)].count = 1;
+		free_page(tmp);
+	}
+	tmp = nr_free_pages << PAGE_SHIFT;
+	printk("Memory available: %luk/%luk RAM (%dk kernel code, %dk reserved)\n",
+	       tmp >> 10, (end_mem - PAGE_OFFSET) >> 10,
+	       (int) ((&_etext - &_stext) >> 10), datapages << (PAGE_SHIFT - 10));
+}
+
+void si_meminfo(struct sysinfo *val)
+{
+	unsigned long i;
+
+	i = MAP_NR(high_memory);
+	val->totalram = 0;
+	val->sharedram = 0;
+	val->freeram = nr_free_pages << PAGE_SHIFT;
+	val->bufferram = buffermem;
+	while (i-- > 0) {
+		if (PageReserved(mem_map + i))
+			continue;
+		val->totalram++;
+		if (!mem_map[i].count)
+			continue;
+		val->sharedram += mem_map[i].count - 1;
+	}
+	val->totalram <<= PAGE_SHIFT;
+	val->sharedram <<= PAGE_SHIFT;
+}
