+#ifndef _ST20_JMP_BUF_H
+#define _ST20_JMP_BUF_H
+/* ST20 (st20/setjmp.ast): [0] = Wptr of the setjmp caller, [1] = return Iptr.  Nothing
+   else is live across a call: there are no callee-saved registers. */
+typedef struct {
+	unsigned long __wptr;
+	unsigned long __iptr;
+	unsigned long __mask_was_saved;
+	unsigned long __saved_mask;
+} __jmp_buf[1];
+#endif
