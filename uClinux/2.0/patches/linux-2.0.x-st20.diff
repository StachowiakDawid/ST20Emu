diff --git a/linux-2.0.x/include/asm-st20/ptrace.h b/linux-2.0.x/include/asm-st20/ptrace.h
new file mode 100644
index 000000000..6e0884d7d
--- /dev/null
+++ b/linux-2.0.x/include/asm-st20/ptrace.h
@@ -0,0 +1,43 @@
+#ifndef _ST20_PTRACE_H
+#define _ST20_PTRACE_H
+
+/*
+ * ST20 register state saved on kernel entry (system call or timeslice trap).  ST20 has no
+ * general registers: a process is its Wptr (workspace = stack) and Iptr; Areg-Creg are
+ * empty at calls and at timeslice points.
+ */
+#ifndef __ASSEMBLY__
+struct pt_regs {
+	long		orig_nr;	/* syscall number, -1 for a trap */
+	long		arg[5];		/* syscall arguments */
+	long		result;		/* syscall result */
+	unsigned long	wptr;		/* Wptr of the interrupted/calling code */
+	unsigned long	iptr;		/* Iptr to resume at */
+	unsigned long	status;		/* 1 = entered from user mode */
+};
+
+/* word offsets for entry.s */
+#endif
+#define PT_ORIG_NR	0
+#define PT_ARG0		1
+#define PT_RESULT	6
+#define PT_WPTR		7
+#define PT_IPTR		8
+#define PT_STATUS	9
+#define PT_WORDS	10
+
+#define PS_USER		1
+
+/* ptrace requests */
+#define PTRACE_GETREGS		12
+#define PTRACE_SETREGS		13
+
+#ifdef __KERNEL__
+#ifndef __ASSEMBLY__
+#define user_mode(regs)		(((regs)->status & PS_USER) != 0)
+#define instruction_pointer(regs) ((regs)->iptr)
+extern void show_regs(struct pt_regs *);
+#endif
+#endif
+
+#endif /* _ST20_PTRACE_H */
