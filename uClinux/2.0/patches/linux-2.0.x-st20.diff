diff --git a/linux-2.0.x/include/asm-st20/types.h b/linux-2.0.x/include/asm-st20/types.h
new file mode 100644
index 000000000..202b00262
--- /dev/null
+++ b/linux-2.0.x/include/asm-st20/types.h
@@ -0,0 +1,52 @@
+#ifndef _ST20_TYPES_H
+#define _ST20_TYPES_H
+
+/*
+ * This file is never included by application software unless
+ * explicitly requested (e.g., via linux/types.h) in which case the
+ * application is Linux specific so (user-) name space pollution is
+ * not a major issue.  However, for interoperability, libraries still
+ * need to be careful to avoid a name clashes.
+ */
+
+typedef unsigned short umode_t;
+
+/*
+ * __xx is ok: it doesn't pollute the POSIX namespace. Use these in the
+ * header files exported to user space
+ */
+
+typedef __signed__ char __s8;
+typedef unsigned char __u8;
+
+typedef __signed__ short __s16;
+typedef unsigned short __u16;
+
+typedef __signed__ int __s32;
+typedef unsigned int __u32;
+
+#if defined(__GNUC__) && !defined(__STRICT_ANSI__)
+typedef __signed__ long long __s64;
+typedef unsigned long long __u64;
+#endif
+
+/*
+ * These aren't exported outside the kernel to avoid name space clashes
+ */
+#ifdef __KERNEL__
+
+typedef signed char s8;
+typedef unsigned char u8;
+
+typedef signed short s16;
+typedef unsigned short u16;
+
+typedef signed int s32;
+typedef unsigned int u32;
+
+typedef signed long long s64;
+typedef unsigned long long u64;
+
+#endif /* __KERNEL__ */
+
+#endif /* _ST20_TYPES_H */
diff --git a/linux-2.0.x/include/asm-st20/unaligned.h b/linux-2.0.x/include/asm-st20/unaligned.h
new file mode 100644
index 000000000..e6e024c1e
--- /dev/null
+++ b/linux-2.0.x/include/asm-st20/unaligned.h
@@ -0,0 +1,42 @@
+#ifndef __ST20_UNALIGNED_H
+#define __ST20_UNALIGNED_H
+
+/*
+ * ST20 word accesses must be aligned.  Little-endian byte-wise accessors; inline functions
+ * rather than statement expressions, which gcc-t800 does not compile reliably inside
+ * conditions (cc1 aborted on genhd.c's NR_SECTS).  Sizes 1, 2 and 4.
+ */
+extern __inline__ unsigned long __st20_get_unaligned(const void *ptr, int size)
+{
+	const unsigned char *b = (const unsigned char *) ptr;
+
+	switch (size) {
+	case 1:
+		return b[0];
+	case 2:
+		return b[0] | (b[1] << 8);
+	default:
+		return b[0] | (b[1] << 8) | ((unsigned long) b[2] << 16) |
+		       ((unsigned long) b[3] << 24);
+	}
+}
+
+extern __inline__ void __st20_put_unaligned(unsigned long val, void *ptr, int size)
+{
+	unsigned char *b = (unsigned char *) ptr;
+
+	b[0] = val;
+	if (size > 1)
+		b[1] = val >> 8;
+	if (size > 2) {
+		b[2] = val >> 16;
+		b[3] = val >> 24;
+	}
+}
+
+#define get_unaligned(ptr) \
+	((__typeof__(*(ptr))) __st20_get_unaligned((ptr), sizeof(*(ptr))))
+#define put_unaligned(val, ptr) \
+	__st20_put_unaligned((unsigned long) (val), (ptr), sizeof(*(ptr)))
+
+#endif /* __ST20_UNALIGNED_H */
