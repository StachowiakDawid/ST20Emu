diff --git a/lib/libc/st20/crt0.ast b/lib/libc/st20/crt0.ast
new file mode 100644
index 000000000..7348f7b1e
--- /dev/null
+++ b/lib/libc/st20/crt0.ast
@@ -0,0 +1,58 @@
+// lib/libc/st20/crt0.ast - start of a uClinux/ST20 flat (bFLT) program with uC-libc
+//
+// Linked at 0 = the first byte after the 64-byte bFLT header; text, data, bss back to back
+// (created in that order).  The kernel enters @@hook with Wptr = sp:
+// sp[0] = argc, sp[1..argc] = argv[], 0, envp[], 0 (fs/binfmt_flat.c).
+.text
+.data
+.bss
+.text
+.globl text@@start;
+.globl text@@size;
+.globl data@@start;
+.globl data@@size;
+.globl bss@@start;
+.globl bss@@size;
+data@@start = text@@start + text@@size
+bss@@start = data@@start + data@@size
+
+// segment ends, read from the link map by tools/mkflat.py
+.globl __etext;
+__etext = text@@start + text@@size
+.globl __edata;
+__edata = data@@start + data@@size
+.globl __end;
+__end = bss@@start + bss@@size
+
+.globl _main;
+.globl _exit;
+.globl _environ;
+.globl @@hook;
+@@hook:
+	.need __etext
+	.need __edata
+	.need __end
+	// envp = &argv[argc + 1] -> environ
+	ldl 0
+	adc 2
+	ldlp 0
+	wsub
+	ldc _environ-LC1
+	ldpi
+LC1:
+	stnl 0
+	ldc _environ-LC2
+	ldpi
+LC2:
+	ldnl 0		// envp
+	ldlp 1		// argv
+	ldl 0		// argc
+	call _main
+	call _exit	// exit(main(argc, argv, envp))
+LC3:
+	j LC3
+
+.data
+	.align 4
+_environ:
+	.word 0
diff --git a/lib/libc/st20/setjmp.ast b/lib/libc/st20/setjmp.ast
new file mode 100644
index 000000000..7791c08e9
--- /dev/null
+++ b/lib/libc/st20/setjmp.ast
@@ -0,0 +1,42 @@
+// lib/libc/st20/setjmp.ast - setjmp/longjmp for uClinux/ST20 (gcc-t800 generic model)
+// After `call`: W[0] = return Iptr, W[1..2] = arguments.  env[0] = the caller's Wptr after
+// the return (W + 4 words), env[1] = the return Iptr.  No registers survive a call, so
+// that is the whole context.
+.text
+// aliases are assignments (an alias label would start an empty fragment, see vfork.ast)
+.globl _setjmp;
+_setjmp:
+	ldl 0
+	ldl 1
+	stnl 1
+	ldlp 4
+	ldl 1
+	stnl 0
+	ldc 0
+	ret
+
+// longjmp(env, val): continue at env[1] with Wptr = env[0] and Areg = val ? val : 1, by
+// building a call frame below env[0] whose word 0 is the Iptr and returning through it.
+.globl _longjmp;
+_longjmp:
+	ldl 1
+	ldnl 1
+	ldl 1
+	ldnl 0
+	adc -16
+	stnl 0
+	ldl 2
+	eqc 0
+	ldl 2
+	or
+	ldl 1
+	ldnl 0
+	adc -16
+	gajw
+	rev
+	ret
+
+.globl __setjmp;
+__setjmp = _setjmp
+.globl __longjmp;
+__longjmp = _longjmp
